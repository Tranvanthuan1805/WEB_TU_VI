@implements IDisposable
@inject NavigationManager NavigationManager
@rendermode InteractiveAuto

<footer class="w-full mt-20 bg-surface-container-lowest border-t border-yellow-900/20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 px-12 py-16 max-w-7xl mx-auto">
        <div class="space-y-6">
            <div class="font-headline text-xl text-yellow-500">Lá Số Tử Vi</div>
            <p class="font-sans text-sm tracking-wide text-gray-500">© 2026 Lá Số Tử Vi. Khám phá vận mệnh – Thấu hiểu chính mình.</p>
        </div>
        <div class="grid grid-cols-2 gap-8">
            <div class="flex flex-col gap-4">
                <NavLink class="text-gray-600 hover:text-yellow-600 font-sans text-sm tracking-wide" href="#">Contact Us</NavLink>
                <NavLink class="text-gray-600 hover:text-yellow-600 font-sans text-sm tracking-wide" href="#">Privacy Policy</NavLink>
            </div>
            <div class="flex flex-col gap-4">
                <NavLink class="text-gray-600 hover:text-yellow-600 font-sans text-sm tracking-wide" href="#">Terms of Service</NavLink>
                <NavLink class="text-gray-600 hover:text-yellow-600 font-sans text-sm tracking-wide" href="#">Disclaimer</NavLink>
            </div>
        </div>
    </div>
</footer>

@code {


    private string? currentUrl;
    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
