@inherits LayoutComponentBase

<div class="min-h-screen bg-background flex flex-col items-center justify-center p-4 md:p-8 relative overflow-hidden font-[Manrope] text-on-background">
    <!-- Decorative background elements -->
    <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full bg-primary-container/10 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 rounded-full bg-primary-container/10 blur-3xl pointer-events-none"></div>
    
    <!-- Subtle astrology pattern or circle graphic overlay -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-outline-variant/10 pointer-events-none hidden md:flex items-center justify-center z-0" style="border-radius: 50%;">
        <div class="w-[450px] h-[450px] border border-outline-variant/15 pointer-events-none flex items-center justify-center" style="border-radius: 50%;">
            <div class="w-[300px] h-[300px] border border-outline-variant/20 pointer-events-none" style="border-radius: 50%;"></div>
        </div>
    </div>
    
    <!-- Content container -->
    <div class="w-full max-w-md relative z-10">
        <!-- Site Logo / Name at the top of form card -->
        <div class="flex flex-col items-center mb-6">
            <a href="/" class="flex flex-col items-center gap-1 group no-underline text-inherit">
                <span class="material-symbols-outlined text-4xl text-primary group-hover:scale-110 transition-transform">flare</span>
                <span class="font-[Noto_Serif] text-2xl font-bold tracking-wider text-primary italic">Lá Số Tử Vi</span>
            </a>
        </div>
        
        <main class="w-full bg-surface border border-outline-variant/30 shadow-md rounded-2xl p-6 md:p-8">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet class="hidden">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
</style>

