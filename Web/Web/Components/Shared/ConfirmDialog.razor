@using Web.Services
@implements IDisposable
@inject ConfirmDialogService ConfirmDialogService

@if (_isVisible)
{
    <div class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/50" @onclick="OnOverlayClick">
        <div class="bg-surface-container-low rounded-lg shadow-xl max-w-md w-full mx-4 p-6" @onclick:stopPropagation="true">
            <h3 class="text-lg font-headline text-on-surface mb-2">@_currentRequest?.Title</h3>
            <p class="text-sm text-on-surface-variant mb-6">@_currentRequest?.Message</p>
            <div class="flex justify-end gap-3">
                <button class="px-4 py-2 text-sm rounded border border-outline text-on-surface-variant hover:bg-surface-container-high" @onclick="OnCancel">Hủy</button>
                <button class="px-4 py-2 text-sm rounded @(_currentRequest?.IsDanger == true ? "bg-error text-on-primary hover:opacity-90" : "bg-primary text-on-primary hover:opacity-90")" @onclick="OnConfirm">@_currentRequest?.ConfirmText</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private ConfirmRequest? _currentRequest;

    protected override void OnInitialized()
    {
        ConfirmDialogService.OnShow += OnDialogShow;
    }

    private void OnDialogShow(ConfirmRequest request)
    {
        _currentRequest = request;
        _isVisible = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnOverlayClick() => OnCancel();

    private void OnConfirm()
    {
        _isVisible = false;
        ConfirmDialogService.Confirm(true);
        InvokeAsync(StateHasChanged);
    }

    private void OnCancel()
    {
        _isVisible = false;
        ConfirmDialogService.Confirm(false);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConfirmDialogService.OnShow -= OnDialogShow;
    }
}
