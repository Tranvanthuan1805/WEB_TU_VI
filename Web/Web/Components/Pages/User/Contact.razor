@page "/lien-he"
@attribute [StreamRendering]

@inject ToastService ToastService
@inject NavigationManager NavigationManager
@using System.ComponentModel.DataAnnotations

<PageTitle>Liên hệ | Lá Số Tử Vi</PageTitle>

<head>
    <meta name="description" content="Liên hệ với Lá Số Tử Vi - Góp ý hoặc báo lỗi để chúng tôi cải thiện dịch vụ." />
</head>

<div class="max-w-6xl mx-auto w-full px-4 py-8">
    <div class="mb-8 text-center md:text-left">
        <p class="text-[10px] font-bold text-amber-600 uppercase tracking-widest mb-1">kết nối với chúng tôi</p>
        <h1 class="text-3xl md:text-4xl font-bold font-serif text-stone-850">Liên Hệ</h1>
        <p class="text-slate-450 text-sm mt-1">Gửi phản hồi hoặc đóng góp ý kiến để chúng tôi hoàn thiện dịch vụ tốt hơn.</p>
    </div>

    <!-- Grid layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Contact info cards (5 cols) -->
        <div class="lg:col-span-5 space-y-6 text-left">
            <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.02)] space-y-4">
                <h3 class="font-serif text-lg font-bold text-stone-855">Thông tin liên hệ</h3>
                <div class="space-y-4 text-xs">
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Đại diện</p>
                        <p class="text-stone-750 font-bold mt-1 text-sm">Trần Đình Mãn</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Điện thoại</p>
                        <p class="text-stone-750 font-bold mt-1 text-sm">0905 123 456</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Email</p>
                        <p class="text-stone-750 font-bold mt-1 text-sm">contact@tuvithantoan.com</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Địa chỉ</p>
                        <p class="text-stone-750 font-bold mt-1 text-sm">Hải Châu, TP. Đà Nẵng, Việt Nam</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Form card (7 cols) -->
        <div class="lg:col-span-7 w-full">
            <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.03)] p-6 md:p-8 space-y-6">
                <EditForm Model="_contactModel" OnValidSubmit="HandleSubmit" FormName="contact" method="post">
                    <DataAnnotationsValidator />
                    <div class="space-y-5">
                        <div class="space-y-2 text-left">
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Loại liên hệ</label>
                            <InputSelect class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 outline-none text-slate-700 font-semibold text-sm bg-slate-50/50 cursor-pointer transition-all"
                                         @bind-Value="_contactModel.ContactType">
                                <option value="GopY">Góp ý</option>
                                <option value="BaoLoi">Báo lỗi</option>
                            </InputSelect>
                        </div>

                        <div class="space-y-2 text-left">
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Nội dung <span class="text-red-500">*</span></label>
                            <InputTextArea class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white min-h-[150px] resize-none"
                                           @bind-Value="_contactModel.Content" placeholder="Nhập nội dung liên hệ..." />
                            <ValidationMessage For="() => _contactModel.Content" />
                        </div>

                        <div class="space-y-2 text-left">
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Email của bạn</label>
                            <InputText class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white"
                                       type="email" @bind-Value="_contactModel.Email" placeholder="Nhập email của bạn" />
                            <ValidationMessage For="() => _contactModel.Email" />
                            <p class="text-slate-400 text-[11px] font-medium mt-1">Nếu bạn muốn nhận phản hồi, vui lòng để lại email chính xác.</p>
                        </div>

                        <div class="pt-2">
                            <button class="px-8 py-3.5 text-white disabled:text-slate-400 font-bold text-xs uppercase tracking-widest rounded-xl transition-all cursor-pointer shadow-md hover:scale-[1.02] active:scale-95 shrink-0 w-full flex items-center justify-center gap-2" style="background:linear-gradient(135deg, #a68249, #8f6d39)"
                                    type="submit" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span>ĐANG GỬI LIÊN HỆ...</span>
                                }
                                else
                                {
                                    <span>GỬI LIÊN HỆ NGAY</span>
                                    <span class="material-symbols-outlined text-sm">send</span>
                                }
                            </button>
                        </div>
                    </div>
                </EditForm>

                @if (showSuccess)
                {
                    <div class="mt-6 p-4 bg-emerald-50 border border-emerald-100 rounded-xl text-center shadow-sm">
                        <p class="text-emerald-700 font-bold text-sm">Đã gửi liên hệ thành công! Cảm ơn ý kiến đóng góp của bạn.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
</style>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactFormModel _contactModel { get; set; } = new();
    private bool isSubmitting = false;
    private bool showSuccess = false;

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Loại liên hệ là bắt buộc")]
        public string ContactType { get; set; } = "GopY";

        [Required(ErrorMessage = "Nội dung là bắt buộc")]
        [MinLength(10, ErrorMessage = "Nội dung quá ngắn")]
        public string Content { get; set; } = "";

        private string? _email;

        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string? Email 
        {
            get => _email;
            set => _email = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        }

    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        try
        {
            var contact = new Web.Models.Contact
            {
                Type = _contactModel.ContactType == "GopY" ? Web.Models.ContactType.GopY : Web.Models.ContactType.BaoLoi,
                Content = _contactModel.Content,
                Email = _contactModel.Email ?? "",
                Status = Web.Models.ContactStatus.Moi,
                DateCreated = DateTime.UtcNow,
                DateUpdated = DateTime.UtcNow
            };

            using var context = DbFactory.CreateDbContext();
            context.Contacts.Add(contact);
            await context.SaveChangesAsync();

            showSuccess = true;
            ToastService.ShowSuccess("Đã gửi liên hệ thành công! Chuyển trang sau giây lát...");
            await Task.Delay(1500);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception)
        {
            ToastService.ShowError("Có lỗi xảy ra. Vui lòng thử lại.");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}