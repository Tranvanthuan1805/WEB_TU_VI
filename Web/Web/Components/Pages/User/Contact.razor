@page "/lien-he"
@attribute [StreamRendering]

@inject ToastService ToastService
@inject NavigationManager NavigationManager
@using System.ComponentModel.DataAnnotations

<PageTitle>Liên hệ | Lá Số Tử Vi</PageTitle>

<head>
    <meta name="description" content="Liên hệ với Lá Số Tử Vi - Góp ý hoặc báo lỗi để chúng tôi cải thiện dịch vụ." />
</head>

<div class="max-w-xl mx-auto py-8">
    <div class="bg-white border border-outline-variant/40 shadow-md rounded-3xl p-8 md:p-10 space-y-8">
        <header class="text-center space-y-3 mb-6">
            <h1 class="font-headline text-4xl text-primary font-bold italic leading-tight">Liên hệ</h1>
            <p class="text-on-surface-variant font-medium text-sm">Góp ý hoặc báo lỗi để chúng tôi cải thiện dịch vụ tốt hơn.</p>
        </header>

        <EditForm Model="_contactModel" OnValidSubmit="HandleSubmit" FormName="contact" method="post">
            <DataAnnotationsValidator />
            <div class="space-y-5">
                <div class="relative">
                    <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Loại liên hệ</label>
                    <InputSelect class="ivory-input mt-1 cursor-pointer bg-white"
                                @bind-Value="_contactModel.ContactType">
                        <option value="GopY">Góp ý</option>
                        <option value="BaoLoi">Báo lỗi</option>
                    </InputSelect>
                </div>

                <div class="relative">
                    <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Nội dung <span class="text-red-500">*</span></label>
                    <InputTextArea class="ivory-input mt-1 min-h-[150px] resize-none"
                                  @bind-Value="_contactModel.Content" placeholder="Nhập nội dung liên hệ..." />
                    <ValidationMessage For="() => _contactModel.Content" />
                </div>

                <div class="relative">
                    <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Email của bạn</label>
                    <InputText class="ivory-input mt-1"
                               type="email" @bind-Value="_contactModel.Email" placeholder="Nhập email của bạn" />
                    <ValidationMessage For="() => _contactModel.Email" />
                    <p class="text-on-surface-variant/80 text-[11px] font-medium mt-1">Nếu bạn muốn nhận phản hồi, vui lòng để lại email chính xác.</p>
                </div>

                <div class="pt-4">
                    <button class="btn-gold py-4 w-full flex items-center justify-center gap-2 cursor-pointer shadow-md text-xs"
                            type="submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="font-bold">Đang gửi liên hệ...</span>
                        }
                        else
                        {
                            <span class="font-bold tracking-widest">Gửi liên hệ</span>
                            <span class="material-symbols-outlined text-sm">send</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>

        @if (showSuccess)
        {
            <div class="mt-6 p-4 bg-green-50 border border-green-200 rounded-xl text-center shadow-sm">
                <p class="text-green-700 font-bold text-sm">Đã gửi liên hệ thành công! Cảm ơn ý kiến đóng góp của bạn.</p>
            </div>
        }
    </div>
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
</style>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactFormModel _contactModel { get; set; } = new();
    private bool isSubmitting = false;
    private bool showSuccess = false;

    public class ContactFormModel
    {
        [Required(ErrorMessage = "Loại liên hệ là bắt buộc")]
        public string ContactType { get; set; } = "GopY";

        [Required(ErrorMessage = "Nội dung là bắt buộc")]
        [MinLength(10, ErrorMessage = "Nội dung quá ngắn")]
        public string Content { get; set; } = "";

        private string? _email;

        [EmailAddress(ErrorMessage = "Email không hợp lệ")]
        public string? Email 
        {
            get => _email;
            set => _email = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
        }

    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        try
        {
            var contact = new Web.Models.Contact
            {
                Type = _contactModel.ContactType == "GopY" ? Web.Models.ContactType.GopY : Web.Models.ContactType.BaoLoi,
                Content = _contactModel.Content,
                Email = _contactModel.Email ?? "",
                Status = Web.Models.ContactStatus.Moi,
                DateCreated = DateTime.UtcNow,
                DateUpdated = DateTime.UtcNow
            };

            using var context = DbFactory.CreateDbContext();
            context.Contacts.Add(contact);
            await context.SaveChangesAsync();

            showSuccess = true;
            ToastService.ShowSuccess("Đã gửi liên hệ thành công! Chuyển trang sau giây lát...");
            await Task.Delay(1500);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception)
        {
            ToastService.ShowError("Có lỗi xảy ra. Vui lòng thử lại.");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}