@code {
    private HomeFormModel formModel = new();
    private bool isLoading = false;
    private bool hasResult = false;
    private bool usedTicket = false;
    private bool showTheCach = true;
    private bool showTuVi = false;
    private TuViResult? tuViResult;
    
    // Free usage tracking
    private bool freeUsageHintVisible = true;
    private string freeUsageHint = "";
    private int currentFreeUsage = 0;
    private int dailyFreeLimit = 5;

    // Redesign properties
    private List<Post> _recentPosts = new();
    private bool _facebookEnabled;
    private string _facebookUrl = "";
    private bool _zaloEnabled;
    private string _zaloUrl = "";

    // Excel profiles properties
    private List<ExcelProfile> _profiles = new();
    private List<ExcelProfile> _filteredProfilesForSearch = new();
    private string _searchProfileQuery = "";
    private ExcelProfile? _selectedProfile;
    private bool _useProfileSelect = false;

    private static readonly Dictionary<int, string> Hour24ToCanh = new()
    {
        [0] = "Ty", [1] = "Suu", [2] = "Suu", [3] = "Dan", [4] = "Dan", [5] = "Mao",
        [6] = "Mao", [7] = "Thin", [8] = "Thin", [9] = "Ty2", [10] = "Ty2", [11] = "Ngo",
        [12] = "Ngo", [13] = "Mui", [14] = "Mui", [15] = "Than", [16] = "Than", [17] = "Dau",
        [18] = "Dau", [19] = "Tuat", [20] = "Tuat", [21] = "Hoi", [22] = "Hoi", [23] = "Ty"
    };

    private static readonly Dictionary<string, int> CanhToHour24 = new()
    {
        ["Ty"] = 23, ["Suu"] = 1, ["Dan"] = 3, ["Mao"] = 5, ["Thin"] = 7, ["Ty2"] = 9,
        ["Ngo"] = 11, ["Mui"] = 13, ["Than"] = 15, ["Dau"] = 17, ["Tuat"] = 19, ["Hoi"] = 21
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadFreeUsageHint();
        LoadConsultationConfig();

        try
        {
            using var context = DbFactory.CreateDbContext();
            _recentPosts = await context.Posts
                .Where(p => p.Published)
                .OrderByDescending(p => p.DateUpdated)
                .Take(5)
                .ToListAsync();
        }
        catch
        {
            // Fail silent
        }

        try
        {
            _profiles = await TuViExcelService.GetProfilesFromExcelAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profiles from Excel: {ex.Message}");
        }
    }

    private void LoadConsultationConfig()
    {
        var section = Configuration.GetSection("Consultation");
        _facebookEnabled = bool.TryParse(section["FacebookEnabled"], out var fb) && fb;
        _facebookUrl = section["FacebookUrl"] ?? "";
        _zaloEnabled = bool.TryParse(section["ZaloEnabled"], out var zl) && zl;
        _zaloUrl = section["ZaloUrl"] ?? "";
    }

    private async Task LoadFreeUsageHint()
    {
        try
        {
            var anonId = await JS.InvokeAsync<string>("getOrCreateAnonId");
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            
            using var context = DbFactory.CreateDbContext();
            
            var dailyLimitSection = Configuration.GetSection("FreeUsageLimit");
            dailyFreeLimit = int.TryParse(dailyLimitSection["DailyLimit"], out var limit) ? limit : 5;
            
            var usageStats = await context.DailyUsageStats
                .FirstOrDefaultAsync(s => s.Date == today && s.AnonymousId == anonId);
            
            currentFreeUsage = usageStats?.FreeUsageCount ?? 0;
            
            if (dailyFreeLimit == -1)
            {
                freeUsageHint = $"Xem miễn phí: {currentFreeUsage}/∞ lượt/ngày";
            }
            else
            {
                freeUsageHint = $"Xem miễn phí: {currentFreeUsage}/{dailyFreeLimit} lượt/ngày";
            }
        }
        catch
        {
            freeUsageHint = "Xem miễn phí";
        }
    }

    private void OnSliderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var hour24))
        {
            formModel.BirthHour24 = hour24;
            formModel.BirthHour = Hour24ToCanh.TryGetValue(hour24, out var canh) ? canh : "Ty";
        }
    }

    private void OnSelectChanged(ChangeEventArgs e)
    {
        var canh = e.Value?.ToString() ?? "Ty";
        formModel.BirthHour = canh;
        
        if (CanhToHour24.TryGetValue(canh, out var hour24))
        {
            formModel.BirthHour24 = hour24;
        }
    }

    private class HomeFormModel
    {
        [Required(ErrorMessage = "Vui lòng chọn loại lá số")]
        public string SelectedOption { get; set; } = "1";
        
        public string TicketCode { get; set; } = "";

        private int _birthDay = DateTime.Now.Day;
        private int _birthMonth = DateTime.Now.Month;
        private int _birthYear = DateTime.Now.Year;

        [Required(ErrorMessage = "Ngày sinh không được để trống")]
        public int BirthDay
        {
            get => _birthDay;
            set => _birthDay = value;
        }

        [Required(ErrorMessage = "Tháng sinh không được để trống")]
        public int BirthMonth
        {
            get => _birthMonth;
            set => _birthMonth = value;
        }

        [Required(ErrorMessage = "Năm sinh không được để trống")]
        public int BirthYear
        {
            get => _birthYear;
            set => _birthYear = value;
        }

        private bool IsLeapYear(int year) => (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);

        public int MaxDayInMonth => BirthMonth switch
        {
            1 or 3 or 5 or 7 or 8 or 10 or 12 => 31,
            4 or 6 or 9 or 11 => 30,
            2 => IsLeapYear(BirthYear) ? 29 : 28,
            _ => 30
        };

        [Required(ErrorMessage = "Năm xem không được để trống")]
        public int ViewYear { get; set; } = DateTime.Now.Year;
        
        public int BirthHour24 { get; set; } = 0;
        public string BirthHour { get; set; } = "Ty";
        public string BirthHour24h => $"{BirthHour24}h";
        
        [Required(ErrorMessage = "Vui lòng chọn giới tính")]
        public string Gender { get; set; } = "Nam";
    }

    private void OnBirthDayChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var day) && day > 0 && day <= 31)
        {
            formModel.BirthDay = day;
        }
    }

    private void OnBirthMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month) && month > 0 && month <= 12)
        {
            formModel.BirthMonth = month;
            if (formModel.BirthDay > formModel.MaxDayInMonth)
            {
                formModel.BirthDay = formModel.MaxDayInMonth;
            }
        }
    }

    private void OnBirthYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year) && year >= 1900 && year <= 2099)
        {
            formModel.BirthYear = year;
            if (formModel.BirthDay > formModel.MaxDayInMonth)
            {
                formModel.BirthDay = formModel.MaxDayInMonth;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (isLoading) return;

        isLoading = true;
        hasResult = false;

        try
        {
            bool ticketValid = false;

            // Check ticket first
            if (!string.IsNullOrWhiteSpace(formModel.TicketCode))
            {
                using var context = DbFactory.CreateDbContext();
                var ticket = await Task.Run(() => context.Tickets.FirstOrDefault(t => t.Code == formModel.TicketCode));

                if (ticket != null && ticket.IsAvailable)
                {
                    ticket.QuantityUsed += 1;
                    await context.SaveChangesAsync();
                    ticketValid = true;
                    
                    // Track premium usage
                    var anonId = await JS.InvokeAsync<string>("getOrCreateAnonId");
                    var today = DateOnly.FromDateTime(DateTime.UtcNow);
                    
                    var usageStats = await context.DailyUsageStats
                        .FirstOrDefaultAsync(s => s.Date == today && s.AnonymousId == anonId);
                    
                    if (usageStats != null)
                    {
                        usageStats.PremiumUsageCount += 1;
                        usageStats.LastUsedAt = DateTime.UtcNow;
                    }
                    else
                    {
                        context.DailyUsageStats.Add(new DailyUsageStats
                        {
                            Date = today,
                            AnonymousId = anonId,
                            PremiumUsageCount = 1,
                            LastUsedAt = DateTime.UtcNow
                        });
                    }
                    
                    await context.SaveChangesAsync();
                }
            }

            if (!ticketValid)
            {
                var anonId = await JS.InvokeAsync<string>("getOrCreateAnonId");
                var today = DateOnly.FromDateTime(DateTime.UtcNow);
                
                using var context = DbFactory.CreateDbContext();
                
                var dailyLimitSection = Configuration.GetSection("FreeUsageLimit");
                dailyFreeLimit = int.TryParse(dailyLimitSection["DailyLimit"], out var limit) ? limit : 5;
                
                var usageStats = await context.DailyUsageStats
                    .FirstOrDefaultAsync(s => s.Date == today && s.AnonymousId == anonId);
                
                if (usageStats != null)
                {
                    if (dailyFreeLimit != -1 && usageStats.FreeUsageCount >= dailyFreeLimit)
                    {
                        // Free limit reached - show hint with link
                        hasResult = true;
                        usedTicket = false;
                        await LoadFreeUsageHint();
                        return;
                    }
                    usageStats.FreeUsageCount += 1;
                    usageStats.LastUsedAt = DateTime.UtcNow;
                }
                else
                {
                    if (dailyFreeLimit != -1 && 1 > dailyFreeLimit)
                    {
                        hasResult = true;
                        usedTicket = false;
                        await LoadFreeUsageHint();
                        return;
                    }
                    context.DailyUsageStats.Add(new DailyUsageStats
                    {
                        Date = today,
                        AnonymousId = anonId,
                        FreeUsageCount = 1,
                        LastUsedAt = DateTime.UtcNow
                    });
                }
                
                await context.SaveChangesAsync();
            }

            // Calculate using Excel service
            var input = new TuViInput
            {
                Gender = formModel.Gender,
                Day = formModel.BirthDay,
                Month = formModel.BirthMonth,
                Year = formModel.BirthYear,
                Hour = usedTicket ? formModel.BirthHour24.ToString() : formModel.BirthHour,
                Use24HourFormat = usedTicket,
                ViewYear = formModel.ViewYear
            };

            tuViResult = await TuViExcelService.CalculateTuViAsync(input);

            usedTicket = ticketValid;
            hasResult = true;
            
            await LoadFreeUsageHint();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Có lỗi xảy ra: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetInputMode(bool useProfileSelect)
    {
        _useProfileSelect = useProfileSelect;
        if (!_useProfileSelect)
        {
            _selectedProfile = null;
            _searchProfileQuery = "";
            _filteredProfilesForSearch.Clear();
        }
    }

    private void OnSearchProfileQueryChanged(ChangeEventArgs e)
    {
        _searchProfileQuery = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(_searchProfileQuery))
        {
            _filteredProfilesForSearch.Clear();
        }
        else
        {
            _filteredProfilesForSearch = _profiles
                .Where(p => p.FullName.Contains(_searchProfileQuery, StringComparison.OrdinalIgnoreCase))
                .Take(8)
                .ToList();
        }
    }

    private async Task SelectProfile(ExcelProfile profile)
    {
        _selectedProfile = profile;
        _searchProfileQuery = profile.FullName;
        _filteredProfilesForSearch.Clear();

        formModel.Gender = profile.Gender;
        formModel.BirthDay = profile.Day;
        formModel.BirthMonth = profile.Month;
        formModel.BirthYear = profile.Year;
        
        if (int.TryParse(profile.Hour, out var h24))
        {
            formModel.BirthHour24 = h24;
            formModel.BirthHour = Hour24ToCanh.TryGetValue(h24, out var canh) ? canh : "Ty";
        }
        else
        {
            var normalized = profile.Hour.ToLower()
                .Replace("tý", "Ty")
                .Replace("sửu", "Suu")
                .Replace("dần", "Dan")
                .Replace("mão", "Mao")
                .Replace("thìn", "Thin")
                .Replace("tỵ", "Ty2")
                .Replace("ngọ", "Ngo")
                .Replace("mùi", "Mui")
                .Replace("thân", "Than")
                .Replace("dậu", "Dau")
                .Replace("tuất", "Tuat")
                .Replace("hợi", "Hoi")
                .Replace("ty2", "Ty2")
                .Replace("ty", "Ty");
            
            if (CanhToHour24.TryGetValue(normalized, out var hourVal))
            {
                formModel.BirthHour = normalized;
                formModel.BirthHour24 = hourVal;
            }
        }

        await HandleSubmit();
    }
}