    private class HomeFormModel
    {
        [Required(ErrorMessage = "Vui lòng chọn loại lá số")]
        public string SelectedOption { get; set; } = "1";
        
        public string TicketCode { get; set; } = "";

        private int _birthDay = DateTime.Now.Day;
        private int _birthMonth = DateTime.Now.Month;
        private int _birthYear = DateTime.Now.Year;

        [Required(ErrorMessage = "Ngày sinh không được để trống")]
        public int BirthDay
        {
            get => _birthDay;
            set => _birthDay = value;
        }

        [Required(ErrorMessage = "Tháng sinh không được để trống")]
        public int BirthMonth
        {
            get => _birthMonth;
            set => _birthMonth = value;
        }

        [Required(ErrorMessage = "Năm sinh không được để trống")]
        public int BirthYear
        {
            get => _birthYear;
            set => _birthYear = value;
        }

        private bool IsLeapYear(int year) => (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);

        public int MaxDayInMonth => BirthMonth switch
        {
            1 or 3 or 5 or 7 or 8 or 10 or 12 => 31,
            4 or 6 or 9 or 11 => 30,
            2 => IsLeapYear(BirthYear) ? 29 : 28,
            _ => 30
        };

        [Required(ErrorMessage = "Năm xem không được để trống")]
        public int ViewYear { get; set; } = DateTime.Now.Year;
        
        public int BirthHour24 { get; set; } = 0;
        public string BirthHour { get; set; } = "Ty";
        public string BirthHour24h => $"{BirthHour24}h";
        
        [Required(ErrorMessage = "Vui lòng chọn giới tính")]
        public string Gender { get; set; } = "Nam";
    }

    private void OnBirthDayChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var day) && day > 0 && day <= 31)
        {
            formModel.BirthDay = day;
        }
    }

    private void OnBirthMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month) && month > 0 && month <= 12)
        {
            formModel.BirthMonth = month;
            if (formModel.BirthDay > formModel.MaxDayInMonth)
            {
                formModel.BirthDay = formModel.MaxDayInMonth;
            }
        }
    }

    private void OnBirthYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var year) && year >= 1900 && year <= 2099)
        {
            formModel.BirthYear = year;
            if (formModel.BirthDay > formModel.MaxDayInMonth)
            {
                formModel.BirthDay = formModel.MaxDayInMonth;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (isLoading) return;

        isLoading = true;
        hasResult = false;

        try
        {
            // Calculate using Excel service
            var input = new TuViInput
            {
                Gender = formModel.Gender,
                Day = formModel.BirthDay,
                Month = formModel.BirthMonth,
                Year = formModel.BirthYear,
                Hour = formModel.BirthHour,
                Use24HourFormat = false,
                ViewYear = formModel.ViewYear
            };

            // Support 24-hour format if slider is changed from 0
            if (formModel.BirthHour24 > 0)
            {
                input.Hour = formModel.BirthHour24.ToString();
                input.Use24HourFormat = true;
            }

            tuViResult = await TuViExcelService.CalculateTuViAsync(input);

            usedTicket = true; // Set to true to bypass premium layout limits
            hasResult = true;
            
            // Record usage stats silently in background without blocking
            try
            {
                var anonId = await JS.InvokeAsync<string>("getOrCreateAnonId");
                var today = DateOnly.FromDateTime(DateTime.UtcNow);
                using var context = DbFactory.CreateDbContext();
                var usageStats = await context.DailyUsageStats.FirstOrDefaultAsync(s => s.Date == today && s.AnonymousId == anonId);
                if (usageStats != null)
                {
                    usageStats.FreeUsageCount += 1;
                    usageStats.LastUsedAt = DateTime.UtcNow;
                }
                else
                {
                    context.DailyUsageStats.Add(new DailyUsageStats
                    {
                        Date = today,
                        AnonymousId = anonId,
                        FreeUsageCount = 1,
                        LastUsedAt = DateTime.UtcNow
                    });
                }
                await context.SaveChangesAsync();
            }
            catch {}
            
            await LoadFreeUsageHint();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Có lỗi xảy ra: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetInputMode(bool useProfileSelect)
    {
        _useProfileSelect = useProfileSelect;
        if (!_useProfileSelect)
        {
            _selectedProfile = null;
            _searchProfileQuery = "";
            _filteredProfilesForSearch.Clear();
        }
    }

    private void OnSearchProfileQueryChanged(ChangeEventArgs e)
    {
        _searchProfileQuery = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(_searchProfileQuery))
        {
            _filteredProfilesForSearch.Clear();
        }
        else
        {
            _filteredProfilesForSearch = _profiles
                .Where(p => p.FullName.Contains(_searchProfileQuery, StringComparison.OrdinalIgnoreCase))
                .Take(8)
                .ToList();
        }
    }

    private async Task SelectProfile(ExcelProfile profile)
    {
        _selectedProfile = profile;
        _searchProfileQuery = profile.FullName;
        _filteredProfilesForSearch.Clear();

        formModel.Gender = profile.Gender;
        formModel.BirthDay = profile.Day;
        formModel.BirthMonth = profile.Month;
        formModel.BirthYear = profile.Year;
        
        if (int.TryParse(profile.Hour, out var h24))
        {
            formModel.BirthHour24 = h24;
            formModel.BirthHour = Hour24ToCanh.TryGetValue(h24, out var canh) ? canh : "Ty";
        }
        else
        {
            var normalized = profile.Hour.ToLower()
                .Replace("tý", "Ty")
                .Replace("sửu", "Suu")
                .Replace("dần", "Dan")
                .Replace("mão", "Mao")
                .Replace("thìn", "Thin")
                .Replace("tỵ", "Ty2")
                .Replace("ngọ", "Ngo")
                .Replace("mùi", "Mui")
                .Replace("thân", "Than")
                .Replace("dậu", "Dau")
                .Replace("tuất", "Tuat")
                .Replace("hợi", "Hoi")
                .Replace("ty2", "Ty2")
                .Replace("ty", "Ty");
            
            if (CanhToHour24.TryGetValue(normalized, out var hourVal))
            {
                formModel.BirthHour = normalized;
                formModel.BirthHour24 = hourVal;
            }
        }

        await HandleSubmit();
    }
}