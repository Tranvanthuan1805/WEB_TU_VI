@page "/"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@attribute [StreamRendering]
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject ToastService ToastService
@inject TuViExcelService TuViExcelService
@inject IDbContextFactory<AppDBContext> DbFactory

<PageTitle>Trang chủ | Lá Số Tử Vi</PageTitle>



<div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Form Input (7 cols) -->
        <div class="lg:col-span-7 space-y-8">
            <div class="bg-white border border-outline-variant/40 shadow-sm rounded-3xl p-8 md:p-10 space-y-8">
                <header class="mb-6">
                    <h1 class="font-headline text-4xl md:text-5xl text-primary leading-tight mb-4 italic font-bold">Lập Lá Số Tử Vi</h1>
                    <p class="text-on-surface-variant font-body text-base font-light leading-relaxed">Khám phá bản đồ định mệnh của bạn thông qua thuật toán cổ truyền kết hợp trí tuệ số. Hãy nhập chính xác thông tin để khai mở Manuscript.</p>
                </header>
                
                <EditForm Model="@formModel" OnValidSubmit="@HandleSubmit" class="space-y-6">
                    <DataAnnotationsValidator />
                    
                    <!-- Option Selector Tab -->
                    <div class="relative">
                        <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">Chọn loại lá số</label>
                        <div class="grid grid-cols-3 gap-3">
                            <button type="button" class="flex flex-col items-center justify-center p-3 border rounded-xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer @(formModel.SelectedOption == "1" ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => formModel.SelectedOption = "1"'>
                                Cơ Bản
                            </button>
                            <button type="button" class="flex flex-col items-center justify-center p-3 border rounded-xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer @(formModel.SelectedOption == "2" ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => formModel.SelectedOption = "2"'>
                                Vận Hạn
                            </button>
                            <button type="button" class="flex flex-col items-center justify-center p-3 border rounded-xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer @(formModel.SelectedOption == "3" ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => formModel.SelectedOption = "3"'>
                                Trọn Đời
                            </button>
                        </div>
                    </div>

                    <!-- Input Mode Selection -->
                    <div class="relative space-y-2 pb-4 border-b border-outline-variant/30">
                        <label class="block text-xs font-bold text-on-surface uppercase tracking-wider">Phương thức nhập thông tin</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button type="button" class="py-3 border rounded-xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer @(!_useProfileSelect ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => SetInputMode(false)'>
                                Nhập thủ công
                            </button>
                            <button type="button" class="py-3 border rounded-xl font-bold text-xs uppercase tracking-wider transition-all cursor-pointer @(_useProfileSelect ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => SetInputMode(true)'>
                                Chọn từ danh sách
                            </button>
                        </div>
                    </div>

                    @if (_useProfileSelect)
                    {
                        <!-- Search and select Profile -->
                        <div class="relative space-y-2">
                            <label class="block text-xs font-bold text-on-surface uppercase tracking-wider">Tìm kiếm người trong danh sách</label>
                            <div class="relative">
                                <div class="flex gap-2">
                                    <input class="ivory-input" type="text" @bind="_searchProfileQuery" @oninput="OnSearchProfileQueryChanged" placeholder="Nhập tên để tìm kiếm..." />
                                </div>
                                @if (_filteredProfilesForSearch.Any())
                                {
                                    <div class="absolute z-50 left-0 right-0 mt-1 bg-white border border-outline-variant/60 rounded-xl shadow-lg max-h-60 overflow-y-auto">
                                        @foreach (var profile in _filteredProfilesForSearch)
                                        {
                                            <div class="px-4 py-2.5 hover:bg-primary/5 cursor-pointer text-sm transition-colors border-b border-outline-variant/20 last:border-none" @onclick="() => SelectProfile(profile)">
                                                <div class="font-bold text-primary">@profile.FullName (@profile.Gender)</div>
                                                <div class="text-xs text-on-surface-variant">Sinh ngày: @profile.Day/@profile.Month/@profile.Year - Giờ: @profile.Hour @(string.IsNullOrEmpty(profile.Notes) ? "" : $"| Ghi chú: {profile.Notes}")</div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(_searchProfileQuery) && _searchProfileQuery != _selectedProfile?.FullName)
                                {
                                    <div class="absolute z-50 left-0 right-0 mt-1 bg-white border border-outline-variant/60 rounded-xl shadow-lg p-4 text-center text-xs text-on-surface-variant italic">
                                        Không tìm thấy tên tương thích
                                    </div>
                                }
                            </div>
                            @if (_selectedProfile != null)
                            {
                                <div class="p-4 bg-primary/5 border border-primary/20 rounded-2xl text-xs space-y-2 shadow-sm">
                                    <div class="flex items-center justify-between">
                                        <div>Đang chọn: <span class="font-bold text-primary text-sm">@_selectedProfile.FullName</span> (@_selectedProfile.Gender)</div>
                                        <span class="px-2 py-0.5 bg-primary/10 text-primary rounded text-[10px] font-bold">Đã đồng bộ</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 text-on-surface-variant">
                                        <div>Ngày sinh: <span class="font-semibold text-on-surface">@_selectedProfile.Day/@_selectedProfile.Month/@_selectedProfile.Year</span></div>
                                        <div>Giờ sinh: <span class="font-semibold text-on-surface">@_selectedProfile.Hour</span></div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_selectedProfile.Notes))
                                    {
                                        <div class="text-on-surface-variant/80 italic pt-1 border-t border-outline-variant/20">Ghi chú: @_selectedProfile.Notes</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Birth: Ngay/Thang/Nam -->
                        <div class="grid grid-cols-3 gap-4">
                            <div class="relative">
                                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Ngày sinh</label>
                                <input class="ivory-input mt-1" type="number" min="1" max="@formModel.MaxDayInMonth" @bind="formModel.BirthDay" @oninput="OnBirthDayChanged" />
                            </div>
                            <div class="relative">
                                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Tháng sinh</label>
                                <input class="ivory-input mt-1" type="number" min="1" max="12" @bind="formModel.BirthMonth" @oninput="OnBirthMonthChanged" />
                            </div>
                            <div class="relative">
                                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Năm sinh</label>
                                <input class="ivory-input mt-1" type="number" min="1900" max="2099" @bind="formModel.BirthYear" @oninput="OnBirthYearChanged" />
                            </div>
                        </div>
                        
                        <!-- Time and Gender -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="relative">
                                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Giờ sinh</label>
                                
                                <!-- Slider -->
                                <div class="px-1 py-2">
                                    <input type="range" min="0" max="23" step="1" 
                                           class="w-full h-1.5 bg-surface-container rounded-lg appearance-none cursor-pointer mb-2 accent-primary"
                                           @bind="formModel.BirthHour24" @oninput="OnSliderChanged" />
                                    <div class="flex justify-between text-[11px] text-on-surface-variant font-semibold px-0.5">
                                        <span>0h</span>
                                        <span class="text-primary font-bold">@formModel.BirthHour24h</span>
                                        <span>23h</span>
                                    </div>
                                </div>
                                
                                <!-- Select -->
                                <select class="ivory-input mt-1 cursor-pointer" @bind="formModel.BirthHour" @oninput="OnSelectChanged">
                                    <option class="bg-white" value="Ty">Tý (23h - 01h)</option>
                                    <option class="bg-white" value="Suu">Sửu (01h - 03h)</option>
                                    <option class="bg-white" value="Dan">Dần (03h - 05h)</option>
                                    <option class="bg-white" value="Mao">Mão (05h - 07h)</option>
                                    <option class="bg-white" value="Thin">Thìn (07h - 09h)</option>
                                    <option class="bg-white" value="Ty2">Tỵ (09h - 11h)</option>
                                    <option class="bg-white" value="Ngo">Ngọ (11h - 13h)</option>
                                    <option class="bg-white" value="Mui">Mùi (13h - 15h)</option>
                                    <option class="bg-white" value="Than">Thân (15h - 17h)</option>
                                    <option class="bg-white" value="Dau">Dậu (17h - 19h)</option>
                                    <option class="bg-white" value="Tuat">Tuất (19h - 21h)</option>
                                    <option class="bg-white" value="Hoi">Hợi (21h - 23h)</option>
                                </select>
                            </div>
                            
                            <div class="relative">
                                <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-2">Giới tính</label>
                                <div class="grid grid-cols-2 gap-3">
                                    <button type="button" class="py-3.5 border rounded-xl font-bold text-sm transition-all cursor-pointer @(formModel.Gender == "Nam" ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => formModel.Gender = "Nam"'>
                                        Nam
                                    </button>
                                    <button type="button" class="py-3.5 border rounded-xl font-bold text-sm transition-all cursor-pointer @(formModel.Gender == "Nữ" ? "border-primary bg-primary/5 text-primary" : "border-outline-variant/60 bg-white text-on-surface-variant hover:border-outline")" @onclick='() => formModel.Gender = "Nữ"'>
                                        Nữ
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <!-- Nam Xem -->
                    <div class="relative">
                        <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Năm xem</label>
                        <input class="ivory-input mt-1" type="number" min="1900" max="2100" @bind="formModel.ViewYear" />
                    </div>
                    
                    <!-- Ticket Code Input -->
                    <div class="relative">
                        <label class="block text-xs font-bold text-on-surface uppercase tracking-wider mb-1">Mã vé (tuỳ chọn)</label>
                        <input class="ivory-input mt-1" type="text" @bind="formModel.TicketCode" placeholder="Nhập mã vé nếu có" />
                    </div>
                    
                    <!-- Free Usage Hint -->
                    @if (freeUsageHintVisible)
                    {
                        <div class="text-xs text-on-surface-variant/80 font-bold bg-background/50 border border-outline-variant/30 rounded-lg px-4 py-2.5 inline-block">
                            <span class="material-symbols-outlined text-sm align-middle mr-1.5 text-primary">info</span>
                            <span class="align-middle">@freeUsageHint</span>
                        </div>
                    }
                    
                    <div class="pt-4">
                        <button class="btn-gold py-4.5 w-full flex items-center justify-center gap-2 cursor-pointer shadow-md hover:scale-[1.005] active:scale-[0.995]" 
                                type="submit" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="font-bold">Đang tính toán lá số...</span>
                            }
                            else
                            {
                                <span class="font-bold tracking-widest">Lập Lá Số Ngay</span>
                                <span class="material-symbols-outlined text-lg">flare</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
        
        <!-- Right: Decorative sidebars (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
            <!-- Card 1: Illustration & Social proof/quote -->
            <div class="bg-white border border-outline-variant/50 shadow-sm rounded-3xl p-6 space-y-6">
                <div class="relative rounded-2xl overflow-hidden aspect-[16/10] shadow-sm">
                    <img class="w-full h-full object-cover sepia-[0.15] brightness-[0.93]" data-alt="ethereal portrait"
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuAm4UysmCrrtwbRhfFYYTqcrMv4VHb4TAgR4mIz_bBGFJY-GVLrg_dGtlH5HkOBJfnO5zwLxOn14ne2os0hYVk7fUSGEw1kJbJuXmcDH5c4XY3L8h8UKUr2v-8glPqWIpgCUQ6o7-e0_Rerm4W_qmf5Fru3ZqMsyqP6DpwsiKgYGlZle9wdJMgxZ9EXStQwhQB_dx0cEGGIsHcSQOkYkgdQRKm7b0mIkfbseXXwsWDh_o-vbhY8aIAKnW2kp_WWrxhOXP_EFhvYz4E" />
                    <div class="absolute inset-0 bg-gradient-to-t from-white/95 via-white/10 to-transparent"></div>
                    <div class="absolute bottom-4 left-4 right-4 z-10">
                        <p class="text-xs italic text-on-surface font-semibold bg-white/80 backdrop-blur-sm p-3 rounded-xl border border-outline-variant/30 leading-relaxed shadow-sm">
                            "Mệnh tốt không bằng Thân tốt, Thân tốt không bằng Hạn tốt."
                        </p>
                    </div>
                </div>
                
                @if (_facebookEnabled || _zaloEnabled)
                {
                    <div class="pt-4 border-t border-outline-variant/30">
                        <span class="label-sm uppercase tracking-widest text-primary font-bold text-[11px] mb-3 block">Liên hệ</span>
                        <h4 class="font-headline text-base text-on-surface font-bold mb-3 italic">Tư vấn chuyên sâu</h4>
                        <div class="flex gap-4">
                            @if (_facebookEnabled && !string.IsNullOrEmpty(_facebookUrl))
                            {
                                <a href="@_facebookUrl" target="_blank" rel="noopener noreferrer" 
                                   class="flex items-center gap-2 px-4 py-2.5 border border-outline-variant/60 rounded-xl text-on-surface-variant hover:text-primary hover:border-primary transition-colors">
                                    <span class="material-symbols-outlined text-base">chat</span>
                                    <span class="text-xs font-semibold">Facebook</span>
                                </a>
                            }
                            @if (_zaloEnabled && !string.IsNullOrEmpty(_zaloUrl))
                            {
                                <a href="@_zaloUrl" target="_blank" rel="noopener noreferrer"
                                   class="flex items-center gap-2 px-4 py-2.5 border border-outline-variant/60 rounded-xl text-on-surface-variant hover:text-primary hover:border-primary transition-colors">
                                    <span class="material-symbols-outlined text-base">chat</span>
                                    <span class="text-xs font-semibold">Zalo</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Card 2: Knowledge Sidebar -->
            <div class="bg-white border border-outline-variant/50 shadow-sm rounded-3xl p-6 space-y-6">
                <div>
                    <span class="label-sm uppercase tracking-widest text-primary font-bold text-[11px] mb-3 block">Kiến Thức Tử Vi</span>
                    <h3 class="font-headline text-2xl text-primary font-bold mb-5 italic">Giải Mã Thuật Ngữ</h3>
                    <div class="space-y-5">
                        <div class="group border-b border-outline-variant/20 pb-4 last:border-none last:pb-0">
                            <h4 class="text-on-surface font-headline font-bold text-base mb-1">Cung (Palaces)</h4>
                            <p class="text-on-surface-variant text-sm leading-relaxed font-light">12 cung địa bàn đại diện cho 12 phương diện của cuộc đời như Mệnh, Phụ, Phúc, Điền, Quan...</p>
                        </div>
                        <div class="group border-b border-outline-variant/20 pb-4 last:border-none last:pb-0">
                            <h4 class="text-on-surface font-headline font-bold text-base mb-1">Sao (Stars)</h4>
                            <p class="text-on-surface-variant text-sm leading-relaxed font-light">Hệ thống Chính tinh và Phụ tinh tương tác lẫn nhau, tạo nên các cách cục tốt xấu trong lá số.</p>
                        </div>
                        <div class="group">
                            <h4 class="text-on-surface font-headline font-bold text-base mb-1">Hạn (Periods)</h4>
                            <p class="text-on-surface-variant text-sm leading-relaxed font-light">Đại vận 10 năm và tiểu vận hàng năm giúp dự đoán các biến cố và thời cơ trong cuộc sống.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 3: Recent Posts -->
            <div class="bg-white border border-outline-variant/50 shadow-sm rounded-3xl p-6 space-y-4">
                <h5 class="font-bold text-[11px] uppercase tracking-widest text-primary">Bài viết mới nhất</h5>
                @if (_recentPosts == null)
                {
                    <p class="text-xs text-on-surface-variant/70 italic">Đang tải...</p>
                }
                else
                {
                    if (_recentPosts.Any())
                    {
                        <div class="space-y-4">
                            @foreach (var post in _recentPosts)
                            {
                                <NavLink class="block group border-b border-outline-variant/20 pb-3 last:border-none last:pb-0" href="@($"/bai-viet/{post.Slug}")">
                                    <p class="text-sm font-bold text-on-surface group-hover:text-primary transition-colors mb-1 leading-snug">@post.Title</p>
                                    <span class="text-[11px] text-on-surface-variant line-clamp-2 leading-relaxed">@((MarkupString)post.Description)</span>
                                </NavLink>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-xs text-on-surface-variant/70 italic">Chưa có bài viết nào.</p>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Results row below form & sidebars (Full width 12 columns) -->
    @if (hasResult)
    {
        <div class="mt-12 border-t border-outline-variant/30 pt-10 space-y-8">
            <div class="text-center mb-6">
                <h3 class="font-headline text-3xl md:text-4xl text-primary font-bold mb-2 italic">
                    @if (_selectedProfile != null)
                    {
                        @($"Bản Đồ Mệnh Cách - {_selectedProfile.FullName}")
                    }
                    else
                    {
                        @("Bản Đồ Mệnh Cách")
                    }
                </h3>
                <p class="text-on-surface-variant text-sm font-semibold">
                    @($"Giới tính: {formModel.Gender} | Ngày sinh: {formModel.BirthDay}/{formModel.BirthMonth}/{formModel.BirthYear} - {formModel.BirthHour}")
                </p>
                @if (_selectedProfile != null && !string.IsNullOrEmpty(_selectedProfile.Notes))
                {
                    <p class="text-on-surface-variant/80 text-xs italic mt-1.5">Ghi chú: @_selectedProfile.Notes</p>
                }
            </div>
            
            @if (tuViResult != null)
            {
                <div class="grid grid-cols-1 gap-8">
                    <!-- Accordion: Thể Cách -->
                    <div class="border border-outline-variant/60 rounded-2xl overflow-hidden shadow-sm">
                        <button class="w-full flex items-center justify-between px-6 py-4.5 bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer"
                                @onclick="() => showTheCach = !showTheCach">
                            <span class="font-headline text-xl font-bold text-primary">Thể Cách</span>
                            <span class="material-symbols-outlined text-primary transition-transform duration-300 @(showTheCach ? "rotate-180" : "")">
                                expand_more
                            </span>
                        </button>
                        @if (showTheCach && !string.IsNullOrEmpty(tuViResult.TheCachHtml))
                        {
                            <div class="border-t border-outline-variant/40 p-6 bg-white text-on-surface leading-relaxed text-base overflow-x-auto">
                                @((MarkupString)tuViResult.TheCachHtml)
                            </div>
                        }
                    </div>
                    
                    <!-- Accordion: Tử Vi -->
                    <div class="border border-outline-variant/60 rounded-2xl overflow-hidden shadow-sm">
                        <button class="w-full flex items-center justify-between px-6 py-4.5 bg-surface-container-low hover:bg-surface-container transition-colors cursor-pointer"
                                @onclick="() => showTuVi = !showTuVi">
                            <span class="font-headline text-xl font-bold text-primary">Tử Vi</span>
                            <span class="material-symbols-outlined text-primary transition-transform duration-300 @(showTuVi ? "rotate-180" : "")">
                                expand_more
                            </span>
                        </button>
                        @if (showTuVi && !string.IsNullOrEmpty(tuViResult.TuViHtml))
                        {
                            <div class="border-t border-outline-variant/40 p-6 bg-white text-on-surface leading-relaxed text-base overflow-x-auto">
                                @((MarkupString)tuViResult.TuViHtml)
                            </div>
                        }
                    </div>
                </div>
                
                @if (!usedTicket)
                {
                    <div class="max-w-xl mx-auto mt-8 p-8 bg-surface-container-low border border-primary/20 rounded-3xl text-center shadow-sm space-y-4">
                        <p class="text-on-surface-variant font-medium text-sm">
                            Để mở khóa bản luận giải đầy đủ chi tiết hơn, xin vui lòng sử dụng vé của bạn.
                        </p>
                        <a href="/san-pham" class="btn-gold px-8 py-3.5 inline-flex items-center justify-center gap-2 text-xs">
                            Mua vé ngay
                            <span class="material-symbols-outlined text-sm">shopping_bag</span>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="max-w-xl mx-auto mt-8 p-8 bg-surface-container-low border border-primary/20 rounded-3xl text-center shadow-sm space-y-4">
                    <span class="material-symbols-outlined text-4xl text-primary mb-2">lock</span>
                    <h4 class="font-headline text-lg font-bold text-primary">Đã Hết Lượt Xem Miễn Phí</h4>
                    <p class="text-on-surface-variant font-medium text-sm">
                        Bạn đã sử dụng hết 5 lượt xem miễn phí hôm nay. Vui lòng nhập mã vé hoặc mua vé để tiếp tục xem lá số.
                    </p>
                    <a href="/san-pham" class="btn-gold px-8 py-3.5 inline-flex items-center justify-center gap-2 text-xs">
                        Mua vé ngay
                        <span class="material-symbols-outlined text-sm">shopping_bag</span>
                    </a>
                </div>
            }
        </div>
    }
</div>

    
<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        border: 1px solid var(--outline-variant);
    }
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--primary);
        cursor: pointer;
        transition: transform 0.1s ease;
