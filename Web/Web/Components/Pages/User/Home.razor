@page "/"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@attribute [StreamRendering]
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject ToastService ToastService
@inject TuViExcelService TuViExcelService
@inject IDbContextFactory<AppDBContext> DbFactory

<PageTitle>Trang chủ | Lá Số Tử Vi</PageTitle><div class="max-w-6xl mx-auto w-full px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Form Input (8 cols) -->
        <div class="lg:col-span-8 w-full">
            <div class="space-y-6 w-full">
                <EditForm Model="@formModel" OnValidSubmit="@HandleSubmit" class="bg-white rounded-[2.5rem] border border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.03)] p-6 md:p-8 space-y-6">
                    <DataAnnotationsValidator />
                    
                    <div class="space-y-2 text-left">
                        <h2 class="text-3xl font-bold font-serif text-stone-800 tracking-tight">Lập Lá Số Tử Vi</h2>
                        <p class="text-slate-450 text-[13px] leading-relaxed">Khám phá bản đồ định mệnh của bạn thông qua thuật toán cổ truyền kết hợp trí tuệ số. Hãy nhập chính xác thông tin để khai mở Manuscript.</p>
                    </div>
                    
                    <!-- Option Selector Tab -->
                    <div class="space-y-2 text-left">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Chọn loại lá số</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" class="py-3 px-1 text-[11px] font-bold rounded-xl border text-center transition-all cursor-pointer @(formModel.SelectedOption == "1" ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => formModel.SelectedOption = "1"'>
                                CƠ BẢN
                            </button>
                            <button type="button" class="py-3 px-1 text-[11px] font-bold rounded-xl border text-center transition-all cursor-pointer @(formModel.SelectedOption == "2" ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => formModel.SelectedOption = "2"'>
                                VẬN HẠN
                            </button>
                            <button type="button" class="py-3 px-1 text-[11px] font-bold rounded-xl border text-center transition-all cursor-pointer @(formModel.SelectedOption == "3" ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => formModel.SelectedOption = "3"'>
                                TRỌN ĐỜI
                            </button>
                        </div>
                    </div>

                    <!-- Input Mode Selection -->
                    <div class="space-y-2 text-left">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Phương thức nhập thông tin</label>
                        <div class="grid grid-cols-2 gap-2">
                            <button type="button" class="py-3 px-1 text-[11px] font-bold rounded-xl border text-center transition-all cursor-pointer @(!_useProfileSelect ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => SetInputMode(false)'>
                                NHẬP THỦ CÔNG
                            </button>
                            <button type="button" class="py-3 px-1 text-[11px] font-bold rounded-xl border text-center transition-all cursor-pointer @(_useProfileSelect ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => SetInputMode(true)'>
                                CHỌN TỪ DANH SÁCH
                            </button>
                        </div>
                    </div>

                    @if (_useProfileSelect)
                    {
                        <!-- Search and select Profile -->
                        <div class="space-y-2 text-left">
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Tìm kiếm người trong danh sách</label>
                            <div class="relative">
                                <input class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white" type="text" @bind="_searchProfileQuery" @oninput="OnSearchProfileQueryChanged" placeholder="Nhập tên để tìm kiếm..." />
                                @if (_filteredProfilesForSearch.Any())
                                {
                                    <div class="absolute z-50 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg max-h-60 overflow-y-auto">
                                        @foreach (var profile in _filteredProfilesForSearch)
                                        {
                                            <div class="px-4 py-2.5 hover:bg-amber-50 cursor-pointer text-sm transition-colors border-b border-slate-100 last:border-none" @onclick="() => SelectProfile(profile)">
                                                <div class="font-bold text-amber-800">@profile.FullName (@profile.Gender)</div>
                                                <div class="text-xs text-slate-500">Sinh ngày: @profile.Day/@profile.Month/@profile.Year - Giờ: @profile.Hour @(string.IsNullOrEmpty(profile.Notes) ? "" : $"| Ghi chú: {profile.Notes}")</div>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(_searchProfileQuery) && _searchProfileQuery != _selectedProfile?.FullName)
                                {
                                    <div class="absolute z-50 left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg p-4 text-center text-xs text-slate-450 italic">
                                        Không tìm thấy tên tương thích
                                    </div>
                                }
                            </div>
                            @if (_selectedProfile != null)
                            {
                                <div class="p-4 bg-amber-50/20 border border-amber-200/40 rounded-2xl text-xs space-y-2 shadow-sm">
                                    <div class="flex items-center justify-between">
                                        <div>Đang chọn: <span class="font-bold text-amber-800 text-sm">@_selectedProfile.FullName</span> (@_selectedProfile.Gender)</div>
                                        <span class="px-2 py-0.5 bg-amber-100 text-amber-800 rounded text-[10px] font-bold">Đã đồng bộ</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 text-slate-500">
                                        <div>Ngày sinh: <span class="font-semibold text-slate-700">@_selectedProfile.Day/@_selectedProfile.Month/@_selectedProfile.Year</span></div>
                                        <div>Giờ sinh: <span class="font-semibold text-slate-700">@_selectedProfile.Hour</span></div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_selectedProfile.Notes))
                                    {
                                        <div class="text-slate-500/80 italic pt-1 border-t border-slate-100">Ghi chú: @_selectedProfile.Notes</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <!-- Birth: Ngay/Thang/Nam -->
                        <div class="grid grid-cols-3 gap-3 text-left">
                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Ngày sinh</label>
                                <input class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white" type="number" min="1" max="@formModel.MaxDayInMonth" @bind="formModel.BirthDay" @oninput="OnBirthDayChanged" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Tháng sinh</label>
                                <input class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white" type="number" min="1" max="12" @bind="formModel.BirthMonth" @oninput="OnBirthMonthChanged" />
                            </div>
                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Năm sinh</label>
                                <input class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white" type="number" min="1901" max="2099" @bind="formModel.BirthYear" @oninput="OnBirthYearChanged" />
                            </div>
                        </div>
                        
                        <!-- Time and Gender -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Giờ sinh</label>
                                
                                <!-- Slider -->
                                <div class="relative pt-1 px-1">
                                    <input type="range" min="0" max="23" step="1" 
                                           class="w-full h-1.5 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-amber-600 my-3"
                                           @bind="formModel.BirthHour24" @oninput="OnSliderChanged" />
                                    <div class="flex justify-between text-[10px] text-slate-400 font-semibold px-0.5">
                                        <span>0h</span>
                                        <span class="text-amber-700 font-bold">@formModel.BirthHour24h</span>
                                        <span>23h</span>
                                    </div>
                                </div>
                                
                                <!-- Select -->
                                <select class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 outline-none text-slate-700 font-semibold text-sm bg-slate-50/50 cursor-pointer transition-all" @bind="formModel.BirthHour" @oninput="OnSelectChanged">
                                    <option value="Ty">00h · Tý (23h - 01h)</option>
                                    <option value="Suu">02h · Sửu (01h - 03h)</option>
                                    <option value="Dan">04h · Dần (03h - 05h)</option>
                                    <option value="Mao">06h · Mão (05h - 07h)</option>
                                    <option value="Thin">08h · Thìn (07h - 09h)</option>
                                    <option value="Ty2">10h · Tỵ (09h - 11h)</option>
                                    <option value="Ngo">12h · Ngọ (11h - 13h)</option>
                                    <option value="Mui">14h · Mùi (13h - 15h)</option>
                                    <option value="Than">16h · Thân (15h - 17h)</option>
                                    <option value="Dau">18h · Dậu (17h - 19h)</option>
                                    <option value="Tuat">20h · Tuất (19h - 21h)</option>
                                    <option value="Hoi">22h · Hợi (21h - 23h)</option>
                                </select>
                            </div>
                            
                            <div class="space-y-2">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Giới tính</label>
                                <div class="grid grid-cols-2 gap-2 h-[106px] items-end">
                                    <button type="button" class="py-3.5 px-4 rounded-xl border text-center font-bold text-sm transition-all cursor-pointer @(formModel.Gender == "Nam" ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => formModel.Gender = "Nam"'>
                                        Nam
                                    </button>
                                    <button type="button" class="py-3.5 px-4 rounded-xl border text-center font-bold text-sm transition-all cursor-pointer @(formModel.Gender == "Nữ" ? "border-amber-700 bg-amber-50/40 text-stone-850 shadow-sm" : "border-slate-200 bg-transparent text-slate-400 hover:border-slate-300 hover:text-slate-600")" @onclick='() => formModel.Gender = "Nữ"'>
                                        Nữ
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    
                    <!-- Nam Xem -->
                    <div class="space-y-2 text-left">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Năm xem</label>
                        <input class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white" type="number" min="1900" max="2100" @bind="formModel.ViewYear" />
                    </div>
                    
                    <!-- Ticket Code Input -->
                    <div class="space-y-2 text-left">
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest">Mã vé (tùy chọn)</label>
                        <input class="w-full px-4 py-3.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white" type="text" @bind="formModel.TicketCode" placeholder="Nhập mã vé nếu có" />
                    </div>
                    
                    <!-- Free Usage Hint -->
                    @if (freeUsageHintVisible && !string.IsNullOrEmpty(freeUsageHint))
                    {
                        <div class="text-xs text-emerald-600 font-bold bg-emerald-50 border border-emerald-100 rounded-lg px-2.5 py-1 inline-block">
                            <span>✓</span>
                            <span>@freeUsageHint</span>
                        </div>
                    }
                    
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
                        <div class="flex items-center gap-1.5 text-xs text-emerald-600 font-bold bg-emerald-50 border border-emerald-100 rounded-lg px-2.5 py-1">
                            <span>✓</span><span>Mở khóa miễn phí 100%</span>
                        </div>
                        <button type="submit" class="px-8 py-3.5 text-white disabled:text-slate-400 font-bold text-xs uppercase tracking-widest rounded-xl transition-all cursor-pointer shadow-md hover:scale-[1.02] active:scale-95 shrink-0" style="background:linear-gradient(135deg, #a68249, #8f6d39)" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span>ĐANG TÍNH TOÁN LÁ SỐ...</span>
                            }
                            else
                            {
                                <span>LẬP LÁ SỐ NGAY ❈</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
        
        <!-- Right: Decorative sidebars (4 cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20 w-full">
            <!-- Card 1: Illustration & Quote -->
            <div class="bg-white rounded-3xl p-5 border border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.02)] space-y-4">
                <div class="rounded-2xl overflow-hidden aspect-[4/3] relative border border-slate-50">
                    <img src="/mystical_woman.png" alt="Mystical celestial woman" class="object-cover w-full h-full"/>
                </div>
                <div class="bg-slate-50/50 rounded-xl p-3.5 border border-slate-100 text-center">
                    <p class="text-xs italic text-slate-500 font-medium leading-relaxed">
                        "Mệnh tốt không bằng Thân tốt, Thân tốt không bằng Hạn tốt."
                    </p>
                </div>
            </div>

            <!-- Card 2: Knowledge Sidebar -->
            <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.02)] space-y-5 text-left">
                <div>
                    <p class="text-[10px] font-bold text-amber-600 uppercase tracking-widest mb-1">Kiến thức tử vi</p>
                    <h3 class="text-xl font-bold font-serif text-stone-800">Giải Mã Thuật Ngữ</h3>
                </div>
                <div class="space-y-4">
                    <div>
                        <p class="font-bold text-stone-800 text-sm">Cung (Palaces)</p>
                        <p class="text-slate-400 text-xs mt-1 leading-relaxed">12 cung địa bàn đại diện cho 12 phương diện của cuộc đời như Mệnh, Phụ, Phúc, Điền, Quan...</p>
                    </div>
                    <div>
                        <p class="font-bold text-stone-800 text-sm">Sao (Stars)</p>
                        <p class="text-slate-400 text-xs mt-1 leading-relaxed">Hệ thống Chính tinh và Phụ tinh tương tác lẫn nhau, tạo nên các cách cục tốt xấu trong lá số.</p>
                    </div>
                    <div>
                        <p class="font-bold text-stone-800 text-sm">Hạn (Periods)</p>
                        <p class="text-slate-400 text-xs mt-1 leading-relaxed">Đại vận 10 năm và tiểu vận hàng năm giúp dự đoán các biến cố và thời cơ trong cuộc sống.</p>
                    </div>
                </div>
            </div>

            <!-- Card 3: Recent Posts -->
            <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-[0_4px_30px_rgba(0,0,0,0.02)] space-y-3 text-left">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Bài viết mới nhất</p>
                @if (_recentPosts == null)
                {
                    <p class="text-xs text-slate-400 italic">Đang tải...</p>
                }
                else
                {
                    <div class="space-y-2.5">
                        @foreach (var post in _recentPosts)
                        {
                            <a href="/bai-viet/@post.Slug" class="block text-xs font-semibold text-stone-700 hover:text-amber-600 transition-colors truncate">✦ @post.Title.ToUpper()</a>
                        }
                        @if (!_recentPosts.Any())
                        {
                            <p class="text-xs text-slate-400 italic">Chưa có bài viết nào.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Results row below form & sidebars (Full width) -->
    @if (hasResult)
    {
        <div class="mt-12 border-t border-slate-200 pt-10 space-y-8">
            <div class="text-center mb-6">
                <h3 class="font-serif text-3xl md:text-4xl text-amber-800 font-bold mb-2 italic">
                    @if (_selectedProfile != null)
                    {
                        @($"Bản Đồ Mệnh Cách - {_selectedProfile.FullName}")
                    }
                    else
                    {
                        @("Bản Đồ Mệnh Cách")
                    }
                </h3>
                <p class="text-slate-650 text-sm font-semibold">
                    @($"Giới tính: {formModel.Gender} | Ngày sinh: {formModel.BirthDay}/{formModel.BirthMonth}/{formModel.BirthYear} - {formModel.BirthHour}")
                </p>
                @if (_selectedProfile != null && !string.IsNullOrEmpty(_selectedProfile.Notes))
                {
                    <p class="text-slate-500/80 text-xs italic mt-1.5">Ghi chú: @_selectedProfile.Notes</p>
                }
            </div>
            
            @if (tuViResult != null)
            {
                <div class="space-y-8">
                    <!-- Lá Số Tử Vi Grid (No accordion, fully visible) -->
                    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-4 md:p-6 overflow-x-auto">
                        <div class="flex items-center gap-2 mb-4 px-2">
                            <span class="material-symbols-outlined text-amber-800 text-lg">grid_on</span>
                            <h4 class="font-serif text-lg font-bold text-amber-800">Lá Số Tử Vi Chi Tiết</h4>
                        </div>
                        @if (!string.IsNullOrEmpty(tuViResult.TuViHtml))
                        {
                            <div class="overflow-x-auto">
                                @((MarkupString)tuViResult.TuViHtml)
                            </div>
                        }
                    </div>

                    <!-- Accordion: Thể Cách -->
                    <div class="border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                        <button class="w-full flex items-center justify-between px-6 py-4.5 bg-slate-50 hover:bg-slate-100 transition-colors cursor-pointer"
                                @onclick="() => showTheCach = !showTheCach">
                            <span class="font-serif text-xl font-bold text-amber-800">Thông Tin Thể Cách</span>
                            <span class="material-symbols-outlined text-amber-800 transition-transform duration-300 @(showTheCach ? "rotate-180" : "")">
                                expand_more
                            </span>
                        </button>
                        @if (showTheCach && !string.IsNullOrEmpty(tuViResult.TheCachHtml))
                        {
                            <div class="border-t border-slate-200 p-6 bg-white text-slate-800 leading-relaxed text-base overflow-x-auto">
                                @((MarkupString)tuViResult.TheCachHtml)
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        border: 1px solid var(--outline-variant);
    }
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--primary);
        cursor: pointer;
        transition: transform 0.1s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
        transform: scale(1.2);
    }
    input[type="range"]::-moz-range-thumb {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--primary);
        cursor: pointer;
        border: none;
        transition: transform 0.1s ease;
    }
    input[type="range"]::-moz-range-thumb:hover {
        transform: scale(1.2);
    }
    .rotate-180 {
        transform: rotate(180deg);
    }
    .gap-0\.5 {
        gap: 0.125rem;
    }
    [data-grid] {
        display: grid;
    }
    [data-cell] {
        min-width: 0;
    }
</style>

@code {
    private HomeFormModel formModel = new();
    private bool isLoading = false;
    private bool hasResult = false;
    private bool usedTicket = false;
    private bool showTheCach = true;
    private bool showTuVi = false;
    private TuViResult? tuViResult;
    
    // Free usage tracking
    private bool freeUsageHintVisible = true;
    private string freeUsageHint = "";
    private int currentFreeUsage = 0;
    private int dailyFreeLimit = 5;

    // Redesign properties
    private List<Post> _recentPosts = new();
    private bool _facebookEnabled;
    private string _facebookUrl = "";
    private bool _zaloEnabled;
    private string _zaloUrl = "";

    // Excel profiles properties
    private List<ExcelProfile> _profiles = new();
    private List<ExcelProfile> _filteredProfilesForSearch = new();
    private string _searchProfileQuery = "";
    private ExcelProfile? _selectedProfile;
    private bool _useProfileSelect = false;

    private static readonly Dictionary<int, string> Hour24ToCanh = new()
    {
        [0] = "Ty", [1] = "Suu", [2] = "Suu", [3] = "Dan", [4] = "Dan", [5] = "Mao",
        [6] = "Mao", [7] = "Thin", [8] = "Thin", [9] = "Ty2", [10] = "Ty2", [11] = "Ngo",
        [12] = "Ngo", [13] = "Mui", [14] = "Mui", [15] = "Than", [16] = "Than", [17] = "Dau",
        [18] = "Dau", [19] = "Tuat", [20] = "Tuat", [21] = "Hoi", [22] = "Hoi", [23] = "Ty"
    };

    private static readonly Dictionary<string, int> CanhToHour24 = new()
    {
        ["Ty"] = 23, ["Suu"] = 1, ["Dan"] = 3, ["Mao"] = 5, ["Thin"] = 7, ["Ty2"] = 9,
        ["Ngo"] = 11, ["Mui"] = 13, ["Than"] = 15, ["Dau"] = 17, ["Tuat"] = 19, ["Hoi"] = 21
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadFreeUsageHint();
        LoadConsultationConfig();

        try
        {
            using var context = DbFactory.CreateDbContext();
            _recentPosts = await context.Posts
                .Where(p => p.Published)
                .OrderByDescending(p => p.DateUpdated)
                .Take(5)
                .ToListAsync();
        }
        catch
        {
            // Fail silent
        }

        try
        {
            _profiles = await TuViExcelService.GetProfilesFromExcelAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profiles from Excel: {ex.Message}");
        }
    }

    private void LoadConsultationConfig()
    {
        var section = Configuration.GetSection("Consultation");
        _facebookEnabled = bool.TryParse(section["FacebookEnabled"], out var fb) && fb;
        _facebookUrl = section["FacebookUrl"] ?? "";
        _zaloEnabled = bool.TryParse(section["ZaloEnabled"], out var zl) && zl;
        _zaloUrl = section["ZaloUrl"] ?? "";
    }

    private async Task LoadFreeUsageHint()
    {
        try
        {
            var anonId = await JS.InvokeAsync<string>("getOrCreateAnonId");
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            
            using var context = DbFactory.CreateDbContext();
            
            var dailyLimitSection = Configuration.GetSection("FreeUsageLimit");
            dailyFreeLimit = int.TryParse(dailyLimitSection["DailyLimit"], out var limit) ? limit : 5;
            
            var usageStats = await context.DailyUsageStats
                .FirstOrDefaultAsync(s => s.Date == today && s.AnonymousId == anonId);
            
            currentFreeUsage = usageStats?.FreeUsageCount ?? 0;
            
            freeUsageHint = "Xem miễn phí không giới hạn 100%";
        }
        catch
        {
            freeUsageHint = "Xem miễn phí không giới hạn 100%";
        }
    }

