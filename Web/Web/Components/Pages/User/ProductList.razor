@page "/san-pham"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Sản Phẩm | Lá Số Tử Vi</PageTitle>

<div class="max-w-6xl mx-auto w-full px-4 py-8">
    <div class="mb-8 text-left">
        <p class="text-[10px] font-bold text-amber-600 uppercase tracking-widest mb-1">Cửa hàng vật phẩm</p>
        <h1 class="text-3xl md:text-4xl font-bold font-serif text-stone-850">Sản Phẩm & Dịch Vụ Luận Giải</h1>
        <p class="text-slate-450 text-sm mt-1">Khám phá các sản phẩm và dịch vụ luận giải mệnh lý của chúng tôi.</p>
    </div>

    <div class="mb-8 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
        <div class="relative w-full sm:w-80 text-left">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-450 text-base">search</span>
            <input type="text"
                   class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white"
                   placeholder="Tìm kiếm sản phẩm..."
                   @bind="searchQuery"
                   @oninput="OnSearchChanged" />
        </div>
        <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end text-left">
            <label class="text-xs font-bold text-slate-400 uppercase tracking-widest whitespace-nowrap">Sắp xếp:</label>
            <select class="w-full sm:w-48 px-3 py-2.5 rounded-xl border border-slate-200 focus:border-amber-500 outline-none text-slate-700 font-semibold text-xs bg-slate-50/50 cursor-pointer transition-all"
                    @bind="sortOption"
                    @bind:after="OnSortChanged">
                <option value="Name">Tên</option>
                <option value="PriceAsc">Giá tăng dần</option>
                <option value="PriceDesc">Giá giảm dần</option>
                <option value="Discount">Giảm giá</option>
                <option value="Quantity">Số lượng</option>
            </select>
        </div>
    </div>

    @if (_products == null)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @for (int i = 0; i < 6; i++)
            {
                <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm flex flex-col gap-4 animate-pulse">
                    <div class="h-6 bg-slate-100 rounded-lg w-3/4"></div>
                    <div class="h-4 bg-slate-100 rounded-lg w-1/2 mt-2"></div>
                    <div class="h-20 bg-slate-100 rounded-lg w-full mt-4"></div>
                    <div class="h-10 bg-slate-100 rounded-lg w-full mt-auto"></div>
                </div>
            }
        </div>
    }
    else
    {
        if (!_filteredProducts.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 gap-3 text-slate-400 text-center">
                <span class="material-symbols-outlined text-5xl text-amber-600">storefront</span>
                <p class="text-lg font-bold font-serif text-stone-850">Chưa có sản phẩm</p>
                <p class="text-xs text-slate-450">Vui lòng quay lại sau nhé</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var product in _pagedProducts)
                {
                    if (!product.IsAvailable) continue;
                    <div class="bg-white border border-slate-100 rounded-3xl p-6 shadow-[0_4px_30px_rgba(0,0,0,0.02)] hover:shadow-[0_10px_30px_rgba(138,109,59,0.05)] hover:border-amber-200/50 transition-all flex flex-col duration-300 relative text-left">
                        <div class="flex-1">
                            <div class="flex justify-between items-start gap-2 mb-3">
                                <h2 class="font-serif text-lg font-bold text-stone-855 hover:text-amber-700 transition-colors line-clamp-2 leading-snug">@product.Name</h2>
                            </div>
                            
                            <div class="mb-4">
                                @if (product.Discount > 0)
                                {
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <del class="text-[11px] text-slate-400 font-semibold">@product.OriginPrice.ToString("N0")₫</del>
                                        <span class="text-[9px] bg-red-50 text-red-600 px-1.5 py-0.5 rounded font-bold border border-red-200/40">-@((int)product.Discount)%</span>
                                        <p class="text-xl font-bold text-amber-700">@product.Price.ToString("N0")₫</p>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xl font-bold text-amber-700">@product.Price.ToString("N0")₫</span>
                                }
                            </div>
                            
                            <div class="space-y-1.5 text-xs text-slate-450 font-medium py-3.5 border-y border-slate-50 mb-5">
                                @if (product.Quantity == -1)
                                {
                                    <p class="flex justify-between"><span>Còn lại:</span> <span class="font-bold text-stone-750">∞ (Không giới hạn)</span></p>
                                }
                                else
                                {
                                    <p class="flex justify-between"><span>Còn lại:</span> <span class="font-bold text-stone-750">@((product.Quantity - product.QuantitySold).ToString("N0"))</span></p>
                                }
                                <p class="flex justify-between"><span>Đã bán:</span> <span class="font-bold text-stone-750">@product.QuantitySold.ToString("N0")</span></p>
                                <p class="flex justify-between"><span>Số lượng vé luận giải:</span> <span class="font-bold text-amber-600">@product.NumberofTickets.ToString("N0") vé</span></p>
                            </div>
                        </div>
                        
                        <button class="w-full py-3 btn-gold text-xs font-bold rounded-xl transition-all cursor-pointer mt-auto"
                                @onclick="() => GoToCheckout(product.ProductId)">
                            Mua ngay
                        </button>
                    </div>
                }
            </div>
        }
    }

    <!-- Pagination -->
    @if (_totalPages > 1)
    {
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-between w-full gap-4 pt-6 border-t border-slate-100">
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400 font-semibold">Số dòng mỗi trang:</span>
                <input type="number"
                       class="w-14 px-2 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 text-center outline-none focus:border-amber-500 transition-all"
                       min="10" max="20"
                       @bind="_pageSize"
                       @bind:after="UpdatePagedProducts" />
            </div>
            <div class="flex items-center gap-1">
                <button class="px-3.5 h-9 rounded-lg flex items-center justify-center text-xs font-semibold border border-slate-200 text-stone-600 hover:bg-amber-50 hover:text-amber-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@(_currentPage == 1)"
                        @onclick="() => GoToPage(_currentPage - 1)">
                    Trước
                </button>
                @foreach (var item in GetVisiblePages())
                {
                    if (item is int pageNum)
                    {
                        <button class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold border transition-all cursor-pointer @(_currentPage == pageNum ? "bg-amber-500 text-white border-amber-500 hover:bg-amber-600" : "border-slate-200 text-stone-600 hover:bg-amber-50 hover:text-amber-700 hover:border-amber-200")"
                                @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                    else
                    {
                        <span class="px-1 text-slate-400 font-bold text-xs select-none">...</span>
                    }
                }
                <button class="px-3.5 h-9 rounded-lg flex items-center justify-center text-xs font-semibold border border-slate-200 text-stone-600 hover:bg-amber-50 hover:text-amber-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@(_currentPage == _totalPages)"
                        @onclick="() => GoToPage(_currentPage + 1)">
                    Sau
                </button>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400 font-semibold">Tới trang:</span>
                <input type="number"
                       class="w-14 px-2 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 text-center outline-none focus:border-amber-500 transition-all"
                       min="1" max="@_totalPages"
                       @bind="_jumpToPage"
                       @bind:after="JumpToPage" />
            </div>
        </div>
    }
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    private List<Product> _products;
    private List<Product> _filteredProducts;
    private List<Product> _pagedProducts;
    private string searchQuery = "";
    private string sortOption = "Name";
    private int _currentPage = 1;
    private int _pageSize = 12;
    private int _totalPages;
    private int _jumpToPage = 1;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _products = await context.Products
            .Where(p => p.Published)
            .OrderByDescending(p => p.DateUpdated)
            .ToListAsync();
        ApplyFilters();
    }

    private void OnSortChanged()
    {
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredProducts = string.IsNullOrEmpty(searchQuery)
            ? _products
            : _products.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

        _filteredProducts = sortOption switch
        {
            "Name" => _filteredProducts.OrderBy(p => p.Name).ToList(),
            "PriceAsc" => _filteredProducts.OrderBy(p => p.Price).ToList(),
            "PriceDesc" => _filteredProducts.OrderByDescending(p => p.Price).ToList(),
            "Discount" => _filteredProducts.OrderByDescending(p => p.Discount).ToList(),
            "Quantity" => _filteredProducts.OrderByDescending(p => p.Quantity).ToList(),
            _ => _filteredProducts
        };

        _currentPage = 1;
        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        if(_pageSize < 10)
        {
            _pageSize = 10;
            return;
        }
        if (_pageSize > 20)
        {
            _pageSize = 20;
            return;
        }
        _pagedProducts = _filteredProducts
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        _totalPages = (int)Math.Ceiling((double)_filteredProducts.Count / _pageSize);
        _jumpToPage = _currentPage;
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnPageSizeChanged()
    {
        _pageSize = Math.Clamp(_pageSize, 10, 20);
        UpdatePagedProducts();
    }

    private async Task GoToPage(int pageNum)
    {
        if (pageNum >= 1 && pageNum <= _totalPages)
        {
            _currentPage = pageNum;
            UpdatePagedProducts();
            await JS.InvokeVoidAsync("scrollTo", new
            {
                top = 0,
                left = 0,
                behavior = "smooth"
            });
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private IEnumerable<object> GetVisiblePages()
    {
        if (_totalPages <= 9)
        {
            for (int i = 1; i <= _totalPages; i++)
                yield return i;
            yield break;
        }

        int windowStart = Math.Max(1, _currentPage - 1);
        int windowEnd = Math.Min(_totalPages, windowStart + 2);
        if (windowEnd - windowStart < 2)
            windowStart = Math.Max(1, windowEnd - 2);

        bool showStartEllipsis = windowStart > 3;
        bool showEndEllipsis = windowEnd < _totalPages - 2;

        int firstEnd = Math.Min(3, _totalPages);
        for (int i = 1; i <= firstEnd; i++)
            yield return i;

        if (showStartEllipsis)
            yield return "...";

        for (int i = windowStart; i <= windowEnd; i++)
        {
            if (i > firstEnd && i < _totalPages - 2)
                yield return i;
        }

        if (showEndEllipsis)
            yield return "...";

        int lastStart = Math.Max(_totalPages - 2, firstEnd + 1);
        for (int i = lastStart; i <= _totalPages; i++)
            yield return i;
    }

    private void GoToCheckout(int productId)
    {
        Nav.NavigateTo($"/checkout?productId={productId}");
    }
}
