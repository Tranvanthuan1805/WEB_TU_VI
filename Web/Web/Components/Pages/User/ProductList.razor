@page "/san-pham"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Sản Phẩm | Lá Số Tử Vi</PageTitle>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-16">
    <div class="mb-8 md:mb-12">
        <h1 class="font-headline text-3xl sm:text-4xl md:text-5xl text-primary font-bold mb-4 italic">Sản Phẩm</h1>
        <p class="text-on-surface-variant font-body text-lg font-light">Khám phá các sản phẩm và dịch vụ luận giải của chúng tôi.</p>
    </div>

    <div class="mb-8 flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
        <div class="relative w-full sm:w-80">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant/75 text-lg">search</span>
            <input type="text"
                   class="ivory-input pl-10 py-2.5 shadow-sm text-sm"
                   placeholder="Tìm kiếm sản phẩm..."
                   @bind="searchQuery"
                   @oninput="OnSearchChanged" />
        </div>
        <div class="flex items-center gap-2.5 w-full sm:w-auto">
            <label class="text-sm font-bold text-on-surface-variant whitespace-nowrap">Sắp xếp:</label>
            <select class="ivory-input py-2 px-3 shadow-sm text-sm cursor-pointer"
                    @bind="sortOption"
                    @bind:after="OnSortChanged">
                <option value="Name">Tên</option>
                <option value="PriceAsc">Giá tăng dần</option>
                <option value="PriceDesc">Giá giảm dần</option>
                <option value="Discount">Giảm giá</option>
                <option value="Quantity">Số lượng</option>
            </select>
        </div>
    </div>

    @if (_products == null)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @for (int i = 0; i < 6; i++)
            {
                <div class="bg-white border border-outline-variant/40 rounded-2xl p-6 shadow-sm flex flex-col gap-4 animate-pulse">
                    <div class="h-6 bg-[--color-outline-variant]/30 rounded-lg w-3/4"></div>
                    <div class="h-4 bg-[--color-outline-variant]/30 rounded-lg w-1/2 mt-2"></div>
                    <div class="h-20 bg-[--color-outline-variant]/30 rounded-lg w-full mt-4"></div>
                    <div class="h-10 bg-[--color-outline-variant]/30 rounded-lg w-full mt-auto"></div>
                </div>
            }
        </div>
    }
    else
    {
        if (!_filteredProducts.Any())
        {
            <div class="flex flex-col items-center justify-center py-16 gap-3 text-[--color-on-surface-variant]">
                <span class="material-symbols-outlined text-5xl text-[--color-primary]">storefront</span>
                <p class="text-lg font-semibold font-[Noto_Serif]">Chưa có sản phẩm</p>
                <p class="text-sm">Quay lại sau nhé</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var product in _pagedProducts)
                {
                    if (!product.IsAvailable) continue;
                    <div class="bg-white border border-outline-variant/60 rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-primary/50 transition-all flex flex-col duration-300">
                        <h2 class="font-headline text-lg font-bold text-on-surface hover:text-primary transition-colors mb-3 italic line-clamp-2 leading-snug">@product.Name</h2>
                        
                        <div class="mb-3">
                            @if (product.Discount > 0)
                            {
                                <div class="flex items-baseline gap-2 flex-wrap">
                                    <del class="text-xs text-on-surface-variant/80 font-medium">@product.OriginPrice.ToString("N0")₫</del>
                                    <span class="text-[10px] bg-red-50 text-red-600 px-2 py-0.5 rounded-full font-bold border border-red-200/50">-@((int)product.Discount)%</span>
                                    <p class="text-xl font-bold text-primary">@product.Price.ToString("N0")₫</p>
                                </div>
                            }
                            else
                            {
                                <span class="text-xl font-bold text-primary">@product.Price.ToString("N0")₫</span>
                            }
                        </div>
                        
                        <div class="space-y-1.5 text-xs text-on-surface-variant font-medium py-3 border-y border-outline-variant/20 mb-5 mt-3">
                            @if (product.Quantity == -1)
                            {
                                <p class="flex justify-between"><span>Còn lại:</span> <span class="font-bold text-on-surface">∞ (Không giới hạn)</span></p>
                            }
                            else
                            {
                                <p class="flex justify-between"><span>Còn lại:</span> <span class="font-bold text-on-surface">@((product.Quantity - product.QuantitySold).ToString("N0"))</span></p>
                            }
                            <p class="flex justify-between"><span>Đã bán:</span> <span class="font-bold text-on-surface">@product.QuantitySold.ToString("N0")</span></p>
                            <p class="flex justify-between"><span>Số lượng vé luận giải:</span> <span class="font-bold text-primary">@product.NumberofTickets.ToString("N0") vé</span></p>
                        </div>
                        <button class="w-full py-2.5 btn-gold text-xs font-bold rounded-xl transition-all mt-auto cursor-pointer"
                                @onclick="() => GoToCheckout(product.ProductId)">
                            Mua ngay
                        </button>
                    </div>
                }
            </div>
        }
    }

    @if (_totalPages > 1)
    {
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 w-full overflow-auto">
            <div class="flex items-center gap-3 order-2 sm:order-1">
                <label class="text-xs text-on-surface-variant">Số dòng mỗi trang:</label>
                <input type="number"
                       class="w-16 bg-surface-container border border-outline-variant rounded px-2 py-1 text-sm text-on-surface text-center"
                       min="10" max="20"
                       @bind="_pageSize"
                       @bind:after="UpdatePagedProducts" />
            </div>
            <div class="flex items-center gap-2 order-1 sm:order-2">
                <button class="px-3 py-1 text-sm rounded border border-outline text-on-surface-variant hover:bg-surface-container-high disabled:opacity-50"
                        disabled="@(_currentPage == 1)"
                        @onclick="() => GoToPage(_currentPage - 1)">
                    Trước
                </button>
                @foreach (var item in GetVisiblePages())
                {
                    if (item is int pageNum)
                    {
                        <button class="px-3 py-1 text-sm rounded @(_currentPage == pageNum ? "bg-primary-container text-on-primary-container" : "border border-outline text-on-surface-variant hover:bg-surface-container-high")"
                                @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    else
                    {
                        <span class="px-1 text-on-surface-variant">...</span>
                    }
                }
                <button class="px-3 py-1 text-sm rounded border border-outline text-on-surface-variant hover:bg-surface-container-high disabled:opacity-50"
                        disabled="@(_currentPage == _totalPages)"
                        @onclick="() => GoToPage(_currentPage + 1)">
                    Sau
                </button>
            </div>
            <div class="flex items-center gap-2 order-3">
                <label class="text-xs text-on-surface-variant">Tới trang:</label>
                <input type="number"
                       class="w-16 bg-surface-container border border-outline-variant rounded px-2 py-1 text-sm text-on-surface text-center"
                       min="1" max="@_totalPages"
                       @bind="_jumpToPage"
                       @bind:after="JumpToPage" />
            </div>
        </div>
    }
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    private List<Product> _products;
    private List<Product> _filteredProducts;
    private List<Product> _pagedProducts;
    private string searchQuery = "";
    private string sortOption = "Name";
    private int _currentPage = 1;
    private int _pageSize = 12;
    private int _totalPages;
    private int _jumpToPage = 1;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _products = await context.Products
            .Where(p => p.Published)
            .OrderByDescending(p => p.DateUpdated)
            .ToListAsync();
        ApplyFilters();
    }

    private void OnSortChanged()
    {
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredProducts = string.IsNullOrEmpty(searchQuery)
            ? _products
            : _products.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

        _filteredProducts = sortOption switch
        {
            "Name" => _filteredProducts.OrderBy(p => p.Name).ToList(),
            "PriceAsc" => _filteredProducts.OrderBy(p => p.Price).ToList(),
            "PriceDesc" => _filteredProducts.OrderByDescending(p => p.Price).ToList(),
            "Discount" => _filteredProducts.OrderByDescending(p => p.Discount).ToList(),
            "Quantity" => _filteredProducts.OrderByDescending(p => p.Quantity).ToList(),
            _ => _filteredProducts
        };

        _currentPage = 1;
        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        if(_pageSize < 10)
        {
            _pageSize = 10;
            return;
        }
        if (_pageSize > 20)
        {
            _pageSize = 20;
            return;
        }
        _pagedProducts = _filteredProducts
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        _totalPages = (int)Math.Ceiling((double)_filteredProducts.Count / _pageSize);
        _jumpToPage = _currentPage;
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnPageSizeChanged()
    {
        _pageSize = Math.Clamp(_pageSize, 10, 20);
        UpdatePagedProducts();
    }

    private async Task GoToPage(int pageNum)
    {
        if (pageNum >= 1 && pageNum <= _totalPages)
        {
            _currentPage = pageNum;
            UpdatePagedProducts();
            await JS.InvokeVoidAsync("scrollTo", new
            {
                top = 0,
                left = 0,
                behavior = "smooth"
            });
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private IEnumerable<object> GetVisiblePages()
    {
        if (_totalPages <= 9)
        {
            for (int i = 1; i <= _totalPages; i++)
                yield return i;
            yield break;
        }

        int windowStart = Math.Max(1, _currentPage - 1);
        int windowEnd = Math.Min(_totalPages, windowStart + 2);
        if (windowEnd - windowStart < 2)
            windowStart = Math.Max(1, windowEnd - 2);

        bool showStartEllipsis = windowStart > 3;
        bool showEndEllipsis = windowEnd < _totalPages - 2;

        int firstEnd = Math.Min(3, _totalPages);
        for (int i = 1; i <= firstEnd; i++)
            yield return i;

        if (showStartEllipsis)
            yield return "...";

        for (int i = windowStart; i <= windowEnd; i++)
        {
            if (i > firstEnd && i < _totalPages - 2)
                yield return i;
        }

        if (showEndEllipsis)
            yield return "...";

        int lastStart = Math.Max(_totalPages - 2, firstEnd + 1);
        for (int i = lastStart; i <= _totalPages; i++)
            yield return i;
    }

    private void GoToCheckout(int productId)
    {
        Nav.NavigateTo($"/checkout?productId={productId}");
    }
}
