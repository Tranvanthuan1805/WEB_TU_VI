@page "/bai-viet"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IJSRuntime JS

<PageTitle>Bài Viết | Lá Số Tử Vi</PageTitle>

<div class="max-w-6xl mx-auto w-full px-4 py-8">
    <div class="mb-8 text-left">
        <p class="text-[10px] font-bold text-amber-600 uppercase tracking-widest mb-1">KIẾN THỨC MỆNH LÝ</p>
        <h1 class="text-3xl md:text-4xl font-bold font-serif text-stone-850">Bài Viết Mới Nhất</h1>
        <p class="text-slate-450 text-sm mt-1">Khám phá bí ẩn tử vi, can chi và cách cục thông qua các bài viết chuyên sâu.</p>
    </div>

    <div class="mb-8 flex justify-start">
        <div class="relative w-full max-w-md text-left">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-base">search</span>
            <input type="text"
                   class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-50 outline-none text-slate-700 font-semibold text-sm transition-all bg-slate-50/50 focus:bg-white"
                   placeholder="Tìm kiếm bài viết..."
                   @bind="searchQuery"
                   @oninput="OnSearchChanged" />
        </div>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        @if (_pagedPosts == null)
        {
            @for (int i = 0; i < 6; i++)
            {
                <div class="animate-pulse rounded-2xl bg-slate-100 border border-slate-200 h-64">
                </div>
            }
        }
        else
        {
            @foreach (var post in _pagedPosts)
            {
                <a href="@($"/bai-viet/{post.Slug}")" class="group bg-white border border-slate-100 rounded-3xl shadow-[0_4px_25px_rgba(0,0,0,0.02)] hover:shadow-[0_15px_40px_rgba(138,109,59,0.08)] hover:border-amber-200/50 hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col h-full text-left">
                    <!-- Image container -->
                    <div class="relative overflow-hidden aspect-[16/10] bg-slate-50 border-b border-slate-50">
                        @if (!string.IsNullOrEmpty(post.CoverImage))
                        {
                            <img src="@post.CoverImage" alt="@post.Title" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-amber-500/10 to-stone-500/5 flex items-center justify-center">
                                <span class="material-symbols-outlined text-amber-700/30 text-4xl">menu_book</span>
                            </div>
                        }
                        <div class="absolute top-4 left-4">
                            <span class="text-[10px] font-bold text-white bg-amber-800/90 backdrop-blur-md px-3 py-1 rounded-full uppercase tracking-widest shadow-sm">Cẩm nang</span>
                        </div>
                    </div>
                    
                    <!-- Content padding -->
                    <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                        <div class="space-y-2">
                            <h2 class="text-lg font-bold font-serif text-stone-850 line-clamp-2 group-hover:text-amber-700 transition-colors leading-snug">@post.Title</h2>
                            <p class="text-slate-450 text-xs line-clamp-3 leading-relaxed font-light">@((MarkupString)post.Description)</p>
                        </div>
                        <div class="flex items-center justify-between pt-4 border-t border-slate-50 text-[10px] text-slate-400 font-semibold">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">calendar_today</span>
                                @post.DateUpdated.ToString("dd/MM/yyyy")
                            </span>
                            <span class="text-amber-600 font-bold group-hover:translate-x-1 transition-transform flex items-center gap-0.5">ĐỌC THÊM <span>→</span></span>
                        </div>
                    </div>
                </a>
            }
            @if (!_pagedPosts.Any())
            {
                <div class="col-span-full flex flex-col items-center justify-center py-16 gap-3 text-slate-400 text-center">
                    <span class="material-symbols-outlined text-5xl">search</span>
                    <p class="text-lg font-bold font-serif text-stone-800">Không tìm thấy bài viết</p>
                    <p class="text-xs text-slate-450">Thử tìm kiếm với từ khóa khác</p>
                </div>
            }
        }
    </div>

    <!-- Pagination -->
    @if (_totalPages > 1)
    {
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-between w-full gap-4 pt-6 border-t border-slate-100">
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400 font-semibold">Số dòng mỗi trang:</span>
                <input type="number"
                       class="w-14 px-2 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 text-center outline-none focus:border-amber-500 transition-all"
                       min="10" max="20"
                       @bind="_pageSize"
                       @bind:after="UpdatePagedPosts" />
            </div>
            <div class="flex items-center gap-1">
                <button class="px-3.5 h-9 rounded-lg flex items-center justify-center text-xs font-semibold border border-slate-200 text-stone-600 hover:bg-amber-50 hover:text-amber-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@(_currentPage == 1)"
                        @onclick="() => GoToPage(_currentPage - 1)">
                    Trước
                </button>
                @foreach (var item in GetVisiblePages())
                {
                    if (item is int pageNum)
                    {
                        <button class="w-9 h-9 rounded-lg flex items-center justify-center text-xs font-semibold border transition-all cursor-pointer @(_currentPage == pageNum ? "bg-amber-500 text-white border-amber-500 hover:bg-amber-600" : "border-slate-200 text-stone-600 hover:bg-amber-50 hover:text-amber-700 hover:border-amber-200")"
                                @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                    else
                    {
                        <span class="px-1 text-slate-400 font-bold text-xs select-none">...</span>
                    }
                }
                <button class="px-3.5 h-9 rounded-lg flex items-center justify-center text-xs font-semibold border border-slate-200 text-stone-600 hover:bg-amber-50 hover:text-amber-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                        disabled="@(_currentPage == _totalPages)"
                        @onclick="() => GoToPage(_currentPage + 1)">
                    Sau
                </button>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400 font-semibold">Tới trang:</span>
                <input type="number"
                       class="w-14 px-2 py-1 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 text-center outline-none focus:border-amber-500 transition-all"
                       min="1" max="@_totalPages"
                       @bind="_jumpToPage"
                       @bind:after="JumpToPage" />
            </div>
        </div>
    }
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
</style>

@code {
    private List<Post> _posts;
    private List<Post> _filteredPosts;
    private List<Post> _pagedPosts;
    private string searchQuery = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages;
    private int _jumpToPage = 1;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _posts = await context.Posts
            .Where(p => p.Published)
            .OrderByDescending(p => p.DateUpdated)
            .ToListAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredPosts = string.IsNullOrEmpty(searchQuery)
            ? _posts
            : _posts.Where(p => p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        _currentPage = 1; 
        UpdatePagedPosts();
    }

    private void UpdatePagedPosts()
    {
        if(_pageSize < 10)
        {
            _pageSize = 10;
            return;
        }
        if (_pageSize > 20)
        {
            _pageSize = 20;
            return;
        }
        _pagedPosts = _filteredPosts
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        _totalPages = (int)Math.Ceiling((double)_filteredPosts.Count / _pageSize);
        _jumpToPage = _currentPage;
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnPageSizeChanged()
    {
        _pageSize = Math.Clamp(_pageSize, 10, 20);
        UpdatePagedPosts();
    }

    private async Task GoToPage(int pageNum)
    {
        if (pageNum >= 1 && pageNum <= _totalPages)
        {
            _currentPage = pageNum;
            UpdatePagedPosts();
            await JS.InvokeVoidAsync("scrollTo", new
            {
                top = 0,
                left = 0,
                behavior = "smooth"
            });
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private IEnumerable<object> GetVisiblePages()
    {
        if (_totalPages <= 9)
        {
            for (int i = 1; i <= _totalPages; i++)
                yield return i;
            yield break;
        }

        int windowStart = Math.Max(1, _currentPage - 1);
        int windowEnd = Math.Min(_totalPages, windowStart + 2);
        if (windowEnd - windowStart < 2)
            windowStart = Math.Max(1, windowEnd - 2);

        bool showStartEllipsis = windowStart > 3;
        bool showEndEllipsis = windowEnd < _totalPages - 2;

        int firstEnd = Math.Min(3, _totalPages);
        for (int i = 1; i <= firstEnd; i++)
            yield return i;

        if (showStartEllipsis)
            yield return "...";

        for (int i = windowStart; i <= windowEnd; i++)
        {
            if (i > firstEnd && i < _totalPages - 2)
                yield return i;
        }

        if (showEndEllipsis)
            yield return "...";

        int lastStart = Math.Max(_totalPages - 2, firstEnd + 1);
        for (int i = lastStart; i <= _totalPages; i++)
            yield return i;
    }
}
