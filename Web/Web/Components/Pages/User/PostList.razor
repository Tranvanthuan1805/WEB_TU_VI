@page "/bai-viet"
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject IJSRuntime JS

<PageTitle>Bài Viết | Lá Số Tử Vi</PageTitle>

<div class="max-w-4xl mx-auto px-8 py-16">
    <div class="mb-12">
        <h1 class="font-headline text-4xl md:text-5xl text-primary mb-4 italic">Bài Viết</h1>
        <p class="text-on-surface-variant font-body text-lg font-light">Khám phá kiến thức và chia sẻ kinh nghiệm.</p>
    </div>

    <div class="mb-8">
        <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input type="text"
                   class="w-full bg-surface-container border border-outline-variant rounded-lg pl-10 pr-4 py-3 text-on-surface placeholder-on-surface-variant focus:border-primary-container focus:ring-1 focus:ring-primary-container"
                   placeholder="Tìm kiếm bài viết..."
                   @bind="searchQuery"
                   @oninput="OnSearchChanged" />
        </div>
    </div>

    <div class="space-y-6">
        @if (_pagedPosts == null)
        {
            @for (int i = 0; i < 5; i++)
            {
                <div class="animate-pulse rounded-xl bg-[--color-outline-variant]/30 h-28">
                </div>
            }
        }
        else
        {
            @foreach (var post in _pagedPosts)
            {
                <NavLink href="@($"/bai-viet/{post.Slug}")" class="block group bg-surface-container border border-outline-variant/30 rounded-lg p-6 hover:border-primary-container/50 hover:bg-surface-container-high transition-all">
                    <h2 class="font-headline text-xl text-primary group-hover:text-primary-container transition-colors mb-2 italic">@post.Title</h2>
                    <p class="text-sm text-on-surface-variant italic mb-3">"@((MarkupString)post.Description)"</p>
                    <span class="text-xs text-outline">@post.DateUpdated.ToString("dd/MM/yyyy")</span>
                </NavLink>
            }
            @if (!_pagedPosts.Any())
            {
                <div class="flex flex-col items-center justify-center py-16 gap-3 text-[--color-on-surface-variant]">
                    <span class="material-symbols-outlined text-5xl">search</span>
                    <p class="text-lg font-semibold font-[Noto_Serif]">Không tìm thấy bài viết</p>
                    <p class="text-sm">Thử từ khóa khác</p>
                </div>
            }
        }

    </div>

    @if (_totalPages > 1)
    {
        <div class="mt-8 flex items-center justify-between w-full overflow-auto">
            <div class="flex items-center gap-3">
                <label class="text-xs text-on-surface-variant">Số dòng mỗi trang:</label>
                    <input type="number"
                           class="w-16 bg-surface-container border border-outline-variant rounded px-2 py-1 text-sm text-on-surface text-center"
                           min="10" max="20"
                           @bind="_pageSize"
                           @bind:after="UpdatePagedPosts" />
            </div>
            <div class="flex items-center gap-2">
                <button class="px-3 py-1 text-sm rounded border border-outline text-on-surface-variant hover:bg-surface-container-high disabled:opacity-50"
                        disabled="@(_currentPage == 1)"
                        @onclick="() => GoToPage(_currentPage - 1)">
                    Trước
                </button>
                @foreach (var item in GetVisiblePages())
                {
                    if (item is int pageNum)
                    {
                        <button class="px-3 py-1 text-sm rounded @(_currentPage == pageNum ? "bg-primary-container text-on-primary-container" : "border border-outline text-on-surface-variant hover:bg-surface-container-high")"
                                @onclick="() => GoToPage(pageNum)">@pageNum</button>
                    }
                    else
                    {
                        <span class="px-1 text-on-surface-variant">...</span>
                    }
                }
                <button class="px-3 py-1 text-sm rounded border border-outline text-on-surface-variant hover:bg-surface-container-high disabled:opacity-50"
                        disabled="@(_currentPage == _totalPages)"
                        @onclick="() => GoToPage(_currentPage + 1)">
                    Sau
                </button>
            </div>
            <div class="flex items-center gap-2">
                <label class="text-xs text-on-surface-variant">Tới trang:</label>
                <input type="number"
                       class="w-16 bg-surface-container border border-outline-variant rounded px-2 py-1 text-sm text-on-surface text-center"
                       min="1" max="@_totalPages"
                       @bind="_jumpToPage"
                       @bind:after="JumpToPage" />
            </div>
        </div>
    }
</div>

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
</style>

@code {
    private List<Post> _posts;
    private List<Post> _filteredPosts;
    private List<Post> _pagedPosts;
    private string searchQuery = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages;
    private int _jumpToPage = 1;

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        _posts = await context.Posts
            .Where(p => p.Published)
            .OrderByDescending(p => p.DateUpdated)
            .ToListAsync();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredPosts = string.IsNullOrEmpty(searchQuery)
            ? _posts
            : _posts.Where(p => p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        _currentPage = 1; 
        UpdatePagedPosts();
    }

    private void UpdatePagedPosts()
    {
        if(_pageSize < 10)
        {
            _pageSize = 10;
            return;
        }
        if (_pageSize > 20)
        {
            _pageSize = 20;
            return;
        }
        _pagedPosts = _filteredPosts
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        _totalPages = (int)Math.Ceiling((double)_filteredPosts.Count / _pageSize);
        _jumpToPage = _currentPage;
        StateHasChanged();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnPageSizeChanged()
    {
        _pageSize = Math.Clamp(_pageSize, 10, 20);
        UpdatePagedPosts();
    }

    private async Task GoToPage(int pageNum)
    {
        if (pageNum >= 1 && pageNum <= _totalPages)
        {
            _currentPage = pageNum;
            UpdatePagedPosts();
            await JS.InvokeVoidAsync("scrollTo", new
            {
                top = 0,
                left = 0,
                behavior = "smooth"
            });
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private IEnumerable<object> GetVisiblePages()
    {
        if (_totalPages <= 9)
        {
            for (int i = 1; i <= _totalPages; i++)
                yield return i;
            yield break;
        }

        int windowStart = Math.Max(1, _currentPage - 1);
        int windowEnd = Math.Min(_totalPages, windowStart + 2);
        if (windowEnd - windowStart < 2)
            windowStart = Math.Max(1, windowEnd - 2);

        bool showStartEllipsis = windowStart > 3;
        bool showEndEllipsis = windowEnd < _totalPages - 2;

        int firstEnd = Math.Min(3, _totalPages);
        for (int i = 1; i <= firstEnd; i++)
            yield return i;

        if (showStartEllipsis)
            yield return "...";

        for (int i = windowStart; i <= windowEnd; i++)
        {
            if (i > firstEnd && i < _totalPages - 2)
                yield return i;
        }

        if (showEndEllipsis)
            yield return "...";

        int lastStart = Math.Max(_totalPages - 2, firstEnd + 1);
        for (int i = lastStart; i <= _totalPages; i++)
            yield return i;
    }
}
