@page "/"
@rendermode InteractiveServer

<PageTitle>Tra Cứu Tử Vi</PageTitle>

<div class="tuvi-header">
    <div class="container">
        <h1 class="mb-0">Tra Cứu Lá Số Tử Vi</h1>
        <p class="mb-0 mt-2 opacity-75">Nhập thông tin ngày sinh để xem lá số của bạn</p>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <div class="tuvi-card p-4">
                <h5 class="tuvi-card-title mb-3">Nhập Thông Tin Sinh Nhật</h5>
                <EditForm Model="@birthInfo" OnValidSubmit="@HandleSubmit">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label tuvi-form-label">Ngày Sinh</label>
                            <InputDate @bind-Value="birthInfo.BirthDate" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label tuvi-form-label">Giờ Sinh</label>
                            <InputSelect @bind-Value="birthInfo.BirthHour" class="form-select">
                                <option value="">-- Chọn giờ sinh --</option>
                                <option value="1">1-3h</option>
                                <option value="2">3-5h</option>
                                <option value="3">5-7h</option>
                                <option value="4">7-9h</option>
                                <option value="5">9-11h</option>
                                <option value="6">11-13h</option>
                                <option value="7">13-15h</option>
                                <option value="8">15-17h</option>
                                <option value="9">17-19h</option>
                                <option value="10">19-21h</option>
                                <option value="11">21-23h</option>
                                <option value="12">23-1h</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label tuvi-form-label">Giới tính</label>
                            <InputSelect @bind-Value="birthInfo.Gender" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </InputSelect>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <h4 class="tuvi-card-title">Bài Viết Mới Nhất</h4>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var article in articles)
        {
            <div class="col-6 col-md-4">
                <div class="tuvi-card">
                    <img src="@article.ImageUrl" alt="@article.Title" class="tuvi-card-img" />
                    <div class="tuvi-card-body">
                        <h6 class="tuvi-card-title">@article.Title</h6>
                        <p class="text-muted small mb-2">@article.Description</p>
                        <span class="tuvi-badge">@article.Category</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="row mt-4">
        <div class="col-12 d-flex justify-content-center">
            <nav>
                <ul class="pagination">
                    <li class="page-item disabled">
                        <span class="page-link">Trước</span>
                    </li>
                    <li class="page-item active">
                        <span class="page-link" style="background-color: var(--tuvi-primary); border-color: var(--tuvi-primary);">1</span>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#" style="color: var(--tuvi-primary-dark);">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#" style="color: var(--tuvi-primary-dark);">3</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#" style="color: var(--tuvi-primary-dark);">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@code {
    private BirthInfo birthInfo = new();
    private List<Article> articles = new()
    {
        new Article { Title = "Tử Vi 2026 - Người Tuổi Tý", Description = "Khám phá vận mệnh năm 2026", ImageUrl = "https://placehold.co/400x300/FFB347/white?text=Tu+Vi+Ty", Category = "Tử Vi" },
        new Article { Title = "Tử Vi 2026 - Người Tuổi Sửu", Description = "Khám phá vận mệnh năm 2026", ImageUrl = "https://placehold.co/400x300/FFA500/white?text=Tu+Vi+Sau", Category = "Tử Vi" },
        new Article { Title = "Tử Vi 2026 - Người Tuổi Dần", Description = "Khám phá vận mệnh năm 2026", ImageUrl = "https://placehold.co/400x300/FFD700/333?text=Tu+Vi+Dan", Category = "Tử Vi" },
        new Article { Title = "Cung Mệnh Theo Ngày Sinh", Description = "Tính cung mệnh chính xác", ImageUrl = "https://placehold.co/400x300/FFB347/white?text=Cung+Menh", Category = "Cung Mệnh" },
        new Article { Title = "Sao Hạn Năm 2026", Description = "Các sao hạn cần lưu ý", ImageUrl = "https://placehold.co/400x300/FFA500/white?text=Sao+Han", Category = "Sao Hạn" },
        new Article { Title = "Vận Hạn 12 Con Giáp", Description = "Tổng quan vận hạn năm", ImageUrl = "https://placehold.co/400x300/FFD700/333?text=Van+Han", Category = "Vận Hạn" }
