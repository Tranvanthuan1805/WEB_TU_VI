@code {
    private string searchQuery = "";
    private string _statusFilter = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _jumpToPage = 1;
    private bool _showDetailModal = false;
    private Order? _selectedOrder;

    private int _pendingCount;
    private int _paidCount;
    private int _failedCount;
    private int _expiredCount;
    private int _totalCount;

    private string _sortField = nameof(Order.DateCreated);
    private bool _sortDescending = true;

    private List<Order> _allOrders;
    private List<Order> _filteredOrders;
    private List<Order> _pagedOrders;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        using var context = DbFactory.CreateDbContext();
        _allOrders = await context.Orders
            .Include(o => o.Product)
            .Include(o => o.Ticket)
            .OrderByDescending(o => o.DateCreated)
            .ToListAsync();
        ApplyFilters();
    }

    private void UpdateCounts()
    {
        _pendingCount = _allOrders.Count(o => o.Status == OrderStatus.PendingPayment);
        _paidCount = _allOrders.Count(o => o.Status == OrderStatus.Paid);
        _failedCount = _allOrders.Count(o => o.Status == OrderStatus.PaymentFailed);
        _expiredCount = _allOrders.Count(o => o.Status == OrderStatus.Expired);
        _totalCount = _allOrders.Count;
        _totalPages = (int)Math.Ceiling((double)_filteredOrders.Count / _pageSize);
        _totalFiltered = _filteredOrders.Count;
        startItem = _filteredOrders.Count == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
        endItem = Math.Min(_currentPage * _pageSize, _filteredOrders.Count);
        _jumpToPage = _currentPage;
    }

    private void ApplyFilters()
    {
        _filteredOrders = _allOrders.AsEnumerable()
            .Where(o =>
                (string.IsNullOrEmpty(searchQuery) 
                    || (o.TxnRef?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (o.Ticket?.Code?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (o.Product?.Name?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                    || o.DateUpdated.ToString("dd/MM/yyyy").Contains(searchQuery))
                && (string.IsNullOrWhiteSpace(_statusFilter)
                    || (_statusFilter == "pending" && o.Status == OrderStatus.PendingPayment)
                    || (_statusFilter == "paid" && o.Status == OrderStatus.Paid)
                    || (_statusFilter == "failed" && o.Status == OrderStatus.PaymentFailed)
                    || (_statusFilter == "expired" && o.Status == OrderStatus.Expired))
            )
            .ToList();

        _filteredOrders = _sortField switch
        {
            nameof(Order.TxnRef) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.TxnRef).ToList()
                : _filteredOrders.OrderBy(o => o.TxnRef).ToList(),
            nameof(Product.Name) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.Product?.Name ?? "").ToList()
                : _filteredOrders.OrderBy(o => o.Product?.Name ?? "").ToList(),
            nameof(Ticket.Code) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.Ticket?.Code ?? "").ToList()
                : _filteredOrders.OrderBy(o => o.Ticket?.Code ?? "").ToList(),
            nameof(Order.Quantity) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.Quantity).ToList()
                : _filteredOrders.OrderBy(o => o.Quantity).ToList(),
            nameof(Order.UnitPrice) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.UnitPrice).ToList()
                : _filteredOrders.OrderBy(o => o.UnitPrice).ToList(),
            nameof(Order.TotalAmount) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.TotalAmount).ToList()
                : _filteredOrders.OrderBy(o => o.TotalAmount).ToList(),
            nameof(Order.DateCreated) => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.DateCreated).ToList()
                : _filteredOrders.OrderBy(o => o.DateCreated).ToList(),
            _ => _sortDescending
                ? _filteredOrders.OrderByDescending(o => o.DateUpdated).ToList()
                : _filteredOrders.OrderBy(o => o.DateUpdated).ToList()
        };
        _currentPage = 1;
        UpdatePagedOrders();
    }

    private void UpdatePagedOrders()
    {
        if (_pageSize < 1)
        {
            _pageSize = 1;
            return;
        }

        _pagedOrders = _filteredOrders
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        UpdateCounts();
        StateHasChanged();
    }

    private int _totalPages;
    private int _totalFiltered;
    private int startItem;
    private int endItem;

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnFilterChanged()
    {
        ApplyFilters();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= _totalPages)
        {
            _currentPage = page;
            UpdatePagedOrders();
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private void ToggleSort(string field)
    {
        if (_sortField == field)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortField = field;
            _sortDescending = true;
        }
        ApplyFilters();
    }

    private string GetSortIcon(string field)
    {
        if (_sortField != field) return "";
        return _sortDescending ? " ↓" : " ↑";
    }

    private void ShowDetailModal(Order order)
    {
        _selectedOrder = order;
        _showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
        _selectedOrder = null;
    }

    private string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "pending",
        OrderStatus.Paid => "paid",
        OrderStatus.PaymentFailed => "failed",
        OrderStatus.Expired => "expired",
        _ => ""
    };

    private string GetStatusText(OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "Chờ thanh toán",
        OrderStatus.Paid => "Đã thanh toán",
        OrderStatus.PaymentFailed => "Thất bại",
        OrderStatus.Expired => "Hết hạn",
        _ => status.ToString()
    };

    private IEnumerable<object> GetVisiblePages()
    {
        if (_totalPages <= 9)
        {
            for (int i = 1; i <= _totalPages; i++)
                yield return i;
            yield break;
        }

        int windowStart = Math.Max(1, _currentPage - 1);
        int windowEnd = Math.Min(_totalPages, windowStart + 2);
        if (windowEnd - windowStart < 2)
            windowStart = Math.Max(1, windowEnd - 2);

        bool showStartEllipsis = windowStart > 3;
        bool showEndEllipsis = windowEnd < _totalPages - 2;

        int firstEnd = Math.Min(3, _totalPages);
        for (int i = 1; i <= firstEnd; i++)
            yield return i;

        if (showStartEllipsis)
            yield return "...";

        for (int i = windowStart; i <= windowEnd; i++)
        {
            if (i > firstEnd && i < _totalPages - 2)
                yield return i;
        }

        if (showEndEllipsis)
            yield return "...";

        int lastStart = Math.Max(_totalPages - 2, firstEnd + 1);
        for (int i = lastStart; i <= _totalPages; i++)
            yield return i;
    }
