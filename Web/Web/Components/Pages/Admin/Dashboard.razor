@page "/admin"
@attribute [StreamRendering]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Web.Data

@attribute [Authorize(Roles = RoleName.Administrator)]

<PageTitle>Dashboard - Precision Admin</PageTitle>

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h2>Workspace Overview</h2>
        <div class="dashboard-header-meta">
            <span>Analytics for March 2026</span>
            <span class="live-badge">Live Updates</span>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">group</span>
                <span class="stat-trend positive">+12%</span>
            </div>
            <p class="stat-label">Total Users</p>
            <h3 class="stat-value">@totalUsers.ToString("N0")</h3>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">article</span>
                <span class="stat-trend positive">+5.2%</span>
            </div>
            <p class="stat-label">Total Articles</p>
            <h3 class="stat-value">@totalArticles.ToString("N0")</h3>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">visibility</span>
                <span class="stat-trend negative">-1.4%</span>
            </div>
            <p class="stat-label">Monthly Views</p>
            <h3 class="stat-value">@monthlyViews</h3>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">bolt</span>
                <span class="stat-trend positive">+24%</span>
            </div>
            <p class="stat-label">Active Sessions</p>
            <h3 class="stat-value">@activeSessions.ToString("N0")</h3>
        </div>
    </div>

    <div class="dashboard-main-grid">
        <div class="chart-section">
            <div class="section-header">
                <div>
                    <h4>Traffic Analysis</h4>
                    <p>View frequency and engagement over last 30 days</p>
                </div>
                <div class="chart-toggle">
                    <button class="toggle-btn @(_chartMode == "views" ? "active" : "")" @onclick="SetChartModeViews">Views</button>
                    <button class="toggle-btn @(_chartMode == "users" ? "active" : "")" @onclick="SetChartModeUsers">Users</button>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="trafficChart"></canvas>
            </div>
            <div class="chart-labels">
                <span>Mar 1</span>
                <span>Mar 10</span>
                <span>Mar 20</span>
                <span>Mar 31</span>
            </div>
        </div>

        <div class="side-panel">
            <div class="notification-panel">
                <div class="notification-content">
                    <div class="notification-header">
                        <span class="material-symbols-outlined">info</span>
                        <h4>System Update</h4>
                    </div>
                    <p>Version 2.4 deployment scheduled for 02:00 AM UTC. Expect 15 mins of intermittent latency.</p>
                    <button class="dismiss-btn">Dismiss Alert</button>
                </div>
            </div>

            <div class="activity-panel">
                <div class="section-header">
                    <h4>Recent Activity</h4>
                    <span class="material-symbols-outlined">more_horiz</span>
                </div>
                <div class="activity-list">
                    <div class="activity-item">
                        <span class="activity-dot primary"></span>
                        <div class="activity-content">
                            <p>New user signup: <span class="highlight">Elena Vance</span></p>
                            <span class="activity-time">2 minutes ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-dot secondary"></span>
                        <div class="activity-content">
                            <p>Article <span class="highlight">"Design Systems"</span> approved</p>
                            <span class="activity-time">1 hour ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-dot tertiary"></span>
                        <div class="activity-content">
                            <p>Comment flagged for review by <span class="highlight">Bot_Filter</span></p>
                            <span class="activity-time">3 hours ago</span>
                        </div>
                    </div>
                    <div class="activity-item">
                        <span class="activity-dot primary"></span>
                        <div class="activity-content">
                            <p>New registration: <span class="highlight">Marcus Thorne</span></p>
                            <span class="activity-time">5 hours ago</span>
                        </div>
                    </div>
                </div>
                <button class="view-all-btn">View All History</button>
            </div>
        </div>
    </div>

    <div class="users-table-section">
        <div class="table-header">
            <h4>System Users</h4>
            <a href="/admin/users" class="manage-link">
                Manage Users
                <span class="material-symbols-outlined">arrow_forward</span>
            </a>
        </div>
        <table class="users-table">
            <thead>
                <tr>
                    <th>Member</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Activity</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>
                            <div class="user-cell">
                                <img src="@user.Avatar" alt="@user.Name" />
                                <div>
                                    <p class="user-name">@user.Name</p>
                                    <span class="user-email">@user.Email</span>
                                </div>
                            </div>
                        </td>
                        <td class="role-cell">@user.Role</td>
                        <td>
                            <span class="status-badge @user.Status.ToLower()">@user.Status</span>
                        </td>
                        <td class="activity-cell">@user.LastActivity</td>
                        <td class="actions-cell">
                            <button class="action-btn">
                                <span class="material-symbols-outlined">edit_square</span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int totalUsers = 42892;
    private int totalArticles = 1402;
    private string monthlyViews = "2.4M";
    private int activeSessions = 1894;
    private string _chartMode = "views";

    private List<UserItem> users = new()
    {
        new UserItem { Name = "Julian Vance", Email = "julian@precision.io", Role = "Editor", Status = "Active", LastActivity = "2m ago", Avatar = "https://lh3.googleusercontent.com/aida-public/AB6AXuBA8boL-xt4HD5f8PJzfCLydSenwvy0oRtY-aF4xMBJpRO6B5719Db39hRTRmcpN18yzM321d3RL7eHCK_B9n3r4ZlIZv-yPLTUXtOdRWokVTjcNMqbAPszn4hk3qZMjiFMFKh7CQcJxCzJQVr3VvnruzNe7sOMrWzt77DUcDyn92aAOxRFeWFsU8FtZUfbwUnO93YIqjnwfN_nh9z4FU6brjXOEUq0t-Lv1AH5hRH3UL6Xa6zE2OAIKBRtA6ZwNFrUebGVgdSmxFQQ" },
        new UserItem { Name = "Sarah Connor", Email = "sarah.c@workspace.com", Role = "Viewer", Status = "Idle", LastActivity = "15h ago", Avatar = "https://lh3.googleusercontent.com/aida-public/AB6AXuA489CqF_-BdO380Co-UcXO4c1TlEkxEm0VK5MdxS0YVypAc5m19HL32aqjACXG2R8SbiksOF8A2Pz9E9PAa_5QeptsPTBI9bQ4ESMpwSEF4L_vYeYriylSpzraUFCKyQWI3z3LPK7W46n0SVckcBHq_TjAxwCgwWHAb6suYMTLPg6YP1rEr9j9garuI66a0KjSK4cVvW-z3uOjx8HE42T7O0kM73a_2zRBiG_S5_EvPT-Ux90ThmNktqHMN2puQuntl0OGUYpi_NSE" }
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            InitializeChart();
        }
    }

    private void InitializeChart()
    {
        try
        {
            var chartData = _chartMode == "views" 
                ? new[] { 40, 55, 45, 70, 65, 85, 60, 40, 55, 95, 70, 50 }
                : new[] { 30, 40, 35, 50, 45, 60, 45, 35, 45, 70, 55, 40 };

            var label = _chartMode == "views" ? "Views" : "Users";
            var dataStr = string.Join(",", chartData);

            var script = $@"
                if (window.adminTrafficChart) {{
                    window.adminTrafficChart.destroy();
                }}
                var ctx = document.getElementById('trafficChart');
                if (ctx) {{
                    window.adminTrafficChart = new Chart(ctx, {{
                        type: 'bar',
                        data: {{
                            labels: ['Mar 1', 'Mar 3', 'Mar 5', 'Mar 7', 'Mar 9', 'Mar 11', 'Mar 13', 'Mar 15', 'Mar 17', 'Mar 19', 'Mar 21', 'Mar 23'],
                            datasets: [{{
                                label: '{label}',
                                data: [{dataStr}],
                                backgroundColor: '#1e3a8a',
                                borderRadius: 4,
                                borderSkipped: false,
                            }}]
                        }},
                        options: {{
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {{ legend: {{ display: false }} }},
                            scales: {{
                                y: {{ beginAtZero: true, grid: {{ color: 'rgba(197,197,211,0.1)' }} }},
                                x: {{ grid: {{ display: false }} }}
                            }}
                        }}
                    }});
                }}
            ";
        }
        catch
        {
        }
    }

    private void SetChartModeViews() => _chartMode = "views";
    private void SetChartModeUsers() => _chartMode = "users";

    private class UserItem
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string Status { get; set; } = "";
        public string LastActivity { get; set; } = "";
        public string Avatar { get; set; } = "";
    }
}