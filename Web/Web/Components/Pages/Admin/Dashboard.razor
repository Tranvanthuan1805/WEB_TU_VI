@page "/admin"
@attribute [StreamRendering]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Web.Data
@using System
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@attribute [Authorize(Roles = RoleName.Administrator)]
@implements IAsyncDisposable

<PageTitle>Dashboard - Precision Admin</PageTitle>

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h2>Workspace Overview</h2>
        <div class="dashboard-header-meta">
            <span>Last 30 days</span>
            <span class="live-badge">Live Updates</span>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">shopping_cart</span>
            </div>
            <p class="stat-label">Total Orders (30d)</p>
            <h3 class="stat-value">@totalOrders.ToString("N0")</h3>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">payments</span>
            </div>
            <p class="stat-label">Revenue (30d)</p>
            <h3 class="stat-value">@revenue.ToString("N0", new CultureInfo("vi-VN")) ₫</h3>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">contact_mail</span>
            </div>
            <p class="stat-label">Total Contacts (30d)</p>
            <h3 class="stat-value">@totalContacts.ToString("N0")</h3>
        </div>

        <div class="stat-card">
            <div class="stat-card-header">
                <span class="material-symbols-outlined stat-icon">mark_email_unread</span>
            </div>
            <p class="stat-label">New Contacts (24h)</p>
            <h3 class="stat-value">@newContacts.ToString("N0")</h3>
        </div>
    </div>

    <div class="dashboard-main-grid">
        <div class="chart-section">
            <div class="section-header">
                <div>
                    <h4>Orders & Revenue</h4>
                    <p>Daily orders and revenue over last 30 days</p>
                </div>
            </div>
            <div class="chart-container">
                @if (chartData.Any())
                {
                    <canvas id="trafficChart"></canvas>
                }
                else
                {
                    <div class="chart-empty">Không có dữ liệu</div>
                }
            </div>
        </div>

        <div class="side-panel">

            <div class="activity-panel">
                <div class="section-header">
                    <h4>Recent Contacts</h4>
                    
                </div>
                <div class="activity-list">
                    @foreach (var contact in recentContacts)
                    {
                        <div class="activity-item">
                            <span class="activity-dot @GetStatusDotClass(contact.Status)"></span>
                            <div class="activity-content">
                                <p>@contact.Type: <span class="highlight">@contact.Email</span></p>
                                <span class="activity-time">@contact.DateCreated.ToString("g")</span>
                            </div>
                        </div>
                    }
                </div>
                <a class="view-all-btn" href="/admin/contacts">View All Contacts</a>
            </div>
        </div>
    </div>

    <div class="users-table-section" data-theme="admin">
        <div class="table-header">
            <h4>Daily Usage Stats</h4>
        </div>
        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Anonymous ID</th>
                        <th>Free Usage</th>
                        <th>Premium Usage</th>
                        <th>Last Used</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_pagedUsageStats == null)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-8 text-on-surface-variant">
                                Đang tải...
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var stat in _pagedUsageStats)
                        {
                            <tr>
                                <td>
                                    <span class="date-text">@stat.Date.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    <span class="stat-id">@(string.IsNullOrEmpty(stat.AnonymousId) ? "-" : stat.AnonymousId)</span>
                                </td>
                                <td>
                                    <span class="stat-count">@stat.FreeUsageCount</span>
                                </td>
                                <td>
                                    <span class="stat-count premium">@stat.PremiumUsageCount</span>
                                </td>
                                <td>
                                    <span class="date-text">@stat.LastUsedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                            </tr>
                        }
                        if (!_pagedUsageStats.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-8 text-on-surface-variant">
                                    Không có dữ liệu.
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_totalPages > 1)
        {
            <div class="table-footer w-full overflow-auto">
                <div class="page-size-control">
                    <label class="text-xs text-on-surface-variant">Số dòng:</label>
                    <input type="number"
                           class="page-size-input"
                           min="1"
                           @bind="_pageSize"
                           @bind:after="UpdatePagedUsageStats" />
                </div>
                <span class="showing-text">Hiển thị @_startItem-@_endItem của @_totalFiltered</span>
                <div class="pagination">
                    <button class="page-btn" disabled="@(_currentPage == 1)" @onclick="() => GoToPage(_currentPage - 1)">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    @foreach (var item in GetVisiblePages())
                    {
                        if (item is int pageNum)
                        {
                            <button class="page-btn @(_currentPage == pageNum ? "active" : "")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        else
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }
                    <button class="page-btn" disabled="@(_currentPage == _totalPages)" @onclick="() => GoToPage(_currentPage + 1)">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
                <div class="page-jump">
                    <label class="text-xs text-on-surface-variant">Tới trang:</label>
                    <input type="number"
                           class="page-jump-input"
                           min="1" max="@_totalPages"
                           @bind="_jumpToPage"
                           @bind:after="JumpToPage" />
                </div>
            </div>
        }
    </div>

</div>

@code {
    private int totalOrders;
    private decimal revenue;
    private int uniqueUsers;
    private int totalContacts;
    private int newContacts;
    private string _chartMode = "orders";

    private List<DailyChartData> chartData = new();
    private List<Contact> recentContacts = new();
    private List<DailyUsageStats> dailyUsageStats = new();
    private List<DailyUsageStats> _pagedUsageStats = new();
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;
    private int _totalFiltered = 0;
    private int _startItem = 0;
    private int _endItem = 0;
    private int _jumpToPage = 1;
    private bool _chartInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartInitialized && chartData.Any())
        {
            _chartInitialized = true;
            await InitializeChart();
        }
    }

    private async Task LoadDataAsync()
    {
        using var context = DbFactory.CreateDbContext();

        var thirtyDaysAgo = DateTime.UtcNow.AddDays(-30);
        var twentyFourHoursAgo = DateTime.UtcNow.AddHours(-24);

        totalOrders = await context.Orders
            .Where(o => o.DateCreated >= thirtyDaysAgo)
            .CountAsync();

        revenue = await context.Orders
            .Where(o => o.Status == OrderStatus.Paid && o.DateCreated >= thirtyDaysAgo)
            .SumAsync(o => o.TotalAmount);

        uniqueUsers = await context.DailyUsageStats
            .Where(d => d.Date >= DateOnly.FromDateTime(thirtyDaysAgo))
            .Select(d => d.AnonymousId)
            .Distinct()
            .CountAsync();

        totalContacts = await context.Contacts
            .Where(c => c.DateCreated >= thirtyDaysAgo)
            .CountAsync();

        newContacts = await context.Contacts
            .Where(c => c.DateCreated >= twentyFourHoursAgo)
            .CountAsync();

        recentContacts = await context.Contacts
            .OrderByDescending(c => c.DateCreated)
            .Take(5)
            .ToListAsync();

        _totalFiltered = await context.DailyUsageStats.CountAsync();
        _totalPages = (int)Math.Ceiling((double)_totalFiltered / _pageSize);
        _totalPages = Math.Max(1, _totalPages);

        if (_currentPage > _totalPages) _currentPage = _totalPages;

        _pagedUsageStats = await context.DailyUsageStats
            .OrderByDescending(d => d.Date)
            .ThenByDescending(d => d.AnonymousId)
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToListAsync();

        _startItem = (_currentPage - 1) * _pageSize + 1;
        _endItem = _currentPage * _pageSize;
        if (_endItem > _totalFiltered) _endItem = _totalFiltered;
        _jumpToPage = _currentPage;

        var ordersByDate = await context.Orders
            .Where(o => o.DateCreated >= thirtyDaysAgo)
            .GroupBy(o => o.DateCreated.Date)
            .Select(g => new
            {
                Date = g.Key,
                Count = g.Count(),
                Revenue = g.Where(o => o.Status == OrderStatus.Paid).Sum(o => o.TotalAmount)
            })
            .OrderBy(x => x.Date)
            .ToListAsync();

        chartData = ordersByDate.Select(x => new DailyChartData
        {
            Date = x.Date.ToString("MMM dd"),
            Orders = x.Count,
            Revenue = x.Revenue
        }).ToList();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        await UpdatePagedUsageStats();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdatePagedUsageStats()
    {
        using var context = DbFactory.CreateDbContext();
        _totalFiltered = await context.DailyUsageStats.CountAsync();
        _totalPages = (int)Math.Ceiling((double)_totalFiltered / _pageSize);
        _totalPages = Math.Max(1, _totalPages);

        if (_currentPage > _totalPages) _currentPage = _totalPages;

        _pagedUsageStats = await context.DailyUsageStats
            .OrderByDescending(d => d.Date)
            .ThenByDescending(d => d.AnonymousId)
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToListAsync();

        _startItem = (_currentPage - 1) * _pageSize + 1;
        _endItem = _currentPage * _pageSize;
        if (_endItem > _totalFiltered) _endItem = _totalFiltered;
        _jumpToPage = _currentPage;
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1) _jumpToPage = 1;
        if (_jumpToPage > _totalPages) _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private IEnumerable<object> GetVisiblePages()
    {
        var pages = new List<object>();
        const int maxVisible = 5;
        var start = Math.Max(1, _currentPage - 2);
        var end = Math.Min(_totalPages, start + maxVisible - 1);
        start = Math.Max(1, end - maxVisible + 1);

        for (var i = start; i <= end; i++)
        {
            pages.Add(i);
        }

        if (start > 1)
        {
            pages.Insert(0, "...");
        }
        if (end < _totalPages)
        {
            pages.Add("...");
        }

        return pages;
    }

    private class DailyChartData
    {
        public string Date { get; set; } = "";
        public int Orders { get; set; }
        public decimal Revenue { get; set; }
    }

    private async Task InitializeChart()
    {
        if (!chartData.Any())
        {
            return;
        }

        try
        {
            var labels = chartData.Select(x => x.Date).ToArray();
            var ordersData = chartData.Select(x => x.Orders).ToArray();
            var revenueData = chartData.Select(x => (double)x.Revenue / 1000000).ToArray();

            await JSRuntime.InvokeVoidAsync("initDashboardChart", "trafficChart", labels, ordersData, revenueData);
        }
        catch
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _chartInitialized = false;
        try
        {
            JSRuntime.InvokeVoidAsync("destroyDashboardChart");
        }
        catch { }
        return ValueTask.CompletedTask;
    }

    private void SetChartModeOrders() => _chartMode = "orders";

    private string GetStatusDotClass(ContactStatus status) => status switch
    {
        ContactStatus.Moi => "new",
        ContactStatus.DaDoc => "read",
        ContactStatus.DaXuLy => "processed",
        ContactStatus.BoQua => "skipped",
        _ => "new"
    };

}