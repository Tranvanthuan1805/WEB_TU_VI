@page "/admin/contacts"
@rendermode InteractiveServer
@attribute [StreamRendering]

@attribute [Authorize(Roles = RoleName.Administrator)]
@using Web.Utilities
@inject ToastService ToastService
@inject ConfirmDialogService ConfirmDialogService
@inject IJSRuntime JS

<PageTitle>Quản lý liên hệ</PageTitle>

<div class="contact-manager" data-theme="admin">
    <div class="page-header">
        <div>
            <h2>Quản lý liên hệ</h2>
            <p>Xem và quản lý liên hệ từ người dùng.</p>
        </div>
    </div>

    <div class="stats-row">
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Mới</span>
                <span class="material-symbols-outlined stat-mini-icon">fiber_new</span>
            </div>
            <span class="stat-mini-value">@_moiCount</span>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Đã đọc</span>
                <span class="material-symbols-outlined stat-mini-icon">mark_email_read</span>
            </div>
            <span class="stat-mini-value">@_daDocCount</span>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Đã xử lý</span>
                <span class="material-symbols-outlined stat-mini-icon">check_circle</span>
            </div>
            <span class="stat-mini-value">@_daXuLyCount</span>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Bỏ qua</span>
                <span class="material-symbols-outlined stat-mini-icon warning">disabled_by_default</span>
            </div>
            <span class="stat-mini-value">@_boQuaCount</span>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Tổng số</span>
                <span class="material-symbols-outlined stat-mini-icon">contact_mail</span>
            </div>
            <span class="stat-mini-value">@_totalCount</span>
        </div>
    </div>

    <div class="table-container">
        <div class="table-controls">
            <div class="search-filter">
                <div class="search-input">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" placeholder="Tìm kiếm theo email, nội dung..." @bind="searchQuery" @oninput="OnSearchChanged" />
                </div>
                <div class="category-dropdown">
                    <select @bind="_statusFilter" @bind:after="OnFilterChanged">
                        <option value="">Tất cả</option>
                        <option value="moi">Mới</option>
                        <option value="dadoc">Đã đọc</option>
                        <option value="daxuly">Đã xử lý</option>
                        <option value="boqua">Bỏ qua</option>
                    </select>
                    <span class="material-symbols-outlined dropdown-icon">expand_more</span>
                </div>
            </div>
        </div>

        <div class="data-table-wrapper ">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="hidden md:table-cell">ID</th>
                        <th @onclick="() => ToggleSort(nameof(Contact.Type))" class="sortable">
                            Loại
                            @GetSortIcon(nameof(Contact.Type))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Contact.Email))" class="sortable">
                            Email
                            @GetSortIcon(nameof(Contact.Email))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Contact.Content))" class="sortable">
                            Nội dung
                            @GetSortIcon(nameof(Contact.Content))
                        </th>
                        <th>Trạng thái</th>
                        <th @onclick="() => ToggleSort(nameof(Contact.DateCreated))" class="sortable hidden md:table-cell">
                            Ngày tạo
                            @GetSortIcon(nameof(Contact.DateCreated))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Contact.DateUpdated))" class="sortable hidden md:table-cell">
                            Ngày cập nhật
                            @GetSortIcon(nameof(Contact.DateUpdated))
                        </th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
@if (_pagedContacts == null)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-8 text-on-surface-variant">
                                Đang tải...
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var contact in _pagedContacts)
                        {
                            <tr>
                                <td class="hidden md:table-cell">
                                    <span class="contact-id">@contact.ContactId</span>
                                </td>
                                <td>
                                    <span class="type-tag @GetTypeClass(contact.Type)">@GetTypeText(contact.Type)</span>
                                </td>
                                <td>
                                    <span class="email-text" title="@contact.Email">@AppUtilities.TruncateMiddle(contact.Email, 30)</span>
                                </td>
                                <td>
                                    <span class="content-text" title="@contact.Content">@AppUtilities.TruncateMiddle(contact.Content, 40)</span>
                                </td>
                                <td>
                                    <span class="status-tag @GetStatusClass(contact.Status)">@GetStatusText(contact.Status)</span>
                                </td>
                                <td class="hidden md:table-cell">
                                    <span class="date-text">@contact.DateCreated.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="hidden md:table-cell">
                                    <span class="date-text">@contact.DateUpdated.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <button class="row-action-btn" title="Xem chi tiết" @onclick="() => ShowDetailModal(contact)">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        if (!_pagedContacts.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-8 text-on-surface-variant">
                                    Không có liên hệ nào.
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_totalPages > 1)
        {
            <div class="table-footer w-full overflow-auto">
                <div class="page-size-control">
                    <label class="text-xs text-on-surface-variant">Số dòng:</label>
                    <input type="number"
                    class="page-size-input"
                    min="1"
                    @bind="_pageSize"
                    @bind:after="UpdatePagedContacts" />
                </div>
                <span class="showing-text">Hiển thị @startItem-@endItem của @_totalFiltered liên hệ</span>
                <div class="pagination">
                    <button class="page-btn" disabled="@(_currentPage == 1)" @onclick="() => GoToPage(_currentPage - 1)">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    @foreach (var item in GetVisiblePages())
                    {
                        if (item is int pageNum)
                        {
                            <button class="page-btn @(_currentPage == pageNum ? "active" : "")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        else
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }
                    <button class="page-btn" disabled="@(_currentPage == _totalPages)" @onclick="() => GoToPage(_currentPage + 1)">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
                <div class="page-jump">
                    <label class="text-xs text-on-surface-variant">Tới trang:</label>
                    <input type="number"
                    class="page-jump-input"
                    min="1" max="@_totalPages"
                    @bind="_jumpToPage"
                    @bind:after="JumpToPage" />
                </div>
            </div>
        }
    </div>
</div>

@if (_showDetailModal)
{
    <div class="editor-modal-overlay" @onclick="CloseDetailModal">
        <div class="editor-modal" @onclick:stopPropagation="true">
            <div class="editor-header">
                <h3>Chi tiết liên hệ</h3>
                <button class="close-btn" @onclick="CloseDetailModal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="editor-body">
                @if (_selectedContact != null)
                {
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">ID</span>
                            <span class="detail-value">@_selectedContact.ContactId</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Loại</span>
                            <span class="detail-value">
                                <span class="type-tag @GetTypeClass(_selectedContact.Type)">@GetTypeText(_selectedContact.Type)</span>
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Email</span>
                            <span class="detail-value">@_selectedContact.Email</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Nội dung</span>
                            <span class="detail-value content-full">@_selectedContact.Content</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Trạng thái</span>
                            <span class="detail-value">
                                <select class="status-select" @onchange="async (e) => await ChangeStatus(_selectedContact, e.Value?.ToString() ?? string.Empty)">
                                    <option value="Moi" selected="@(_selectedContact.Status == ContactStatus.Moi)">Mới</option>
                                    <option value="DaDoc" selected="@(_selectedContact.Status == ContactStatus.DaDoc)">Đã đọc</option>
                                    <option value="DaXuLy" selected="@(_selectedContact.Status == ContactStatus.DaXuLy)">Đã xử lý</option>
                                    <option value="BoQua" selected="@(_selectedContact.Status == ContactStatus.BoQua)">Bỏ qua</option>
                                </select>
                            </span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Ngày tạo</span>
                            <span class="detail-value">@_selectedContact.DateCreated.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Ngày cập nhật</span>
                            <span class="detail-value">@_selectedContact.DateUpdated.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                }
            </div>
            <div class="editor-footer">
                <button type="button" class="btn-secondary" @onclick="CloseDetailModal">Đóng</button>
            </div>
        </div>
    </div>
}

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
    }

    .contact-manager[data-theme="admin"] {
        --primary: #1E3A8A;
        --primary-container: #1E3A8A;
        --on-primary: #ffffff;
        --surface: #F8FAFC;
        --surface-container: #e2e8f0;
        --surface-container-low: #f1f5f9;
        --surface-container-high: #cbd5e1;
        --on-surface: #1e293b;
        --on-surface-variant: #475569;
        --outline: #64748B;
        --outline-variant: #cbd5e1;
        --error-container: #dc2626;
        --on-error-container: #ffffff;
        --secondary-container: #e2e8f0;
        --on-secondary-container: #475569;
        --tertiary-container: #6E2C00;
        --on-tertiary-container: #ffffff;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }

        .page-header h2 {
            color: var(--on-surface);
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0 0 0.25rem;
        }

        .page-header p {
            color: var(--on-surface-variant);
            font-size: 0.875rem;
            margin: 0;
        }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-mini {
        min-width: 0;
        background: var(--surface-container-low);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
    }

    .stat-mini-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .stat-mini-label {
        font-size: 0.75rem;
        color: var(--on-surface-variant);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-mini-icon {
        color: var(--primary);
        font-size: 1.25rem;
    }

        .stat-mini-icon.warning {
            color: #f59e0b;
        }

    .stat-mini-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .table-container {
        background: var(--surface-container-low);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .table-controls {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--outline-variant);
    }

    .search-filter {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .search-input {
        position: relative;
        flex: 1;
    }

        .search-input .material-symbols-outlined {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--on-surface-variant);
            font-size: 1.25rem;
        }

        .search-input input {
            width: 100%;
            padding: 0.5rem 0.75rem 0.5rem 2.5rem;
            border: 1px solid var(--outline-variant);
            border-radius: 0.5rem;
            background: var(--surface);
            color: var(--on-surface);
            font-size: 0.875rem;
        }

            .search-input input:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 2px rgba(30, 58, 138, 0.1);
            }

    .category-dropdown {
        position: relative;
        min-width: 180px;
    }

        .category-dropdown select {
            width: 100%;
            padding: 0.5rem 2rem 0.5rem 0.75rem;
            border: 1px solid var(--outline-variant);
            border-radius: 0.5rem;
            background: var(--surface);
            color: var(--on-surface);
            font-size: 0.875rem;
            appearance: none;
            cursor: pointer;
        }

    .dropdown-icon {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: var(--on-surface-variant);
    }

    .data-table-wrapper {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            padding: 0.75rem 1rem;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--on-surface-variant);
            background: var(--surface-container);
            border-bottom: 1px solid var(--outline-variant);
            white-space: nowrap;
        }

            .data-table th.sortable {
                cursor: pointer;
                user-select: none;
            }

                .data-table th.sortable:hover {
                    background: var(--surface-container-high);
                }

        .data-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--outline-variant);
            font-size: 0.875rem;
            color: var(--on-surface);
            white-space: nowrap;
        }

        .data-table tbody tr:hover {
            background: var(--surface-container);
        }

    .contact-id {
        font-weight: 500;
        color: var(--on-surface);
    }

    .type-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }

        .type-tag.feedback {
            background: #dbeafe;
            color: #1e40af;
        }

        .type-tag.bug {
            background: #fef2f2;
            color: #dc2626;
        }

    .email-text {
        color: var(--on-surface);
    }

    .content-text {
        color: var(--on-surface-variant);
        max-width: 200px;
    }

    .status-tag.new {
        background: #fef3c7;
        color: #92400e;
    }

    .status-tag.read {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-tag.processed {
        background: #dcfce7;
        color: #166534;
    }

    .status-tag.ignored {
        background: var(--secondary-container);
        color: var(--on-secondary-container);
    }

    .content-full {
        white-space: pre-wrap;
        word-break: break-word;
        max-width: 300px;
    }

    .status-select {
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface);
        font-size: 0.875rem;
    }

    .status-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }

        .status-tag.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-tag.paid {
            background: #dcfce7;
            color: #166534;
        }

        .status-tag.failed {
            background: #fef2f2;
            color: #dc2626;
        }

        .status-tag.expired {
            background: var(--secondary-container);
            color: var(--on-secondary-container);
        }

    .date-text {
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
    }

    .row-actions {
        display: flex;
        gap: 0.25rem;
        justify-content: flex-end;
    }

    .row-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: none;
        border-radius: 0.375rem;
        background: transparent;
        color: var(--on-surface-variant);
        cursor: pointer;
        transition: background 0.2s;
    }

        .row-action-btn:hover {
            background: var(--surface-container);
        }

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        background: var(--surface-container);
    }

    .showing-text {
        font-size: 0.8125rem;
        color: var(--on-surface-variant);
    }

    .pagination {
        display: flex;
        gap: 0.25rem;
    }

    .page-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .page-btn:hover:not(:disabled):not(.active) {
            background: var(--surface-container-high);
        }

        .page-btn.active {
            background: var(--primary);
            color: var(--on-primary);
            border-color: var(--primary);
        }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .page-ellipsis {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
    }

    .page-size-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-size-input {
        width: 3.5rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface);
        text-align: center;
        font-size: 0.8125rem;
    }

    .page-jump {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-jump-input {
        width: 3.5rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface);
        text-align: center;
        font-size: 0.8125rem;
    }

    .editor-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
    }

    .editor-modal {
        background: var(--surface-container-low);
        border-radius: 0.75rem;
        width: 90%;
        max-width: 600px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--outline-variant);
    }

        .editor-header h3 {
            margin: 0;
            color: var(--on-surface);
            font-size: 1.125rem;
        }

    .close-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: none;
        border-radius: 0.375rem;
        background: transparent;
        color: var(--on-surface-variant);
        cursor: pointer;
    }

        .close-btn:hover {
            background: var(--surface-container);
        }

    .editor-body {
        padding: 1.5rem;
        overflow-y: auto;
        flex: 1;
    }

    .detail-grid {
        display: grid;
        gap: 1rem;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--outline-variant);
    }

        .detail-item:last-child {
            border-bottom: none;
        }

    .detail-label {
        font-size: 0.875rem;
        color: var(--on-surface-variant);
        font-weight: 500;
    }

    .detail-value {
        font-size: 0.875rem;
        color: var(--on-surface);
        text-align: right;
    }

    .editor-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--outline-variant);
    }

    .btn-primary {
        padding: 0.5rem 1.5rem;
        background: var(--primary);
        color: var(--on-primary);
        border: none;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
    }

        .btn-primary:hover {
            opacity: 0.9;
        }

    .btn-secondary {
        padding: 0.5rem 1.5rem;
        background: transparent;
        color: var(--on-surface-variant);
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        cursor: pointer;
    }

        .btn-secondary:hover {
            background: var(--surface-container);
        }
</style>

@code {
    private string searchQuery = "";
    private string _statusFilter = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _jumpToPage = 1;
    private bool _showDetailModal = false;
    private Contact? _selectedContact;

    private int _moiCount;
    private int _daDocCount;
    private int _daXuLyCount;
    private int _boQuaCount;
    private int _totalCount;

    private string _sortField = nameof(Contact.DateCreated);
    private bool _sortDescending = true;

    private List<Contact> _allContacts;
    private List<Contact> _filteredContacts;
    private List<Contact> _pagedContacts;

    protected override async Task OnInitializedAsync()
    {
        await LoadContacts();
    }

    private async Task LoadContacts()
    {
        using var context = DbFactory.CreateDbContext();
        _allContacts = await context.Contacts
            .OrderByDescending(c => c.DateCreated)
            .ToListAsync();
        ApplyFilters();
    }

    private void UpdateCounts()
    {
        _moiCount = _allContacts.Count(c => c.Status == ContactStatus.Moi);
        _daDocCount = _allContacts.Count(c => c.Status == ContactStatus.DaDoc);
        _daXuLyCount = _allContacts.Count(c => c.Status == ContactStatus.DaXuLy);
        _boQuaCount = _allContacts.Count(c => c.Status == ContactStatus.BoQua);
        _totalCount = _allContacts.Count;
        _totalPages = (int)Math.Ceiling((double)_filteredContacts.Count / _pageSize);
        _totalFiltered = _filteredContacts.Count;
        startItem = _filteredContacts.Count == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
        endItem = Math.Min(_currentPage * _pageSize, _filteredContacts.Count);
        _jumpToPage = _currentPage;
    }

    private void ApplyFilters()
    {
        _filteredContacts = _allContacts.AsEnumerable()
            .Where(c =>
                (string.IsNullOrEmpty(searchQuery) 
                    || c.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                    || c.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                && (string.IsNullOrWhiteSpace(_statusFilter)
                    || (_statusFilter == "moi" && c.Status == ContactStatus.Moi)
                    || (_statusFilter == "dadoc" && c.Status == ContactStatus.DaDoc)
                    || (_statusFilter == "daxuly" && c.Status == ContactStatus.DaXuLy)
                    || (_statusFilter == "boqua" && c.Status == ContactStatus.BoQua))
            )
            .ToList();

        _filteredContacts = _sortField switch
        {
            nameof(Contact.Type) => _sortDescending
                ? _filteredContacts.OrderByDescending(c => c.Type).ToList()
                : _filteredContacts.OrderBy(c => c.Type).ToList(),
            nameof(Contact.Email) => _sortDescending
                ? _filteredContacts.OrderByDescending(c => c.Email).ToList()
                : _filteredContacts.OrderBy(c => c.Email).ToList(),
            nameof(Contact.Content) => _sortDescending
                ? _filteredContacts.OrderByDescending(c => c.Content).ToList()
                : _filteredContacts.OrderBy(c => c.Content).ToList(),
            nameof(Contact.DateCreated) => _sortDescending
                ? _filteredContacts.OrderByDescending(c => c.DateCreated).ToList()
                : _filteredContacts.OrderBy(c => c.DateCreated).ToList(),
            _ => _sortDescending
                ? _filteredContacts.OrderByDescending(c => c.DateUpdated).ToList()
                : _filteredContacts.OrderBy(c => c.DateUpdated).ToList()
        };
        _currentPage = 1;
        UpdatePagedContacts();
    }

    private void UpdatePagedContacts()
    {
        if (_pageSize < 1)
        {
            _pageSize = 1;
            return;
        }

        _pagedContacts = _filteredContacts
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        UpdateCounts();
        StateHasChanged();
    }

    private int _totalPages;
    private int _totalFiltered;
    private int startItem;
    private int endItem;

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnFilterChanged()
    {
        ApplyFilters();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= _totalPages)
        {
            _currentPage = page;
            UpdatePagedContacts();
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private void ToggleSort(string field)
    {
        if (_sortField == field)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortField = field;
            _sortDescending = true;
        }
        ApplyFilters();
    }

    private string GetSortIcon(string field)
    {
        if (_sortField != field) return "";
        return _sortDescending ? " ↓" : " ↑";
    }

    private void ShowDetailModal(Contact contact)
    {
        _selectedContact = contact;
        _showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        _showDetailModal = false;
        _selectedContact = null;
    }

    private async Task ChangeStatus(Contact contact, string statusStr)
    {
        try
        {
            var newStatus = statusStr switch
            {
                "Moi" => ContactStatus.Moi,
                "DaDoc" => ContactStatus.DaDoc,
                "DaXuLy" => ContactStatus.DaXuLy,
                "BoQua" => ContactStatus.BoQua,
                _ => contact.Status
            };

            if (contact.Status != newStatus)
            {
                using var context = DbFactory.CreateDbContext();
                var dbContact = await context.Contacts.FindAsync(contact.ContactId);
                if (dbContact != null)
                {
                    dbContact.Status = newStatus;
                    dbContact.DateUpdated = DateTime.UtcNow;
                    await context.SaveChangesAsync();
                    ToastService.ShowSuccess("Đã cập nhật trạng thái");
                    await LoadContacts();
                    if (_selectedContact != null)
                    {
                        _selectedContact = _allContacts.FirstOrDefault(c => c.ContactId == _selectedContact.ContactId);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi cập nhật trạng thái: " + ex.Message);
        }
    }

    private string GetStatusClass(ContactStatus status) => status switch
    {
        ContactStatus.Moi => "new",
        ContactStatus.DaDoc => "read",
        ContactStatus.DaXuLy => "processed",
        ContactStatus.BoQua => "ignored",
        _ => ""
    };

    private string GetStatusText(ContactStatus status) => status switch
    {
        ContactStatus.Moi => "Mới",
        ContactStatus.DaDoc => "Đã đọc",
        ContactStatus.DaXuLy => "Đã xử lý",
        ContactStatus.BoQua => "Bỏ qua",
        _ => status.ToString()
    };

    private string GetTypeClass(ContactType type) => type switch
    {
        ContactType.GopY => "feedback",
        ContactType.BaoLoi => "bug",
        _ => ""
    };

    private string GetTypeText(ContactType type) => type switch
    {
        ContactType.GopY => "Góp ý",
        ContactType.BaoLoi => "Báo lỗi",
        _ => type.ToString()
    };

    private IEnumerable<object> GetVisiblePages()
    {
        if (_totalPages <= 9)
        {
            for (int i = 1; i <= _totalPages; i++)
                yield return i;
            yield break;
        }

        int windowStart = Math.Max(1, _currentPage - 1);
        int windowEnd = Math.Min(_totalPages, windowStart + 2);
        if (windowEnd - windowStart < 2)
            windowStart = Math.Max(1, windowEnd - 2);

        bool showStartEllipsis = windowStart > 3;
        bool showEndEllipsis = windowEnd < _totalPages - 2;

        int firstEnd = Math.Min(3, _totalPages);
        for (int i = 1; i <= firstEnd; i++)
            yield return i;

        if (showStartEllipsis)
            yield return "...";

        for (int i = windowStart; i <= windowEnd; i++)
        {
            if (i > firstEnd && i < _totalPages - 2)
                yield return i;
        }

        if (showEndEllipsis)
            yield return "...";

        int lastStart = Math.Max(_totalPages - 2, firstEnd + 1);
        for (int i = lastStart; i <= _totalPages; i++)
            yield return i;
    }
}