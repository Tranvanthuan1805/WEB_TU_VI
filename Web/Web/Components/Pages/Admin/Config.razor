@page "/admin/config"
@rendermode InteractiveServer

@attribute [Authorize(Roles = RoleName.Administrator)]
@inject ToastService ToastService
@inject ConfirmDialogService ConfirmDialog
@inject IConfiguration Configuration
@inject IWebHostEnvironment Env
@using System.ComponentModel.DataAnnotations

<PageTitle>Thiết lập</PageTitle>

<div class="config-page">
    <div class="page-header">
        <h2>Thiết lập</h2>
        <p>Cấu hình thông số web.</p>
    </div>

    <div class="config-grid">
        <section class="config-card full-width">
            <div class="card-header">
                <span class="material-symbols-outlined">data_object</span>
                <h3>Seed Data</h3>
            </div>
            <div class="card-body">
                <p class="seed-description">Tạo hoặc xóa dữ liệu mẫu cho việc phát triển và kiểm tra. Dữ liệu seed có tiêu đề chứa "[Seed Data]".</p>
                <div class="seed-actions">
                    <button type="button" class="btn-seed-create" @onclick="CreateSeedData" disabled="@(_isCreatingSeed || _isDeletingSeed)">
                        <span class="material-symbols-outlined">add_circle</span>
                        @(_isCreatingSeed ? "Đang tạo..." : "Tạo Seed Data")
                    </button>
                    <button type="button" class="btn-seed-delete" @onclick="DeleteSeedData" disabled="@(_isCreatingSeed || _isDeletingSeed)">
                        <span class="material-symbols-outlined">delete_sweep</span>
                        @(_isDeletingSeed ? "Đang xóa..." : "Xóa Seed Data")
                    </button>
                </div>
            </div>
        </section>

        <section class="config-card full-width">
            <div class="card-header">
                <span class="material-symbols-outlined">payment</span>
                <h3>VNPay</h3>
            </div>
            <div class="card-body">
                <p class="seed-description">Cấu hình VNPay.Domain sẽ tự động thêm /vnpay-return và /payments/vnpay/ipn</p>
                <EditForm FormName="VnpayConfig" Model="_vnpayConfig" OnValidSubmit="SaveVnPayConfig">
                    <DataAnnotationsValidator />
                    <div class="vnpay-form">
                        <div class="form-group">
                            <label for="tmnCode">TmnCode</label>
                            <InputText id="tmnCode" class="form-control" @bind-Value="_vnpayConfig.TmnCode" />
                            <ValidationMessage For="() => _vnpayConfig.TmnCode" />
                        </div>
                        <div class="form-group">
                            <label for="hashSecret">HashSecret</label>
                            <InputText type="password" id="hashSecret" class="form-control" @bind-Value="_vnpayConfig.HashSecret" />
                            <ValidationMessage For="() => _vnpayConfig.HashSecret" />
                        </div>
                        <div class="form-group">
                            <label for="paymentUrl">PaymentUrl</label>
                            <InputText id="paymentUrl" class="form-control" @bind-Value="_vnpayConfig.PaymentUrl" />
                            <ValidationMessage For="() => _vnpayConfig.PaymentUrl" />
                        </div>
                        <div class="form-group">
                            <label for="domain">Domain</label>
                            <InputText id="domain" class="form-control" @bind-Value="_vnpayConfig.Domain" placeholder="https://example.com" />
                            <ValidationMessage For="() => _vnpayConfig.Domain" />
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-save" disabled="@(_isSaving || _isResetting)">
                                <span class="material-symbols-outlined">save</span>
                                @(_isSaving ? "Đang lưu..." : "Lưu")
                            </button>
                            <button type="button" class="btn-reset" @onclick="ResetVnPayConfig" disabled="@(_isSaving || _isResetting)">
                                <span class="material-symbols-outlined">refresh</span>
                                @(_isResetting ? "Đang reset..." : "Reset")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </section>

        <section class="config-card full-width">
            <div class="card-header">
                <span class="material-symbols-outlined">ads_click</span>
                <h3>Google AdSense</h3>
            </div>
            <div class="card-body">
                <p class="seed-description">Cấu hình Google AdSense Auto Ads. Script sẽ được chèn vào các trang public khi bật.</p>
                <EditForm FormName="GoogleAdSenseConfig" Model="_googleAdSenseConfig" OnValidSubmit="SaveGoogleAdSenseConfig">
                    <DataAnnotationsValidator />
                    <div class="vnpay-form">
                        <div class="form-group">
                            <label class="checkbox-label">
                                <InputCheckbox id="enabled" class="form-checkbox" @bind-Value="_googleAdSenseConfig.Enabled" />
                                <span>Bật AdSense</span>
                            </label>
                        </div>
                        <div class="form-group">
                            <label for="publisherId">Publisher ID</label>
                            <InputText id="publisherId" class="form-control" @bind-Value="_googleAdSenseConfig.PublisherId" 
                                       disabled="@(!_googleAdSenseConfig.Enabled)" placeholder="ca-pub-XXXXXXXXXXXXXXX" />
                            <ValidationMessage For="() => _googleAdSenseConfig.PublisherId" />
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-save" disabled="@(_isSavingGoogleAdSense || _isResettingGoogleAdSense)">
                                <span class="material-symbols-outlined">save</span>
                                @(_isSavingGoogleAdSense ? "Đang lưu..." : "Lưu")
                            </button>
                            <button type="button" class="btn-reset" @onclick="ResetGoogleAdSenseConfig" disabled="@(_isSavingGoogleAdSense || _isResettingGoogleAdSense)">
                                <span class="material-symbols-outlined">refresh</span>
                                @(_isResettingGoogleAdSense ? "Đang reset..." : "Reset")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </section>

        <section class="config-card full-width">
            <div class="card-header">
                <span class="material-symbols-outlined">history</span>
                <h3>Giới hạn sử dụng miễn phí</h3>
            </div>
            <div class="card-body">
                <p class="seed-description">Cấu hình số lần gọi lá số miễn phí mỗi ngày. Đặt -1 để không giới hạn.</p>
                <EditForm FormName="FreeUsageLimitConfig" Model="_freeUsageLimitConfig" OnValidSubmit="SaveFreeUsageLimitConfig">
                    <DataAnnotationsValidator />
                    <div class="vnpay-form">
                        <div class="form-group">
                            <label for="dailyLimit">Số lần miễn phí/ngày</label>
                            <InputNumber id="dailyLimit" class="form-control" @bind-Value="_freeUsageLimitConfig.DailyLimit" />
                            <ValidationMessage For="() => _freeUsageLimitConfig.DailyLimit" />
                            <small class="form-hint">Nhập -1 để không giới hạn</small>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-save" disabled="@(_isSavingFreeUsageLimit || _isResettingFreeUsageLimit)">
                                <span class="material-symbols-outlined">save</span>
                                @(_isSavingFreeUsageLimit ? "Đang lưu..." : "Lưu")
                            </button>
                            <button type="button" class="btn-reset" @onclick="ResetFreeUsageLimitConfig" disabled="@(_isSavingFreeUsageLimit || _isResettingFreeUsageLimit)">
                                <span class="material-symbols-outlined">refresh</span>
                                @(_isResettingFreeUsageLimit ? "Đang reset..." : "Reset")
                            </button>
                        </div>
                    </div>
                </EditForm>
                <div class="cleanup-section">
                    <button type="button" class="btn-cleanup" @onclick="CleanupOldUsageData" disabled="@_isCleaningUp">
                        <span class="material-symbols-outlined">delete_sweep</span>
                        @(_isCleaningUp ? "Đang xóa..." : "Xóa dữ liệu > 30 ngày")
                    </button>
                </div>
            </div>
        </section>

        <section class="config-card full-width">
            <div class="card-header">
                <span class="material-symbols-outlined">contact_phone</span>
                <h3>Liên hệ tư vấn</h3>
            </div>
            <div class="card-body">
                <p class="seed-description">Cấu hình hiển thị link Facebook và Zalo trong sidebar.</p>
                <EditForm FormName="ConsultationConfig" Model="_consultationConfig" OnValidSubmit="SaveConsultationConfig">
                    <DataAnnotationsValidator />
                    <div class="vnpay-form">
                        <div class="form-group">
                            <label class="checkbox-label">
                                <InputCheckbox id="facebookEnabled" class="form-checkbox" @bind-Value="_consultationConfig.FacebookEnabled" />
                                <span>Hiển thị link Facebook</span>
                            </label>
                        </div>
                        <div class="form-group">
                            <label for="facebookUrl">Link Facebook</label>
                            <InputText id="facebookUrl" class="form-control" @bind-Value="_consultationConfig.FacebookUrl" 
                                       disabled="@(!_consultationConfig.FacebookEnabled)" placeholder="https://facebook.com/yourpage" />
                            <ValidationMessage For="() => _consultationConfig.FacebookUrl" />
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <InputCheckbox id="zaloEnabled" class="form-checkbox" @bind-Value="_consultationConfig.ZaloEnabled" />
                                <span>Hiển thị link Zalo</span>
                            </label>
                        </div>
                        <div class="form-group">
                            <label for="zaloUrl">Link Zalo</label>
                            <InputText id="zaloUrl" class="form-control" @bind-Value="_consultationConfig.ZaloUrl" 
                                       disabled="@(!_consultationConfig.ZaloEnabled)" placeholder="https://zalo.me/yourid" />
                            <ValidationMessage For="() => _consultationConfig.ZaloUrl" />
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-save" disabled="@(_isSavingConsultation || _isResettingConsultation)">
                                <span class="material-symbols-outlined">save</span>
                                @(_isSavingConsultation ? "Đang lưu..." : "Lưu")
                            </button>
                            <button type="button" class="btn-reset" @onclick="ResetConsultationConfig" disabled="@(_isSavingConsultation || _isResettingConsultation)">
                                <span class="material-symbols-outlined">refresh</span>
                                @(_isResettingConsultation ? "Đang reset..." : "Reset")
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _isCreatingSeed;
    private bool _isDeletingSeed;
    private bool _isSaving;
    private bool _isResetting;
    [SupplyParameterFromForm(FormName = "VnpayConfig")]
    public VnPayConfigModel _vnpayConfig { get; set; } = new();
    [SupplyParameterFromForm(FormName = "GoogleAdSenseConfig")]
    public GoogleAdSenseConfigModel _googleAdSenseConfig { get; set; } = new();
    private bool _isSavingGoogleAdSense;
    private bool _isResettingGoogleAdSense;
    private bool _isSavingFreeUsageLimit;
    private bool _isResettingFreeUsageLimit;
    private bool _isCleaningUp;
    [SupplyParameterFromForm(FormName = "FreeUsageLimitConfig")]
    public FreeUsageLimitConfigModel _freeUsageLimitConfig { get; set; } = new();
    private bool _isSavingConsultation;
    private bool _isResettingConsultation;
    [SupplyParameterFromForm(FormName = "ConsultationConfig")]
    public ConsultationConfigModel _consultationConfig { get; set; } = new();

    protected override void OnInitialized()
    {
        LoadVnPayConfig();
        LoadGoogleAdSenseConfig();
        LoadFreeUsageLimitConfig();
        LoadConsultationConfig();
    }

    private void LoadVnPayConfig()
    {
        var vnpaySection = Configuration.GetSection("VnPay");
        var returnUrl = vnpaySection["ReturnUrl"] ?? "";

        _vnpayConfig = new VnPayConfigModel
        {
            TmnCode = vnpaySection["TmnCode"] ?? "",
            HashSecret = vnpaySection["HashSecret"] ?? "",
            PaymentUrl = vnpaySection["PaymentUrl"] ?? "",
            Domain = ExtractBaseDomain(returnUrl)
        };
    }

    private string ExtractBaseDomain(string url)
    {
        if (string.IsNullOrEmpty(url))
            return "";

        try
        {
            if (url.Contains("/vnpay-return"))
                url = url.Replace("/vnpay-return", "");
            else if (url.Contains("/payments/vnpay/ipn"))
                url = url.Replace("/payments/vnpay/ipn", "");

            var uri = new Uri(url);
            return $"{uri.Scheme}://{uri.Host}";
        }
        catch
        {
            return url;
        }
    }

    private async Task SaveVnPayConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Lưu cấu hình",
            "Bạn có chắc muốn lưu cấu hình VNPay?",
            "Lưu",
            false);

        if (!confirmed)
            return;

        _isSaving = true;
        try
        {
            var returnUrl = _vnpayConfig.Domain.TrimEnd('/') + "/vnpay-return";
            var ipnUrl = _vnpayConfig.Domain.TrimEnd('/') + "/payments/vnpay/ipn";

            var vnpayConfig = new Dictionary<string, object>
            {
                ["TmnCode"] = _vnpayConfig.TmnCode,
                ["HashSecret"] = _vnpayConfig.HashSecret,
                ["PaymentUrl"] = _vnpayConfig.PaymentUrl,
                ["ReturnUrl"] = returnUrl,
                ["IpnUrl"] = ipnUrl
            };          
            await MergeAndSaveVnPayConfig(vnpayConfig, isReset: false);
            ToastService.Show("success", "Đã lưu cấu hình VNPay");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi lưu: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ResetVnPayConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Khôi phục mặc định",
            "Bạn có chắc muốn khôi phục về giá trị mặc định từ appsettings?",
            "Khôi phục",
            true);

        if (!confirmed)
            return;

        _isResetting = true;
        try
        {
            var defaultVnPay = GetDefaultVnPayFromAppsettings();
            await MergeAndSaveVnPayConfig(defaultVnPay, isReset: true);
            LoadVnPayConfig();
            ToastService.Show("info", "Đã khôi phục về mặc định. Vui lòng F5.");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi khôi phục: {ex.Message}");
        }
        finally
        {
            _isResetting = false;
        }
    }

    private void LoadGoogleAdSenseConfig()
    {
        var googleAdSenseSection = Configuration.GetSection("GoogleAdSense");
        var enabled = googleAdSenseSection["Enabled"] ?? "";
        var publisherId = googleAdSenseSection["PublisherId"] ?? "";

        _googleAdSenseConfig = new GoogleAdSenseConfigModel
        {
            Enabled = bool.TryParse(enabled, out var isEnabled) && isEnabled,
            PublisherId = publisherId
        };
    }

    private async Task SaveGoogleAdSenseConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Lưu cấu hình",
            "Bạn có chắc muốn lưu cấu hình Google AdSense?",
            "Lưu",
            false);

        if (!confirmed)
            return;

        _isSavingGoogleAdSense = true;
        try
        {
            var googleAdSenseConfig = new Dictionary<string, object>
            {
                ["Enabled"] = _googleAdSenseConfig.Enabled.ToString().ToLower(),
                ["PublisherId"] = _googleAdSenseConfig.PublisherId
            };
            await MergeAndSaveGoogleAdSenseConfig(googleAdSenseConfig, isReset: false);
            ToastService.Show("success", "Đã lưu cấu hình Google AdSense");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi lưu: {ex.Message}");
        }
        finally
        {
            _isSavingGoogleAdSense = false;
        }
    }

    private async Task ResetGoogleAdSenseConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Khôi phục mặc định",
            "Bạn có chắc muốn khôi phục về giá trị mặc định từ appsettings?",
            "Khôi phục",
            true);

        if (!confirmed)
            return;

        _isResettingGoogleAdSense = true;
        try
        {
            var defaultGoogleAdSense = GetDefaultGoogleAdSenseFromAppsettings();
            await MergeAndSaveGoogleAdSenseConfig(defaultGoogleAdSense, isReset: true);
            LoadGoogleAdSenseConfig();
            ToastService.Show("info", "Đã khôi phục về mặc định. Vui lòng F5.");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi khôi phục: {ex.Message}");
        }
        finally
        {
            _isResettingGoogleAdSense = false;
        }
    }

    private Dictionary<string, object>? GetDefaultGoogleAdSenseFromAppsettings()
    {
        try
        {
            var appsettingsPath = Path.Combine(Env.ContentRootPath, "appsettings.json");
            var json = File.ReadAllText(appsettingsPath);
            var config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
            if (config != null && config.TryGetValue("GoogleAdSense", out var googleAdSense))
            {
                return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(
                    googleAdSense.ToString() ?? "") ?? new();
            }
        }
        catch { }
        return new();
    }

    private async Task MergeAndSaveGoogleAdSenseConfig(Dictionary<string, object> googleAdSenseConfig, bool isReset)
    {
        var existingConfig = GetExistingConfigJson() ?? new();
        var newConfig = new Dictionary<string, object>(existingConfig)
        {
            ["GoogleAdSense"] = googleAdSenseConfig
        };

        var configPath = Path.Combine(Env.ContentRootPath, "config.json");
        var json = System.Text.Json.JsonSerializer.Serialize(newConfig, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        await File.WriteAllTextAsync(configPath, json);
    }

    private async Task CreateSeedData()
    {
        _isCreatingSeed = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            
            var postCount = await Seeder.SeedPostsAsync(context);
            var productCount = await Seeder.SeedProductsAsync(context);
            var ticketCount = await Seeder.SeedTicketsAsync(context);
            
            ToastService.Show("success", $"Đã tạo seed: {postCount} posts, {productCount} products, {ticketCount} tickets");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi tạo seed: {ex.Message}");
        }
        finally
        {
            _isCreatingSeed = false;
        }
    }

    private async Task DeleteSeedData()
    {
        _isDeletingSeed = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            
            var postCount = await Seeder.DeleteSeedPostsAsync(context);
            var (productDeleted, productSkipped) = await Seeder.DeleteSeedProductsAsync(context);
            var (ticketDeleted, ticketSkipped) = await Seeder.DeleteSeedTicketsAsync(context);
            
            var total = postCount + productDeleted + ticketDeleted;
            if (total > 0)
            {
                var skipMsg = (productSkipped + ticketSkipped) > 0 
                    ? $" ({productSkipped} products, {ticketSkipped} tickets bị skip do có đơn hàng)"
                    : "";
                ToastService.Show("success", $"Đã xóa seed: {postCount} posts, {productDeleted} products, {ticketDeleted} tickets{skipMsg}");
            }
            else
                ToastService.Show("info", "Không có dữ liệu seed để xóa");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi xóa seed: {ex.Message}");
        }
        finally
        {
            _isDeletingSeed = false;
        }
    }

    public class VnPayConfigModel
    {
        [Required(ErrorMessage = "TmnCode là bắt buộc")]
        public string TmnCode { get; set; } = "";

        [Required(ErrorMessage = "HashSecret là bắt buộc")]
        public string HashSecret { get; set; } = "";

        [Required(ErrorMessage = "PaymentUrl là bắt buộc")]
        [Url(ErrorMessage = "PaymentUrl không hợp lệ")]
        public string PaymentUrl { get; set; } = "";

        [Required(ErrorMessage = "Domain là bắt buộc")]
        [Url(ErrorMessage = "Domain không hợp lệ")]
        public string Domain { get; set; } = "";
    }

    public class GoogleAdSenseConfigModel
    {
        public bool Enabled { get; set; }

        [Required(ErrorMessage = "Publisher ID là bắt buộc")]
        [RegularExpression(@"^ca-pub-\d{16}$", ErrorMessage = "Publisher ID phải có dạng ca-pub-XXXXXXXXXXXXXXX")]
        public string PublisherId { get; set; } = "";
    }

    private Dictionary<string, object>? GetDefaultVnPayFromAppsettings()
    {
        try
        {
            var appsettingsPath = Path.Combine(Env.ContentRootPath, "appsettings.json");
            var json = File.ReadAllText(appsettingsPath);
            var config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
            if (config != null && config.TryGetValue("VnPay", out var vnpay))
            {
                return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(
                    vnpay.ToString() ?? "") ?? new();
            }
        }
        catch { }
        return new();
    }

    private Dictionary<string, object>? GetExistingConfigJson()
    {
        try
        {
            var configPath = Path.Combine(Env.ContentRootPath, "config.json");
            if (!File.Exists(configPath))
                return null;

            var json = File.ReadAllText(configPath);
            return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
        }
        catch { }
        return null;
    }

    private async Task MergeAndSaveVnPayConfig(Dictionary<string, object> vnpayConfig, bool isReset)
    {
        var existingConfig = GetExistingConfigJson() ?? new();
        var newConfig = new Dictionary<string, object>(existingConfig)
        {
            ["VnPay"] = vnpayConfig
        };

        var configPath = Path.Combine(Env.ContentRootPath, "config.json");
        var json = System.Text.Json.JsonSerializer.Serialize(newConfig, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        await File.WriteAllTextAsync(configPath, json);
    }

    private void LoadFreeUsageLimitConfig()
    {
        var freeUsageSection = Configuration.GetSection("FreeUsageLimit");
        var dailyLimit = freeUsageSection["DailyLimit"] ?? "";

        _freeUsageLimitConfig = new FreeUsageLimitConfigModel
        {
            DailyLimit = int.TryParse(dailyLimit, out var limit) ? limit : 5
        };
    }

    private async Task SaveFreeUsageLimitConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Lưu cấu hình",
            "Bạn có chắc muốn lưu cấu hình giới hạn sử dụng miễn phí?",
            "Lưu",
            false);

        if (!confirmed)
            return;

        _isSavingFreeUsageLimit = true;
        try
        {
            var freeUsageConfig = new Dictionary<string, object>
            {
                ["DailyLimit"] = _freeUsageLimitConfig.DailyLimit.ToString()
            };
            await MergeAndSaveFreeUsageLimitConfig(freeUsageConfig, isReset: false);
            ToastService.Show("success", "Đã lưu cấu hình giới hạn sử dụng miễn phí");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi lưu: {ex.Message}");
        }
        finally
        {
            _isSavingFreeUsageLimit = false;
        }
    }

    private async Task ResetFreeUsageLimitConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Khôi phục mặc định",
            "Bạn có chắc muốn khôi phục về giá trị mặc định từ appsettings?",
            "Khôi phục",
            true);

        if (!confirmed)
            return;

        _isResettingFreeUsageLimit = true;
        try
        {
            var defaultFreeUsage = GetDefaultFreeUsageLimitFromAppsettings();
            await MergeAndSaveFreeUsageLimitConfig(defaultFreeUsage, isReset: true);
            LoadFreeUsageLimitConfig();
            ToastService.Show("info", "Đã khôi phục về mặc định. Vui lòng F5.");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi khôi phục: {ex.Message}");
        }
        finally
        {
            _isResettingFreeUsageLimit = false;
        }
    }

    private Dictionary<string, object>? GetDefaultFreeUsageLimitFromAppsettings()
    {
        try
        {
            var appsettingsPath = Path.Combine(Env.ContentRootPath, "appsettings.json");
            var json = File.ReadAllText(appsettingsPath);
            var config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
            if (config != null && config.TryGetValue("FreeUsageLimit", out var freeUsage))
            {
                return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(
                    freeUsage.ToString() ?? "") ?? new();
            }
        }
        catch { }
        return new();
    }

    private async Task MergeAndSaveFreeUsageLimitConfig(Dictionary<string, object> freeUsageConfig, bool isReset)
    {
        var existingConfig = GetExistingConfigJson() ?? new();
        var newConfig = new Dictionary<string, object>(existingConfig)
        {
            ["FreeUsageLimit"] = freeUsageConfig
        };

        var configPath = Path.Combine(Env.ContentRootPath, "config.json");
        var json = System.Text.Json.JsonSerializer.Serialize(newConfig, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        await File.WriteAllTextAsync(configPath, json);
    }

    private async Task CleanupOldUsageData()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Xóa dữ liệu cũ",
            "Bạn có chắc muốn xóa dữ liệu sử dụng > 30 ngày?",
            "Xóa",
            true);

        if (!confirmed)
            return;

        _isCleaningUp = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            var cutoffDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(-30));
            var oldRecords = await context.DailyUsageStats
                .Where(s => s.Date < cutoffDate)
                .ToListAsync();
            
            context.DailyUsageStats.RemoveRange(oldRecords);
            var deletedCount = await context.SaveChangesAsync();
            
            ToastService.Show("success", $"Đã xóa {deletedCount} bản ghi dữ liệu cũ");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi xóa: {ex.Message}");
        }
        finally
        {
            _isCleaningUp = false;
        }
    }

    public class FreeUsageLimitConfigModel
    {
        [Required(ErrorMessage = "DailyLimit là bắt buộc")]
        public int DailyLimit { get; set; } = 5;
    }

    private void LoadConsultationConfig()
    {
        var section = Configuration.GetSection("Consultation");
        _consultationConfig = new ConsultationConfigModel
        {
            FacebookEnabled = bool.TryParse(section["FacebookEnabled"], out var fb) && fb,
            FacebookUrl = section["FacebookUrl"] ?? "",
            ZaloEnabled = bool.TryParse(section["ZaloEnabled"], out var zl) && zl,
            ZaloUrl = section["ZaloUrl"] ?? ""
        };
    }

    private async Task SaveConsultationConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Lưu cấu hình",
            "Bạn có chắc muốn lưu cấu hình liên hệ tư vấn?",
            "Lưu",
            false);

        if (!confirmed)
            return;

        _isSavingConsultation = true;
        try
        {
            var consultationConfig = new Dictionary<string, object>
            {
                ["FacebookEnabled"] = _consultationConfig.FacebookEnabled.ToString().ToLower(),
                ["FacebookUrl"] = _consultationConfig.FacebookUrl,
                ["ZaloEnabled"] = _consultationConfig.ZaloEnabled.ToString().ToLower(),
                ["ZaloUrl"] = _consultationConfig.ZaloUrl
            };
            await MergeAndSaveConsultationConfig(consultationConfig);
            ToastService.Show("success", "Đã lưu cấu hình liên hệ tư vấn");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi lưu: {ex.Message}");
        }
        finally
        {
            _isSavingConsultation = false;
        }
    }

    private async Task ResetConsultationConfig()
    {
        var confirmed = await ConfirmDialog.ShowAsync(
            "Khôi phục mặc định",
            "Bạn có chắc muốn khôi phục về giá trị mặc định từ appsettings?",
            "Khôi phục",
            true);

        if (!confirmed)
            return;

        _isResettingConsultation = true;
        try
        {
            var defaultConfig = GetDefaultConsultationFromAppsettings();
            await MergeAndSaveConsultationConfig(defaultConfig);
            LoadConsultationConfig();
            ToastService.Show("info", "Đã khôi phục về mặc định. Vui lòng F5.");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi khôi phục: {ex.Message}");
        }
        finally
        {
            _isResettingConsultation = false;
        }
    }

    private Dictionary<string, object>? GetDefaultConsultationFromAppsettings()
    {
        try
        {
            var appsettingsPath = Path.Combine(Env.ContentRootPath, "appsettings.json");
            var json = File.ReadAllText(appsettingsPath);
            var config = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(json);
            if (config != null && config.TryGetValue("Consultation", out var consultation))
            {
                return System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(
                    consultation.ToString() ?? "") ?? new();
            }
        }
        catch { }
        return new();
    }

    private async Task MergeAndSaveConsultationConfig(Dictionary<string, object> consultationConfig)
    {
        var existingConfig = GetExistingConfigJson() ?? new();
        var newConfig = new Dictionary<string, object>(existingConfig)
        {
            ["Consultation"] = consultationConfig
        };

        var configPath = Path.Combine(Env.ContentRootPath, "config.json");
        var json = System.Text.Json.JsonSerializer.Serialize(newConfig, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        await File.WriteAllTextAsync(configPath, json);
    }

    public class ConsultationConfigModel
    {
        public bool FacebookEnabled { get; set; }
        public string FacebookUrl { get; set; } = "";
        public bool ZaloEnabled { get; set; }
        public string ZaloUrl { get; set; } = "";
    }
