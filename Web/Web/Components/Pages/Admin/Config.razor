@page "/admin/config"
@rendermode InteractiveServer

@attribute [Authorize(Roles = RoleName.Administrator)]
@inject ToastService ToastService

<PageTitle>Thiết lập</PageTitle>

<div class="config-page">
    <div class="page-header">
        <h2>Thiết lập</h2>
        <p>Cấu hình thông số web.</p>
    </div>

    <div class="config-grid">
        <section class="config-card full-width">
            <div class="card-header">
                <span class="material-symbols-outlined">data_object</span>
                <h3>Seed Data</h3>
            </div>
            <div class="card-body">
                <p class="seed-description">Tạo hoặc xóa dữ liệu mẫu cho việc phát triển và kiểm tra. Dữ liệu seed có tiêu đề chứa "[Seed Data]".</p>
                <div class="seed-actions">
                    <button type="button" class="btn-seed-create" @onclick="CreateSeedData" disabled="@_isSeeding">
                        <span class="material-symbols-outlined">add_circle</span>
                        @(_isSeeding ? "Đang tạo..." : "Tạo Seed Data")
                    </button>
                    <button type="button" class="btn-seed-delete" @onclick="DeleteSeedData" disabled="@_isSeeding">
                        <span class="material-symbols-outlined">delete_sweep</span>
                        @(_isSeeding ? "Đang xóa..." : "Xóa Seed Data")
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private bool _isSeeding;

    private async Task CreateSeedData()
    {
        _isSeeding = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            var count = await PostSeeder.SeedPostsAsync(context);
            ToastService.Show("success", $"Đã tạo {count} bài viết seed");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi tạo seed: {ex.Message}");
        }
        finally
        {
            _isSeeding = false;
        }
    }

    private async Task DeleteSeedData()
    {
        _isSeeding = true;
        try
        {
            using var context = DbFactory.CreateDbContext();
            var count = await PostSeeder.DeleteSeedPostsAsync(context);
            if (count > 0)
                ToastService.Show("success", $"Đã xóa {count} bài viết seed");
            else
                ToastService.Show("info", "Không có dữ liệu seed để xóa");
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi khi xóa seed: {ex.Message}");
        }
        finally
        {
            _isSeeding = false;
        }
    }
}
