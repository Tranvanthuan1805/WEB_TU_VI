@page "/admin/products"
@rendermode InteractiveServer
@attribute [StreamRendering]

@attribute [Authorize(Roles = RoleName.Administrator)]
@inject ToastService ToastService
@inject ConfirmDialogService ConfirmDialogService
@inject IJSRuntime JS

<PageTitle>Quản lý sản phẩm</PageTitle>

<div class="article-manager" data-theme="admin">
    <div class="page-header">
        <div>
            <h2>Quản lý sản phẩm</h2>
            <p>Xem, tạo, chỉnh sửa và xóa sản phẩm.</p>
        </div>
        <button class="add-article-btn" @onclick="ShowCreateForm">
            <span class="material-symbols-outlined">add</span>
            <span>Thêm sản phẩm</span>
        </button>
    </div>

    <div class="stats-row">
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Đã xuất bản</span>
                <span class="material-symbols-outlined stat-mini-icon">check_circle</span>
            </div>
            <span class="stat-mini-value">@_publishedCount</span>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Hết hàng</span>
                <span class="material-symbols-outlined stat-mini-icon warning">inventory_2</span>
            </div>
            <span class="stat-mini-value">@_outOfStockCount</span>
        </div>
        <div class="stat-mini">
            <div class="stat-mini-header">
                <span class="stat-mini-label">Tổng số</span>
                <span class="material-symbols-outlined stat-mini-icon">inventory</span>
            </div>
            <span class="stat-mini-value">@_totalCount</span>
        </div>
    </div>

    <div class="table-container">
        <div class="table-controls">
            <div class="search-filter">
                <div class="search-input">
                    <span class="material-symbols-outlined">search</span>
                    <input type="text" placeholder="Tìm kiếm theo tên..." @bind="searchQuery" @oninput="OnSearchChanged" />
                </div>
                <div class="category-dropdown">
                    <select @bind="_statusFilter" @bind:after="OnFilterChanged">
                        <option value="">Tất cả</option>
                        <option value="published">Đã xuất bản</option>
                        <option value="outofstock">Hết hàng</option>
                    </select>
                    <span class="material-symbols-outlined dropdown-icon">expand_more</span>
                </div>
            </div>
        </div>

        <div class="data-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th @onclick="() => ToggleSort(nameof(Product.Name))" class="sortable">
                            Tên sản phẩm
                            @GetSortIcon(nameof(Product.Name))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Product.OriginPrice))" class="sortable">
                            Giá gốc
                            @GetSortIcon(nameof(Product.OriginPrice))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Product.Price))" class="sortable">
                            Giá
                            @GetSortIcon(nameof(Product.Price))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Product.Discount))" class="sortable">
                            Giảm giá
                            @GetSortIcon(nameof(Product.Discount))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Product.Quantity))" class="sortable">
                            Số lượng
                            @GetSortIcon(nameof(Product.Quantity))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Product.QuantitySold))" class="sortable">
                            Đã bán
                            @GetSortIcon(nameof(Product.QuantitySold))
                        </th>
                        <th>Trạng thái</th>
                        <th @onclick="() => ToggleSort(nameof(Product.DateCreated))" class="sortable">
                            Ngày tạo
                            @GetSortIcon(nameof(Product.DateCreated))
                        </th>
                        <th @onclick="() => ToggleSort(nameof(Product.DateUpdated))" class="sortable">
                            Ngày cập nhật
                            @GetSortIcon(nameof(Product.DateUpdated))
                        </th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
@if (_pagedProducts == null)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-8 text-on-surface-variant">
                                Đang tải...
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var product in _pagedProducts)
                        {
                            <tr>
                                <td>
                                    <div class="article-title-cell">
                                        <span class="article-title">@product.Name</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="price-text">@product.OriginPrice.ToString("N0")₫</span>
                                </td>
                                <td>
                                    <span class="price-text">@product.Price.ToString("N0")₫</span>
                                </td>
                                <td>
                                    <span class="discount-text">@product.Discount.ToString("0")%</span>
                                </td>
                                <td>
                                    <span class="quantity-text">@(product.Quantity < 0 ? "∞" : product.Quantity.ToString("N0"))</span>
                                </td>
                                <td>
                                    <span class="quantity-text">@product.QuantitySold.ToString("N0")</span>
                                </td>
                                <td>
                                    <span class="status-tag @(product.Published ? "published" : "draft")">@(product.Published ? "Xuất bản" : "Nháp")</span>
                                </td>
                                <td>
                                    <span class="date-text">@product.DateCreated.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    <span class="date-text">@product.DateUpdated.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    <div class="row-actions">
                                        <button class="row-action-btn" title="Sửa" @onclick="() => EditProduct(product)">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        <button class="row-action-btn danger" title="Xóa" @onclick="() => DeleteProduct(product)">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        if (!_pagedProducts.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-8 text-on-surface-variant">
                                    Không có sản phẩm nào.
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (_totalPages > 1)
        {
            <div class="table-footer w-full overflow-auto">
                <div class="page-size-control">
                    <label class="text-xs text-on-surface-variant">Số dòng:</label>
                    <input type="number"
                    class="page-size-input"
                    min="1"
                    @bind="_pageSize"
                    @bind:after="UpdatePagedProducts" />
                </div>
                <span class="showing-text">Hiển thị @startItem-@endItem của @_totalFiltered sản phẩm</span>
                <div class="pagination">
                    <button class="page-btn" disabled="@(_currentPage == 1)" @onclick="() => GoToPage(_currentPage - 1)">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    @foreach (var item in GetVisiblePages())
                    {
                        if (item is int pageNum)
                        {
                            <button class="page-btn @(_currentPage == pageNum ? "active" : "")" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        }
                        else
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }
                    <button class="page-btn" disabled="@(_currentPage == _totalPages)" @onclick="() => GoToPage(_currentPage + 1)">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
                <div class="page-jump">
                    <label class="text-xs text-on-surface-variant">Tới trang:</label>
                    <input type="number"
                    class="page-jump-input"
                    min="1" max="@_totalPages"
                    @bind="_jumpToPage"
                    @bind:after="JumpToPage" />
                </div>
            </div>
        }
    </div>
</div>

@if (_showEditor)
{
    <div class="editor-modal-overlay" @onclick="CloseEditor">
        <div class="editor-modal overflow-auto" @onclick:stopPropagation="true">
            <div class="editor-header">
                <h3>@(_isEditing ? "Chỉnh sửa sản phẩm" : "Thêm sản phẩm mới")</h3>
                <button class="close-btn" @onclick="CloseEditor">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <EditForm Model="_editModel" OnValidSubmit="SaveProduct">
                <DataAnnotationsValidator />
                <div class="editor-body">
                    <div class="form-group">
                        <ValidationSummary class="text-error" role="alert" />
                    </div>
                    <div class="form-group">
                        <label>Tên sản phẩm <span class="required">*</span></label>
                        <InputText class="form-input" @bind-Value="_editModel.Name" placeholder="Nhập tên sản phẩm..." />
                        <ValidationMessage For="@(() => _editModel.Name)" />
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Giá gốc (VNĐ)</label>
                            <InputNumber class="form-input" @bind-Value="_originPriceInput" @oninput="OnOriginPriceChanged" placeholder="Nhập giá gốc..." />
                            <span class="form-hint">Để trống nếu nhập giá bán</span>
                        </div>
                        <div class="form-group">
                            <label>Giá bán (VNĐ)</label>
                            <InputNumber class="form-input" @bind-Value="_priceInput" @oninput="OnPriceChanged" placeholder="Nhập giá bán..." />
                            <span class="form-hint">Để trống nếu nhập giá gốc</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Giảm giá (%)</label>
                            <InputNumber class="form-input" @bind-Value="_editModel.Discount" @oninput="OnDiscountChanged" placeholder="0-100" />
                            <span class="form-hint">Tự động tính khi nhập giá</span>
                        </div>
                        <div class="form-group">
                            <label>Số lượng</label>
                            <InputNumber class="form-input" @bind-Value="_editModel.Quantity" placeholder="-1 cho không giới hạn" />
                            <span class="form-hint">Nhập -1 cho số lượng không giới hạn</span>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Số lượng vé</label>
                            <InputNumber class="form-input" @bind-Value="_editModel.NumberofTickets" placeholder="Số lượng vé" />
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <InputCheckbox @bind-Value="_editModel.Published" />
                                Xuất bản
                            </label>
                        </div>
                    </div>
                </div>
                <div class="editor-footer">
                    <button type="button" class="btn-secondary" @onclick="CloseEditor">Hủy</button>
                    <button type="submit" class="btn-primary">@(_isEditing ? "Cập nhật" : "Tạo mới")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        vertical-align: middle;
    }

    .article-manager[data-theme="admin"] {
        --primary: #1E3A8A;
        --primary-container: #1E3A8A;
        --on-primary: #ffffff;
        --surface: #F8FAFC;
        --surface-container: #e2e8f0;
        --surface-container-low: #f1f5f9;
        --surface-container-high: #cbd5e1;
        --on-surface: #1e293b;
        --on-surface-variant: #475569;
        --outline: #64748B;
        --outline-variant: #cbd5e1;
        --error-container: #dc2626;
        --on-error-container: #ffffff;
        --secondary-container: #e2e8f0;
        --on-secondary-container: #475569;
        --tertiary-container: #6E2C00;
        --on-tertiary-container: #ffffff;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }

        .page-header h2 {
            color: var(--on-surface);
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0 0 0.25rem;
        }

        .page-header p {
            color: var(--on-surface-variant);
            font-size: 0.875rem;
            margin: 0;
        }

    .add-article-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.25rem;
        background: var(--primary);
        color: var(--on-primary);
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.2s;
    }

        .add-article-btn:hover {
            opacity: 0.9;
        }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-mini {
        background: var(--surface-container-low);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
    }

    .stat-mini-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .stat-mini-label {
        font-size: 0.75rem;
        color: var(--on-surface-variant);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-mini-icon {
        color: var(--primary);
        font-size: 1.25rem;
    }

        .stat-mini-icon.warning {
            color: #f59e0b;
        }

    .stat-mini-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--on-surface);
    }

    .stat-mini-trend {
        font-size: 0.75rem;
        color: var(--on-surface-variant);
    }

    .table-container {
        background: var(--surface-container-low);
        border-radius: 0.75rem;
        overflow: hidden;
    }

    .table-controls {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--outline-variant);
    }

    .search-filter {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .search-input {
        position: relative;
        flex: 1;
    }

        .search-input .material-symbols-outlined {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--on-surface-variant);
            font-size: 1.25rem;
        }

        .search-input input {
            width: 100%;
            padding: 0.5rem 0.75rem 0.5rem 2.5rem;
            border: 1px solid var(--outline-variant);
            border-radius: 0.5rem;
            background: var(--surface);
            color: var(--on-surface);
            font-size: 0.875rem;
        }

            .search-input input:focus {
                outline: none;
                border-color: var(--primary);
                box-shadow: 0 0 0 2px rgba(30, 58, 138, 0.1);
            }

    .category-dropdown {
        position: relative;
        min-width: 180px;
    }

        .category-dropdown select {
            width: 100%;
            padding: 0.5rem 2rem 0.5rem 0.75rem;
            border: 1px solid var(--outline-variant);
            border-radius: 0.5rem;
            background: var(--surface);
            color: var(--on-surface);
            font-size: 0.875rem;
            appearance: none;
            cursor: pointer;
        }

    .dropdown-icon {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        pointer-events: none;
        color: var(--on-surface-variant);
    }

    .data-table-wrapper {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            padding: 0.75rem 1rem;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--on-surface-variant);
            background: var(--surface-container);
            border-bottom: 1px solid var(--outline-variant);
            white-space: nowrap;
        }

            .data-table th.sortable {
                cursor: pointer;
                user-select: none;
            }

                .data-table th.sortable:hover {
                    background: var(--surface-container-high);
                }

        .data-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--outline-variant);
            font-size: 0.875rem;
            color: var(--on-surface);
            white-space: nowrap;
        }

        .data-table tbody tr:hover {
            background: var(--surface-container);
        }

    .article-title-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .article-thumb {
        width: 40px;
        height: 40px;
        border-radius: 0.375rem;
        object-fit: cover;
    }

    .article-title {
        font-weight: 500;
        color: var(--on-surface);
    }

    .price-text {
        font-weight: 500;
        color: var(--on-surface);
    }

    .discount-text {
        color: #dc2626;
        font-weight: 500;
    }

    .quantity-text {
        color: var(--on-surface-variant);
    }

    .status-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }

        .status-tag.published {
            background: #dcfce7;
            color: #166534;
        }

        .status-tag.draft {
            background: var(--secondary-container);
            color: var(--on-secondary-container);
        }

    .date-text {
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
    }

    .row-actions {
        display: flex;
        gap: 0.25rem;
        justify-content: flex-end;
    }

    .row-action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: none;
        border-radius: 0.375rem;
        background: transparent;
        color: var(--on-surface-variant);
        cursor: pointer;
        transition: background 0.2s;
    }

        .row-action-btn:hover {
            background: var(--surface-container);
        }

        .row-action-btn.danger:hover {
            background: #fef2f2;
            color: #dc2626;
        }

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        background: var(--surface-container);
    }

    .showing-text {
        font-size: 0.8125rem;
        color: var(--on-surface-variant);
    }

    .pagination {
        display: flex;
        gap: 0.25rem;
    }

    .page-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .page-btn:hover:not(:disabled):not(.active) {
            background: var(--surface-container-high);
        }

        .page-btn.active {
            background: var(--primary);
            color: var(--on-primary);
            border-color: var(--primary);
        }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .page-ellipsis {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 2rem;
        height: 2rem;
        color: var(--on-surface-variant);
        font-size: 0.8125rem;
    }

    .page-size-control {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-size-input {
        width: 3.5rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface);
        text-align: center;
        font-size: 0.8125rem;
    }

    .page-jump {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-jump-input {
        width: 3.5rem;
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface);
        text-align: center;
        font-size: 0.8125rem;
    }

    .editor-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 100;
    }

    .editor-modal {
        background: var(--surface-container-low);
        border-radius: 0.75rem;
        width: 90%;
        max-width: 700px;
        max-height: 90vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--outline-variant);
    }

        .editor-header h3 {
            margin: 0;
            color: var(--on-surface);
            font-size: 1.125rem;
        }

    .close-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: none;
        border-radius: 0.375rem;
        background: transparent;
        color: var(--on-surface-variant);
        cursor: pointer;
    }

        .close-btn:hover {
            background: var(--surface-container);
        }

    .editor-body {
        padding: 1.5rem;
        overflow-y: auto;
        flex: 1;
    }

    .form-group {
        margin-bottom: 1rem;
    }

        .form-group label {
            display: block;
            font-size: 0.8125rem;
            font-weight: 500;
            color: var(--on-surface);
            margin-bottom: 0.375rem;
        }

    .form-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--outline-variant);
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--on-surface);
        font-size: 0.875rem;
    }

        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(30, 58, 138, 0.1);
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .form-hint {
        display: block;
        font-size: 0.75rem;
        color: var(--on-surface-variant);
        margin-top: 0.25rem;
    }

    .checkbox-label {
        display: flex !important;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .required {
        color: #dc2626;
    }

    .editor-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--outline-variant);
    }

    .btn-primary {
