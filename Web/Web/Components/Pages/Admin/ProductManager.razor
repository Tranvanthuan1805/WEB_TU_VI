@code {
    private string searchQuery = "";
    private string _statusFilter = "";
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _jumpToPage = 1;
    private bool _showEditor = false;
    private bool _isEditing = false;
    private int? _editingProductId;

    private int _publishedCount;
    private int _outOfStockCount;
    private int _totalCount;

    private string _sortField = nameof(Product.DateUpdated);
    private bool _sortDescending = true;

    private List<Product> _allProducts;
    private List<Product> _filteredProducts;
    private List<Product> _pagedProducts;

    [SupplyParameterFromForm]
    private Product _editModel { get; set; } = new();

    private decimal? _originPriceInput;
    private decimal? _priceInput;
    private bool _updatingFromCode = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        using var context = DbFactory.CreateDbContext();
        _allProducts = await context.Products
            .OrderByDescending(p => p.DateUpdated)
            .ToListAsync();
        ApplyFilters();
    }

    private void UpdateCounts()
    {
        _publishedCount = _allProducts.Count(p => p.Published);
        _outOfStockCount = _allProducts.Count(p => p.Quantity > 0 && p.QuantitySold >= p.Quantity);
        _totalCount = _allProducts.Count;
        _totalPages = (int)Math.Ceiling((double)_filteredProducts.Count / _pageSize);
        _totalFiltered = _filteredProducts.Count;
        startItem = _filteredProducts.Count == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
        endItem = Math.Min(_currentPage * _pageSize, _filteredProducts.Count);
        _jumpToPage = _currentPage;
    }

    private void ApplyFilters()
    {
        _filteredProducts = _allProducts.AsEnumerable()
            .Where(p => string.IsNullOrEmpty(searchQuery) || p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Where(p => (string.IsNullOrWhiteSpace(_statusFilter))
            || (_statusFilter == "published" && p.Published)
            || (_statusFilter == "outofstock" && p.Quantity > 0 && p.QuantitySold >= p.Quantity))
        .ToList();

        _filteredProducts = _sortField switch
        {
            nameof(Product.Name) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.Name).ToList()
                : _filteredProducts.OrderBy(p => p.Name).ToList(),
            nameof(Product.OriginPrice) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.OriginPrice).ToList()
                : _filteredProducts.OrderBy(p => p.OriginPrice).ToList(),
            nameof(Product.Price) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.Price).ToList()
                : _filteredProducts.OrderBy(p => p.Price).ToList(),
            nameof(Product.Discount) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.Discount).ToList()
                : _filteredProducts.OrderBy(p => p.Discount).ToList(),
            nameof(Product.Quantity) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.Quantity).ToList()
                : _filteredProducts.OrderBy(p => p.Quantity).ToList(),
            nameof(Product.QuantitySold) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.QuantitySold).ToList()
                : _filteredProducts.OrderBy(p => p.QuantitySold).ToList(),
            nameof(Product.DateCreated) => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.DateCreated).ToList()
                : _filteredProducts.OrderBy(p => p.DateCreated).ToList(),
            _ => _sortDescending
                ? _filteredProducts.OrderByDescending(p => p.DateUpdated).ToList()
                : _filteredProducts.OrderBy(p => p.DateUpdated).ToList()
        };
        _currentPage = 1;
        UpdatePagedProducts();
    }

    private void UpdatePagedProducts()
    {
        if (_pageSize < 1)
        {
            _pageSize = 1;
            return;
        }

        _pagedProducts = _filteredProducts
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
        UpdateCounts();
        StateHasChanged();
    }

    private int _totalPages;
    private int _totalFiltered;
    private int startItem;
    private int endItem;

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        ApplyFilters();
    }

    private void OnFilterChanged()
    {
        ApplyFilters();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= _totalPages)
        {
            _currentPage = page;
            UpdatePagedProducts();
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
    }

    private async Task JumpToPage()
    {
        if (_jumpToPage < 1)
            _jumpToPage = 1;
        else if (_jumpToPage > _totalPages)
            _jumpToPage = _totalPages;
        await GoToPage(_jumpToPage);
    }

    private void ToggleSort(string field)
    {
        if (_sortField == field)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortField = field;
            _sortDescending = true;
        }
        ApplyFilters();
    }

    private string GetSortIcon(string field)
    {
        if (_sortField != field) return "";
        return _sortDescending ? " ↓" : " ↑";
    }

    private void ShowCreateForm()
    {
        _isEditing = false;
        _editingProductId = null;
        _editModel = new Product();
        _originPriceInput = null;
        _priceInput = null;
        _showEditor = true;
    }

    private void EditProduct(Product product)
    {
        _isEditing = true;
        _editingProductId = product.ProductId;
        _editModel = new Product
        {
            Name = product.Name,
            OriginPrice = product.OriginPrice,
            Price = product.Price,
            Discount = product.Discount,
            Quantity = product.Quantity,
            NumberofTickets = product.NumberofTickets,
            Published = product.Published
        };
        _originPriceInput = product.OriginPrice;
        _priceInput = product.Price;
        _showEditor = true;
    }

    private async Task CloseEditor()
    {
        if (_showEditor && HasUnsavedChanges())
        {
            var confirmed = await ConfirmDialogService.ShowAsync(
                "Hủy thay đổi?",
                "Các thay đổi chưa lưu sẽ bị mất.",
                "Hủy thay đổi",
                isDanger: true);
            if (!confirmed) return;
        }
        _showEditor = false;
    }

    private bool HasUnsavedChanges()
    {
        return !string.IsNullOrEmpty(_editModel.Name) ||
               _editModel.OriginPrice > 0 ||
               _editModel.Price > 0 ||
               _editModel.Quantity != 0;
    }

    private void OnOriginPriceChanged(ChangeEventArgs e)
    {
        if (_updatingFromCode) return;
        
        if (decimal.TryParse(e.Value?.ToString(), out var originPrice))
        {
            _originPriceInput = originPrice;
            CalculatePriceFromOriginPrice();
        }
    }

    private void OnPriceChanged(ChangeEventArgs e)
    {
        if (_updatingFromCode) return;
        
        if (decimal.TryParse(e.Value?.ToString(), out var price))
        {
            _priceInput = price;
            CalculatePriceFromPriceInput();
        }
    }

    private void OnDiscountChanged(ChangeEventArgs e)
    {
        if (_updatingFromCode) return;
        
        RecalculatePriceFromDiscount();
    }

    private void CalculatePriceFromOriginPrice()
    {
        if (!_originPriceInput.HasValue || _originPriceInput.Value <= 0) return;
        
        _updatingFromCode = true;
        try
        {
            if (!_priceInput.HasValue || _priceInput.Value == 0)
            {
                _editModel.Price = _originPriceInput.Value;
                _priceInput = _editModel.Price;
                _editModel.Discount = 0;
            }
            else if (_priceInput.Value >= _originPriceInput.Value)
            {
                _editModel.Discount = 0;
                _editModel.Price = _priceInput.Value;
            }
            else
            {
                _editModel.Discount = Math.Round(((_originPriceInput.Value - _priceInput.Value) / _originPriceInput.Value) * 100, 0);
                _editModel.Price = _priceInput.Value;
            }
        }
        finally
        {
            _updatingFromCode = false;
        }
    }

    private void CalculatePriceFromPriceInput()
    {
        if (!_priceInput.HasValue || _priceInput.Value <= 0) return;
        
        _updatingFromCode = true;
        try
        {
            if (_originPriceInput.HasValue && _originPriceInput.Value > 0)
            {
                if (_priceInput.Value > _originPriceInput.Value)
                {
                    _editModel.Discount = 0;
                    _editModel.Price = _priceInput.Value;
                }
                else if (_priceInput.Value == _originPriceInput.Value)
                {
                    _editModel.Discount = 0;
                    _editModel.Price = _priceInput.Value;
                }
                else
                {
                    _editModel.Discount = Math.Round(((_originPriceInput.Value - _priceInput.Value) / _originPriceInput.Value) * 100, 0);
                    _editModel.Price = _priceInput.Value;
                }
            }
            else
            {
                _editModel.OriginPrice = _priceInput.Value;
                _originPriceInput = _priceInput.Value;
                _editModel.Price = _priceInput.Value;
                _editModel.Discount = 0;
            }
        }
        finally
        {
            _updatingFromCode = false;
        }
    }

    private void RecalculatePriceFromDiscount()
    {
        if (_updatingFromCode) return;
        
        _updatingFromCode = true;
        try
        {
            if (_editModel.Discount < 0)
            {
                _editModel.Discount = 0;
            }

            if (_editModel.Discount == 0)
            {
                if (_originPriceInput.HasValue && _originPriceInput.Value > 0)
                {
                    _editModel.Price = _originPriceInput.Value;
                    _priceInput = _editModel.Price;
                }
                else if (_priceInput.HasValue && _priceInput.Value > 0)
                {
                    _editModel.OriginPrice = _priceInput.Value;
                    _originPriceInput = _editModel.OriginPrice;
                }
            }
            else if (_editModel.Discount > 0 && _editModel.Discount <= 100)
            {
                if (_originPriceInput.HasValue && _originPriceInput.Value > 0)
                {
                    _editModel.Price = Math.Round(_originPriceInput.Value * (1 - _editModel.Discount / 100), 0);
                    _priceInput = _editModel.Price;
                }
                else if (_priceInput.HasValue && _priceInput.Value > 0)
                {
                    _editModel.OriginPrice = Math.Round(_priceInput.Value / (1 - _editModel.Discount / 100), 0);
                    _originPriceInput = _editModel.OriginPrice;
                }
            }
        }
        finally
        {
            _updatingFromCode = false;
        }
    }

    private async Task SaveProduct()
    {
        try
        {
            if (_isEditing)
            {
                var confirmed = await ConfirmDialogService.ShowAsync(
                    "Xác nhận cập nhật",
                    "Bạn có chắc muốn cập nhật sản phẩm này?",
                    "Cập nhật",
                    isDanger: true);
                if (!confirmed) return;
            }

            var now = DateTime.UtcNow;

            if (_originPriceInput.HasValue && _originPriceInput.Value > 0)
            {
                _editModel.OriginPrice = _originPriceInput.Value;
            }

            if (_priceInput.HasValue && _priceInput.Value > 0)
            {
                _editModel.Price = _priceInput.Value;
            }

            if (_editModel.OriginPrice == 0 && _editModel.Price == 0)
            {
                _editModel.Discount = 0;
            }
            else if (_editModel.Price > _editModel.OriginPrice && _editModel.OriginPrice > 0)
            {
                ToastService.Show("warning", "Giá bán không được lớn hơn giá gốc!");
                return;
            }

            if (_editModel.Quantity > 0 && _editModel.QuantitySold >= _editModel.Quantity)
            {
                _editModel.Published = false;
            }

            if (_isEditing && _editingProductId.HasValue)
            {
                using var context = DbFactory.CreateDbContext();
                var product = await context.Products.FindAsync(_editingProductId.Value);
                if (product == null)
                {
                    ToastService.Show("error", "Không tìm thấy sản phẩm!");
                    return;
                }

                product.Name = _editModel.Name;
                product.OriginPrice = _editModel.OriginPrice;
                product.Price = _editModel.Price;
                product.Discount = _editModel.Discount;
                product.Quantity = _editModel.Quantity;
                product.NumberofTickets = _editModel.NumberofTickets;
                product.Published = _editModel.Published;
                product.DateUpdated = now;

                context.Products.Update(product);
                await context.SaveChangesAsync();
                ToastService.Show("success", "Đã cập nhật sản phẩm!");
            }
            else
            {
                var product = new Product
                {
                    Name = _editModel.Name,
                    OriginPrice = _editModel.OriginPrice,
                    Price = _editModel.Price,
                    Discount = _editModel.Discount,
                    Quantity = _editModel.Quantity,
                    QuantitySold = 0,
                    NumberofTickets = _editModel.NumberofTickets,
                    Published = _editModel.Published,
                    DateCreated = now,
                    DateUpdated = now
                };
                using var context = DbFactory.CreateDbContext();
                context.Products.Add(product);
                await context.SaveChangesAsync();
                ToastService.Show("success", "Đã tạo sản phẩm mới!");
            }

            _showEditor = false;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            ToastService.Show("error", $"Lỗi: {ex.Message}");
        }
    }

    private async Task DeleteProduct(Product product)
    {
        var confirmed = await ConfirmDialogService.ShowAsync(
            "Xác nhận xóa",
            $"Bạn có chắc muốn xóa sản phẩm \"{product.Name}\"?",
            "Xóa",
            isDanger: true);

        if (!confirmed) return;

        try
        {
            using var context = DbFactory.CreateDbContext();
            context.Products.Remove(product);
            await context.SaveChangesAsync();
