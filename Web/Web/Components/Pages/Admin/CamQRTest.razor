@page "/admin/camqr-test"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Web.Services
@inject NavigationManager NavManager
@inject TuViExcelService TuViExcelService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="p-4 md:p-6 max-w-7xl mx-auto space-y-6">
    <!-- Header Page Title -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-surface-container/60 border border-outline-variant p-6 rounded-2xl shadow-sm backdrop-blur-md">
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-2 text-on-surface">
                <span class="material-symbols-outlined text-primary text-3xl">qr_code_scanner</span>
                Hệ Thống Giao Tiếp CamQR & Luận Giải
            </h1>
            <p class="text-sm text-muted mt-1.5">Mã hóa hồ sơ Excel thành QR Code, quét bằng Webcam và hiển thị kết quả luận giải trực quan.</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="flex h-3 w-3 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 @(IsConnected ? "bg-success" : "bg-danger")"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 @(IsConnected ? "bg-success" : "bg-danger")"></span>
            </span>
            <span class="badge @(IsConnected ? "bg-success/10 text-success" : "bg-danger/10 text-danger") px-3 py-1 rounded-full text-xs font-bold border border-success/20">
                @(IsConnected ? "SignalR: Connected" : "SignalR: Disconnected")
            </span>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-outline-variant gap-1.5">
        <button @onclick="() => SetActiveTab(1)" 
                class="flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 transition-all @(ActiveTab == 1 ? "border-primary text-primary bg-primary/5 rounded-t-lg" : "border-transparent text-muted hover:text-on-surface hover:bg-surface-container/30")">
            <span class="material-symbols-outlined text-lg">videocam</span>
            Quét Camera Webcam
        </button>
        <button @onclick="() => SetActiveTab(2)" 
                class="flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 transition-all @(ActiveTab == 2 ? "border-primary text-primary bg-primary/5 rounded-t-lg" : "border-transparent text-muted hover:text-on-surface hover:bg-surface-container/30")">
            <span class="material-symbols-outlined text-lg">assignment</span>
            Hồ Sơ & Tạo QR Code (@AllProfiles.Count)
        </button>
        <button @onclick="() => SetActiveTab(3)" 
                class="flex items-center gap-2 px-5 py-3 text-sm font-semibold border-b-2 transition-all @(ActiveTab == 3 ? "border-primary text-primary bg-primary/5 rounded-t-lg" : "border-transparent text-muted hover:text-on-surface hover:bg-surface-container/30")">
            <span class="material-symbols-outlined text-lg">settings_ethernet</span>
            SignalR Hub Test
        </button>
    </div>

    <!-- Tab 1: Webcam QR Scanner & Calculate -->
    <div class="@(ActiveTab == 1 ? "block" : "hidden") space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Camera Video Feed Panel -->
            <div class="lg:col-span-5 bg-surface rounded-2xl border border-outline-variant p-5 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-md font-bold text-on-surface flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-primary">photo_camera</span>
                        Webcam Trực Tiếp
                    </h3>
                    <div class="flex items-center gap-2">
                        @if (!_isWebcamScanning)
                        {
                            <button @onclick="StartWebcamScanner" class="px-3.5 py-1.5 bg-primary text-on-primary rounded-lg text-xs font-semibold hover:bg-primary-hover transition flex items-center gap-1.5 shadow-sm">
                                <span class="material-symbols-outlined text-sm">videocam</span> Bật Cam
                            </button>
                        }
                        else
                        {
                            <button @onclick="StopWebcamScanner" class="px-3.5 py-1.5 bg-danger text-on-danger rounded-lg text-xs font-semibold hover:bg-danger/90 transition flex items-center gap-1.5 shadow-sm">
                                <span class="material-symbols-outlined text-sm">videocam_off</span> Tắt Cam
                            </button>
                        }
                    </div>
                </div>

                <div class="relative bg-black rounded-xl overflow-hidden aspect-video border border-outline flex items-center justify-center min-h-[220px]">
                    <video id="admin-scanner-video" class="w-full h-full object-cover" style="display: @(_isWebcamScanning ? "block" : "none"); transform: scaleX(-1);"></video>
                    
                    @if (!_isWebcamScanning)
                    {
                        <div class="text-center p-6 text-stone-500 space-y-2">
                            <span class="material-symbols-outlined text-5xl">videocam_off</span>
                            <p class="text-sm font-medium">Camera đang tắt</p>
                            <p class="text-xs text-stone-400">Hãy nhấn "Bật Cam" để quét mã QR từ máy tính/điện thoại khác</p>
                        </div>
                    }
                    else
                    {
                        <!-- Target scanner overlay guide -->
                        <div class="absolute inset-0 pointer-events-none flex items-center justify-center">
                            <div class="w-48 h-48 border-4 border-dashed border-amber-500 rounded-2xl bg-amber-500/5 animate-pulse"></div>
                        </div>
                    }
                </div>

                <div class="p-3 bg-surface-container/60 border border-outline rounded-xl flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-primary text-md">info</span>
                    <p class="text-xs text-on-surface-variant font-medium"><strong>Trạng thái:</strong> @WebcamStatus</p>
                </div>
            </div>

            <!-- Calculated Interpretations Panel -->
            <div class="lg:col-span-7 bg-surface rounded-2xl border border-outline-variant p-6 shadow-sm space-y-6">
                @if (ScannedProfileResult == null)
                {
                    <div class="h-full min-h-[300px] flex flex-col items-center justify-center text-center p-6 text-stone-400 space-y-3">
                        <span class="material-symbols-outlined text-6xl text-stone-300">manage_search</span>
                        <div>
                            <h4 class="font-bold text-on-surface">Chưa Có Dữ Liệu Luận Giải</h4>
                            <p class="text-xs max-w-sm mt-1 mx-auto">Vui lòng bật webcam và hướng vào mã QR của hồ sơ ở máy khác để tự động luận giải từ Excel.</p>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Profile Header Details -->
                    <div class="p-4 bg-amber-50/60 border border-amber-200 rounded-xl flex items-start justify-between gap-4">
                        <div class="space-y-1">
                            <span class="px-2 py-0.5 bg-amber-600 text-white rounded text-[10px] font-bold uppercase tracking-wider">Đã Luận Giải</span>
                            <h3 class="text-lg font-bold text-amber-900 mt-1">@ScannedProfileName</h3>
                            <p class="text-xs text-stone-600 font-medium">@ScannedProfileInfo</p>
                        </div>
                        <button @onclick="ClearScannedResult" class="text-stone-400 hover:text-stone-600 transition">
                            <span class="material-symbols-outlined text-xl">close</span>
                        </button>
                    </div>

                    <!-- Tabs Inside Calculation Result -->
                    <div class="space-y-4">
                        <!-- Navigation result tabs -->
                        <div class="flex gap-2 border-b border-outline">
                            <button @onclick="() => ResultActiveSubTab = 1" class="px-4 py-2 text-xs font-bold border-b-2 transition-all @(ResultActiveSubTab == 1 ? "border-amber-600 text-amber-700 font-extrabold" : "border-transparent text-muted hover:text-on-surface")">
                                Lá Số Tử Vi
                            </button>
                            <button @onclick="() => ResultActiveSubTab = 2" class="px-4 py-2 text-xs font-bold border-b-2 transition-all @(ResultActiveSubTab == 2 ? "border-amber-600 text-amber-700 font-extrabold" : "border-transparent text-muted hover:text-on-surface")">
                                Bảng Thể Cách
                            </button>
                        </div>

                        <!-- Result Display Content -->
                        <div class="border border-outline-variant rounded-xl overflow-hidden bg-white max-h-[500px] overflow-y-auto p-2">
                            @if (ResultActiveSubTab == 1)
                            {
                                @((MarkupString)ScannedProfileResult.TuViHtml)
                            }
                            else
                            {
                                @((MarkupString)ScannedProfileResult.TheCachHtml)
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tab 2: Excel Profiles & Generate QR Codes -->
    <div class="@(ActiveTab == 2 ? "block" : "hidden") space-y-4 bg-surface rounded-2xl border border-outline-variant p-6 shadow-sm">
        <!-- Controls & Search -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="relative flex-grow max-w-md">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <span class="material-symbols-outlined text-muted text-lg">search</span>
                </span>
                <input type="text" @bind-value="SearchQuery" @bind-value:event="oninput" @onkeyup="HandleSearch"
                       placeholder="Tìm kiếm hồ sơ theo tên..."
                       class="w-full pl-10 pr-4 py-2 rounded-lg border border-outline bg-surface text-on-surface focus:outline-none focus:border-primary text-sm shadow-sm" />
            </div>
            <div class="text-xs text-muted font-medium bg-surface-container/60 px-3.5 py-2 rounded-lg border border-outline">
                Tổng cộng: <strong class="text-on-surface">@FilteredProfiles.Count</strong> / @AllProfiles.Count hồ sơ (Đọc từ Excel)
            </div>
        </div>

        <!-- Profiles Table -->
        <div class="border border-outline rounded-xl overflow-hidden bg-surface-container/30">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-surface-container border-b border-outline text-muted text-xs uppercase tracking-wider font-bold">
                        <th class="py-3 px-4 w-12 text-center">TT</th>
                        <th class="py-3 px-4">Họ Tên</th>
                        <th class="py-3 px-4 w-24">Giới Tính</th>
                        <th class="py-3 px-4 w-32">Ngày Sinh</th>
                        <th class="py-3 px-4 w-24">Giờ Sinh</th>
                        <th class="py-3 px-4">Ghi Chú</th>
                        <th class="py-3 px-4 w-28 text-center">Hành Động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-outline text-on-surface">
                    @if (!PagedProfiles.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-8 text-stone-500 font-medium">Không tìm thấy hồ sơ nào phù hợp.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var prof in PagedProfiles)
                        {
                            <tr class="hover:bg-surface-container/80 transition-colors">
                                <td class="py-3 px-4 text-center font-mono font-semibold text-stone-400">@prof.Index</td>
                                <td class="py-3 px-4 font-bold text-on-surface">@prof.FullName</td>
                                <td class="py-3 px-4">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold @(prof.Gender == "Nam" ? "bg-info/10 text-info" : "bg-danger/10 text-danger")">
                                        @prof.Gender
                                    </span>
                                </td>
                                <td class="py-3 px-4 font-medium">@prof.Day/@prof.Month/@prof.Year</td>
                                <td class="py-3 px-4 font-semibold text-stone-600">@prof.Hour</td>
                                <td class="py-3 px-4 text-xs text-muted line-clamp-1 truncate max-w-[200px]" title="@prof.Notes">@prof.Notes</td>
                                <td class="py-3 px-4 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <button @onclick="() => GenerateProfileQR(prof)" 
                                                class="px-2.5 py-1 bg-amber-500/10 text-amber-600 hover:bg-amber-500 hover:text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-1 border border-amber-500/20" title="Xem Mã QR">
                                            <span class="material-symbols-outlined text-xs">qr_code</span> Mã QR
                                        </button>
                                        <button @onclick="() => SimulateScan(prof)" 
                                                class="px-2.5 py-1 bg-primary/15 text-primary hover:bg-primary hover:text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-1 border border-primary/20" title="Giả lập Quét mã và Luận giải ngay">
                                            <span class="material-symbols-outlined text-xs">interactive_space</span> Quét Thử
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (TotalPages > 1)
        {
            <div class="flex items-center justify-between pt-2">
                <span class="text-xs text-muted">Trang @CurrentPage / @TotalPages</span>
                <div class="flex items-center gap-1">
                    <button @onclick="PrevPage" disabled="@(CurrentPage == 1)" 
                            class="p-1.5 rounded bg-surface border border-outline text-on-surface hover:bg-surface-container transition disabled:opacity-40 disabled:cursor-not-allowed">
                        <span class="material-symbols-outlined text-base flex">chevron_left</span>
                    </button>
                    
                    @for (int p = Math.Max(1, CurrentPage - 2); p <= Math.Min(TotalPages, CurrentPage + 2); p++)
                    {
                        var localP = p;
                        <button @onclick="() => GoToPage(localP)" 
                                class="px-3 py-1 rounded text-xs font-bold transition border @(CurrentPage == localP ? "bg-primary text-on-primary border-primary" : "bg-surface text-on-surface border-outline hover:bg-surface-container")">
                            @localP
                        </button>
                    }

                    <button @onclick="NextPage" disabled="@(CurrentPage == TotalPages)" 
                            class="p-1.5 rounded bg-surface border border-outline text-on-surface hover:bg-surface-container transition disabled:opacity-40 disabled:cursor-not-allowed">
                        <span class="material-symbols-outlined text-base flex">chevron_right</span>
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Tab 3: Old SignalR Hub Interface -->
    <div class="@(ActiveTab == 3 ? "block" : "hidden") bg-surface rounded-2xl border border-outline-variant p-6 shadow-sm space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Form -->
            <div class="space-y-4">
                <h4 class="text-md font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit_note</span>
                    Gửi Yêu Cầu Cho CamQR_A
                </h4>
                
                <div class="space-y-2">
                    <label class="text-xs font-semibold text-muted">Nội dung request:</label>
                    <textarea @bind="RequestData" rows="4" 
                              placeholder="Ví dụ: Xem Tử Vi cho Nguyễn Văn A, sinh ngày 15/05/1990 lúc 08:30..." 
                              class="w-full p-3 rounded-lg border border-outline bg-surface text-on-surface focus:outline-none focus:border-primary text-sm resize-none"></textarea>
                </div>

                <button @onclick="SendRequest" disabled="@(!IsConnected || string.IsNullOrWhiteSpace(RequestData) || _isSending)"
                        class="w-full py-2.5 px-4 bg-primary text-on-primary font-bold rounded-lg hover:bg-primary-hover transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 text-sm shadow-sm">
                    @if (_isSending)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-on-primary border-t-transparent rounded-full"></span>
                        <span>Đang gửi...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-sm">send</span>
                        <span>Gửi tới CamQR_A</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(CurrentRoomId))
                {
                    <div class="p-3 bg-info/10 text-info border border-info/20 rounded-xl space-y-1">
                        <p class="text-[10px] font-bold uppercase tracking-wider">Đang theo dõi phòng (Room)</p>
                        <p class="font-mono text-xs break-all font-bold">@CurrentRoomId</p>
                        <p class="text-[10px] opacity-80">Chờ CamQR_A và CamQR_B quét mã và phản hồi ảnh kết quả...</p>
                    </div>
                }
            </div>

            <!-- Result Display -->
            <div class="space-y-4">
                <h4 class="text-md font-bold text-on-surface flex items-center gap-2">
                    <span class="material-symbols-outlined text-success">table_chart</span>
                    Ảnh Phản Hồi Từ Camera
                </h4>

                <div class="border border-outline-variant rounded-xl bg-surface-container/50 flex items-center justify-center overflow-hidden" 
                     style="height: 250px; min-height: 250px;">
                    @if (string.IsNullOrEmpty(ReceivedImageBase64))
                    {
                        <div class="text-center p-6 text-stone-500">
                            <span class="material-symbols-outlined text-5xl mb-2 text-stone-400">image_search</span>
                            <p class="text-sm font-semibold">Chưa có kết quả phản hồi</p>
                            <p class="text-xs text-stone-400 mt-1">Kết quả dạng ảnh Base64 sẽ tự động xuất hiện ở đây khi quét thành công</p>
                        </div>
                    }
                    else
                    {
                        <div class="w-full h-full p-3 flex flex-col justify-between items-center bg-white">
                            <img src="@ReceivedImageBase64" class="max-h-[190px] max-w-full object-contain rounded border shadow-sm" />
                            <span class="text-[10px] text-stone-400 self-end font-mono">Nhận từ Room: @ResultRoomId</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Logs -->
        <div class="bg-surface-container/60 p-4 border border-outline rounded-xl">
            <h5 class="text-xs font-bold uppercase tracking-wider text-muted mb-2">Nhật Ký Tác Vụ SignalR (Logs)</h5>
            <div class="bg-stone-900 p-3 rounded-lg text-xs font-mono text-emerald-400 h-28 overflow-y-auto space-y-1">
                @foreach (var log in Logs)
                {
                    <p>@log</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal QR Code Generator Display Popup -->
@if (ActiveQRProfile != null)
{
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-surface border border-outline-variant rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
            <!-- Header -->
            <div class="bg-surface-container p-4 border-b border-outline flex items-center justify-between">
                <div>
                    <h3 class="text-base font-bold text-on-surface">Mã QR Hồ Sơ</h3>
                    <p class="text-xs text-muted mt-0.5">@ActiveQRProfile.FullName</p>
                </div>
                <button @onclick="CloseQRModal" class="text-stone-400 hover:text-stone-600 transition flex">
                    <span class="material-symbols-outlined text-xl">close</span>
                </button>
            </div>
            
            <!-- Body -->
            <div class="p-6 flex flex-col items-center justify-center text-center space-y-4">
                <div class="bg-white p-3.5 rounded-xl border border-stone-200 shadow-inner inline-block">
                    <div id="admin-qr-container" style="width:260px; height:260px;" class="flex items-center justify-center">
                        <span class="animate-spin h-8 w-8 border-4 border-amber-600 border-t-transparent rounded-full"></span>
                    </div>
                </div>
                <div class="space-y-1 text-xs text-on-surface-variant max-w-xs font-medium">
                    <p class="text-stone-800">Giới tính: @ActiveQRProfile.Gender | Ngày sinh: @ActiveQRProfile.Day/@ActiveQRProfile.Month/@ActiveQRProfile.Year</p>
                    <p class="text-stone-600">Giờ sinh: @ActiveQRProfile.Hour</p>
                    <p class="text-[10px] text-stone-400 mt-2 italic">Hãy mở màn hình này ở thiết bị khác, sau đó bật camera ở máy chính để quét và xem luận giải.</p>
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-surface-container/60 p-3 border-t border-outline flex justify-end">
                <button @onclick="CloseQRModal" class="px-4 py-2 bg-stone-250 text-stone-850 text-xs font-bold rounded-lg hover:bg-stone-300 transition">
                    Đóng
                </button>
            </div>
        </div>
    </div>
}

@code {
    private HubConnection? _hubConnection;
    private DotNetObjectReference<CamQRTest>? _objRef;
    
    // Tabs Navigation
    private int ActiveTab = 1;
    private int ResultActiveSubTab = 1;

    // SignalR Logs
    private string RequestData { get; set; } = string.Empty;
    private string CurrentRoomId { get; set; } = string.Empty;
    private string ReceivedImageBase64 { get; set; } = string.Empty;
    private string ResultRoomId { get; set; } = string.Empty;
    private bool _isSending = false;
    private List<string> Logs { get; } = new();
    private string HubUrl => NavManager.ToAbsoluteUri("/camqrhub").ToString();
    private bool IsConnected => _hubConnection?.State == HubConnectionState.Connected;

    // Excel Profiles List
    private List<ExcelProfile> AllProfiles = new();
    private List<ExcelProfile> FilteredProfiles = new();
    private List<ExcelProfile> PagedProfiles = new();
    
    private string SearchQuery = "";
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)FilteredProfiles.Count / PageSize);

    // QR Popup Modal
    private ExcelProfile? ActiveQRProfile = null;
    private string ActiveQRText = "";

    // Live Webcam Scanner State
    private bool _isWebcamScanning = false;
    private string WebcamStatus = "Chưa bật camera.";
    private string ScannedProfileName = "";
    private string ScannedProfileInfo = "";
    private TuViResult? ScannedProfileResult = null;

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        // 1. Initialize SignalR
        Log("Đang khởi tạo kết nối tới Hub...");
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(HubUrl)
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<string>("RequestAcknowledged", (roomId) =>
        {
            CurrentRoomId = roomId;
            _isSending = false;
            Log($"[Hub] Đã tạo Room mới thành công: {roomId}");
            InvokeAsync(StateHasChanged);
        });

        _hubConnection.On<string, string>("ReceiveResult", (roomId, base64Image) =>
        {
            ReceivedImageBase64 = base64Image;
            ResultRoomId = roomId;
            Log($"[Hub] Đã nhận được ảnh kết quả cho Room: {roomId}");
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
            Log("Đã kết nối thành công tới Hub!");
        }
        catch (Exception ex)
        {
            Log($"Lỗi kết nối Hub: {ex.Message}");
        }

        // 2. Load Excel Profiles
        try
        {
            AllProfiles = await TuViExcelService.GetProfilesFromExcelAsync();
            FilteredProfiles = AllProfiles.ToList();
            UpdatePagedList();
        }
        catch (Exception ex)
        {
            Log($"Lỗi đọc danh sách hồ sơ từ Excel: {ex.Message}");
            ToastService.ShowError("Không thể đọc danh sách hồ sơ từ file Excel.");
        }
    }

    private void SetActiveTab(int tabIndex)
    {
        ActiveTab = tabIndex;
        StateHasChanged();
    }

    // Search and Pagination Logic
    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            FilteredProfiles = AllProfiles.ToList();
        }
        else
        {
            FilteredProfiles = AllProfiles
                .Where(p => p.FullName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        CurrentPage = 1;
        UpdatePagedList();
    }

    private void UpdatePagedList()
    {
        PagedProfiles = FilteredProfiles
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        CurrentPage = page;
        UpdatePagedList();
    }

    private void PrevPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            UpdatePagedList();
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            UpdatePagedList();
        }
    }

    // Generate Profile QR
    private async Task GenerateProfileQR(ExcelProfile profile)
    {
        ActiveQRProfile = profile;
        // PROFILE:index|fullname|gender|day|month|year|hour|notes
        ActiveQRText = $"PROFILE:{profile.Index}|{profile.FullName}|{profile.Gender}|{profile.Day}|{profile.Month}|{profile.Year}|{profile.Hour}|{profile.Notes}";
        StateHasChanged();
        
        // Wait minor delay for modal DOM rendering, then trigger svg render
        await Task.Delay(150);
        await JSRuntime.InvokeAsync<bool>("camQrObj.generateQR", "#admin-qr-container", ActiveQRText);
    }

    private void CloseQRModal()
    {
        ActiveQRProfile = null;
        ActiveQRText = string.Empty;
        StateHasChanged();
    }

    // Start Live Webcam Scanner on page A
    private async Task StartWebcamScanner()
    {
        _isWebcamScanning = true;
        WebcamStatus = "Đang khởi động camera...";
        StateHasChanged();

        bool started = await JSRuntime.InvokeAsync<bool>("camQrObj.startScanner", "#admin-scanner-video", _objRef, nameof(OnWebcamQRScanned));
        if (started)
        {
            WebcamStatus = "Webcam đang chạy. Đang dò tìm mã QR hồ sơ...";
            ToastService.ShowInfo("Đã khởi động Webcam scanner thành công.");
        }
        else
        {
            _isWebcamScanning = false;
            WebcamStatus = "Không thể khởi động camera. Vui lòng kiểm tra quyền truy cập webcam.";
            ToastService.ShowError("Lỗi kết nối camera!");
        }
        StateHasChanged();
    }

    private async Task StopWebcamScanner()
    {
        await JSRuntime.InvokeVoidAsync("camQrObj.stopScanner", "#admin-scanner-video");
        _isWebcamScanning = false;
        WebcamStatus = "Webcam đang tắt.";
        StateHasChanged();
    }

    // Callback when QR code is scanned via browser camera
    [JSInvokable]
    public async Task OnWebcamQRScanned(string scannedText)
    {
        if (string.IsNullOrEmpty(scannedText)) return;

        // Unified format: PROFILE:index|name|gender|day|month|year|hour|notes
        if (scannedText.StartsWith("PROFILE:"))
        {
            try
            {
                var content = scannedText.Substring("PROFILE:".Length);
                var parts = content.Split('|');
                if (parts.Length >= 7)
                {
                    var index = parts[0];
                    var name = parts[1];
                    var gender = parts[2];
                    var day = int.Parse(parts[3]);
                    var month = int.Parse(parts[4]);
                    var year = int.Parse(parts[5]);
                    var hour = parts[6];
                    var notes = parts.Length > 7 ? parts[7] : "";

                    // Trigger Calculation
                    var input = new TuViInput
                    {
                        Gender = gender,
                        Day = day,
                        Month = month,
                        Year = year,
                        Hour = hour,
                        Use24HourFormat = true,
                        ViewYear = DateTime.Now.Year
                    };

                    ScannedProfileResult = await TuViExcelService.CalculateTuViAsync(input);
                    ScannedProfileName = name;
                    ScannedProfileInfo = $"{gender}, sinh ngày {day}/{month}/{year} lúc {hour}h";
                    ResultActiveSubTab = 1;

                    Log($"[Camera] Quét thành công hồ sơ: {name} | Đang hiển thị kết quả từ Excel.");
                    ToastService.ShowSuccess($"Đã quét thành công và luận giải cho {name}!");

                    // Stop scanner upon successful scanning to avoid CPU drain
                    await StopWebcamScanner();
                }
            }
            catch (Exception ex)
            {
                Log($"[Camera] Lỗi phân tích thông tin hồ sơ: {ex.Message}");
                ToastService.ShowError("Lỗi cấu trúc dữ liệu mã QR.");
            }
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Log($"[Camera] Phát hiện mã QR lạ: {scannedText}");
        }
    }

    private async Task SimulateScan(ExcelProfile profile)
    {
        var qrText = $"PROFILE:{profile.Index}|{profile.FullName}|{profile.Gender}|{profile.Day}|{profile.Month}|{profile.Year}|{profile.Hour}|{profile.Notes}";
        ActiveTab = 1;
        await OnWebcamQRScanned(qrText);
    }

    private void ClearScannedResult()
    {
        ScannedProfileResult = null;
        ScannedProfileName = string.Empty;
        ScannedProfileInfo = string.Empty;
        StateHasChanged();
    }

    // Old SignalR method
    private async Task SendRequest()
    {
        if (string.IsNullOrWhiteSpace(RequestData) || !IsConnected) return;

        _isSending = true;
        ReceivedImageBase64 = string.Empty;
        ResultRoomId = string.Empty;
        Log($"Đang gửi request dữ liệu: '{RequestData}'...");
        
        try
        {
            await _hubConnection!.SendAsync("SendRequest", RequestData);
        }
        catch (Exception ex)
        {
            _isSending = false;
            Log($"Lỗi gửi request: {ex.Message}");
        }
    }

    private void Log(string message)
    {
        string timestamp = DateTime.Now.ToString("HH:mm:ss");
        Logs.Add($"[{timestamp}] {message}");
        if (Logs.Count > 50)
        {
            Logs.RemoveAt(0);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isWebcamScanning)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("camQrObj.stopScanner", "#admin-scanner-video");
            }
            catch {}
        }
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
        _objRef?.Dispose();
    }
