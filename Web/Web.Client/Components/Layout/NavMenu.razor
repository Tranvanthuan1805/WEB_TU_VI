
@rendermode InteractiveAuto
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<header class="bg-white/95 backdrop-blur-sm border-b border-amber-100 shadow-sm sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <!-- Logo & Title -->
        <NavLink href="" Match="NavLinkMatch.All" class="flex items-center gap-3 shrink-0 group">
            <div class="relative w-10 h-10 overflow-hidden rounded-full border border-amber-200/60 shadow-sm bg-amber-50/20 p-0.5 flex items-center justify-center transition-all duration-500 group-hover:shadow-md group-hover:scale-105">
                <img src="logo.png" alt="Tử Vi Thần Toán Logo" class="w-full h-full object-contain animate-spin-slow" />
            </div>
            <div class="flex flex-col justify-center">
                <span class="font-sans font-black text-lg md:text-xl bg-gradient-to-r from-amber-700 via-amber-500 to-amber-800 bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient tracking-wide drop-shadow-sm select-none">
                    Tử Vi Thần Toán
                </span>
            </div>
        </NavLink>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-0.5">
            <NavLink class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors text-stone-600 hover:text-amber-600 hover:bg-amber-50/70" href="" Match="NavLinkMatch.All" ActiveClass="text-amber-700 bg-amber-50 font-semibold">Trang chủ</NavLink>
            <NavLink class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors text-stone-600 hover:text-amber-600 hover:bg-amber-50/70" href="bai-viet" ActiveClass="text-amber-700 bg-amber-50 font-semibold">Bài viết</NavLink>
            <NavLink class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors text-stone-600 hover:text-amber-600 hover:bg-amber-50/70" href="san-pham" ActiveClass="text-amber-700 bg-amber-50 font-semibold">Sản phẩm</NavLink>
            <NavLink class="px-3 py-1.5 text-sm font-medium rounded-lg transition-colors text-stone-600 hover:text-amber-600 hover:bg-amber-50/70" href="lien-he" ActiveClass="text-amber-700 bg-amber-50 font-semibold">Liên hệ</NavLink>
        </nav>

        <!-- Right Nav (Admin/Mobile Button) -->
        <div class="flex items-center gap-2">
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <NavLink href="admin" class="hidden md:flex items-center gap-1.5 text-xs font-semibold text-stone-400 hover:text-amber-600 transition-colors border border-stone-200 hover:border-amber-300 hover:bg-amber-50 px-3 py-1.5 rounded-lg">
                        <span class="text-base">⊛</span> Quản trị
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <!-- Logged in state -->
                    <div class="hidden md:flex items-center gap-3">
                        <span class="text-xs text-stone-500 font-semibold max-w-[120px] truncate" title="@context.User.Identity?.Name">
                            Chào, @(context.User.Identity?.Name?.Split('@')[0])
                        </span>
                        
                        <form method="post" action="/Account/Logout" class="inline">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="" />
                            <button type="submit" class="flex items-center gap-1 text-xs font-semibold text-stone-500 hover:text-red-600 transition-colors border border-stone-200 hover:border-red-200 hover:bg-red-50 px-2.5 py-1.5 rounded-lg cursor-pointer">
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <!-- Logged out state -->
                    <div class="hidden md:flex items-center gap-2">
                        <NavLink href="Account/Login" class="text-xs font-semibold text-stone-600 hover:text-amber-600 transition-colors px-3 py-1.5 rounded-lg hover:bg-amber-50/50">
                            Đăng nhập
                        </NavLink>
                        <NavLink href="Account/Register" class="text-xs font-semibold text-white bg-amber-700 hover:bg-amber-800 transition-colors px-3.5 py-1.5 rounded-lg shadow-sm">
                            Đăng ký
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <!-- Mobile Menu Button -->
            <button @onclick="ToggleMenu" aria-label="Mở menu" class="md:hidden flex flex-col items-center justify-center w-9 h-9 gap-1.5 rounded-lg hover:bg-amber-50 transition-colors">
                <span class="block w-5 h-0.5 bg-stone-600 rounded transition-all duration-300 @(mobileMenuOpen ? "rotate-45 translate-y-2" : "")"></span>
                <span class="block w-5 h-0.5 bg-stone-600 rounded transition-all duration-300 @(mobileMenuOpen ? "opacity-0" : "")"></span>
                <span class="block w-5 h-0.5 bg-stone-600 rounded transition-all duration-300 @(mobileMenuOpen ? "-rotate-45 -translate-y-2" : "")"></span>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Panel -->
    @if (mobileMenuOpen)
    {
        <div class="md:hidden overflow-hidden transition-all duration-300">
            <div class="bg-white px-4 py-3 space-y-1 border-t border-slate-100 shadow-lg">
                <NavLink class="flex items-center gap-2 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors text-stone-700 hover:text-amber-600 hover:bg-amber-50" href="" Match="NavLinkMatch.All" ActiveClass="text-amber-700 bg-amber-50 font-semibold" @onclick="CloseMenu">Trang chủ</NavLink>
                <NavLink class="flex items-center gap-2 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors text-stone-700 hover:text-amber-600 hover:bg-amber-50" href="bai-viet" ActiveClass="text-amber-700 bg-amber-50 font-semibold" @onclick="CloseMenu">Bài viết</NavLink>
                <NavLink class="flex items-center gap-2 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors text-stone-700 hover:text-amber-600 hover:bg-amber-50" href="san-pham" ActiveClass="text-amber-700 bg-amber-50 font-semibold" @onclick="CloseMenu">Sản phẩm</NavLink>
                <NavLink class="flex items-center gap-2 px-3 py-2.5 text-sm font-medium rounded-xl transition-colors text-stone-700 hover:text-amber-600 hover:bg-amber-50" href="lien-he" ActiveClass="text-amber-700 bg-amber-50 font-semibold" @onclick="CloseMenu">Liên hệ</NavLink>
                
                <AuthorizeView Roles="Administrator">
                    <Authorized>
                        <div class="pt-1 border-t border-stone-100 mt-1">
                            <NavLink href="admin" @onclick="CloseMenu" class="flex items-center gap-2 px-3 py-2.5 text-sm font-medium text-stone-400 hover:text-amber-600 hover:bg-amber-50 rounded-xl transition-colors">
                                <span>⊛</span> Quản trị
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <div class="pt-2 border-t border-stone-100 mt-2 flex items-center justify-between">
                            <span class="text-xs text-stone-500 font-semibold px-3 py-1">
                                Chào, @(context.User.Identity?.Name?.Split('@')[0])
                            </span>
                            <form method="post" action="/Account/Logout" class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="returnUrl" value="" />
                                <button type="submit" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50 rounded-xl transition-colors cursor-pointer">
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="pt-2 border-t border-stone-100 mt-2 grid grid-cols-2 gap-2">
                            <NavLink class="flex items-center justify-center px-3 py-2 text-sm font-medium rounded-xl transition-colors text-stone-700 hover:text-amber-600 hover:bg-amber-50 border border-stone-200" href="Account/Login" @onclick="CloseMenu">Đăng nhập</NavLink>
                            <NavLink class="flex items-center justify-center px-3 py-2 text-sm font-medium rounded-xl transition-colors text-white bg-amber-700 hover:bg-amber-800" href="Account/Register" @onclick="CloseMenu">Đăng ký</NavLink>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    }
</header>

@code {
    private bool mobileMenuOpen = false;

    private void ToggleMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMenu()
    {
        mobileMenuOpen = false;
    }
}
