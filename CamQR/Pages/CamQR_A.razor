@page "/camqr-a"
@using Microsoft.AspNetCore.SignalR.Client
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager
@implements IAsyncDisposable

<div class="container py-4">
    <div class="row">
        <!-- Left Panel: Request & QR Code Generator -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 bg-dark text-white h-100">
                <div class="card-header bg-primary text-white font-weight-bold d-flex justify-content-between align-items-center">
                    <span>CamQR_A - Màn hình tạo QR</span>
                    <span class="badge @(HubConnected ? "bg-success" : "bg-danger")">
                        @(HubConnected ? "Đang kết nối" : "Mất kết nối")
                    </span>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4">
                    <div class="input-group input-group-sm mb-3">
                        <span class="input-group-text bg-secondary text-white border-0" style="font-size: 11px;">Hub URL</span>
                        <input type="text" class="form-control bg-dark text-white border-secondary" style="font-size: 11px;" @bind="HubUrlInput" placeholder="http://localhost:5258/camqrhub" />
                        <button class="btn btn-primary btn-sm font-weight-bold" style="font-size: 11px;" @onclick="ConnectToHub" disabled="@_isConnecting">
                            @(_isConnecting ? "Connecting..." : "Connect")
                        </button>
                    </div>

                    @if (string.IsNullOrEmpty(CurrentRoomId))
                    {
                        <div class="my-5">
                            <span class="material-symbols-outlined display-1 text-secondary mb-3">qr_code_2</span>
                            <h5 class="text-secondary">Đang chờ Request từ Web client...</h5>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3 w-100">
                            <h5 class="text-warning">Có Request mới!</h5>
                            <p class="text-muted mb-1Small text-wrap">Room ID: <strong>@CurrentRoomId</strong></p>
                            <p class="mb-3 text-info">Data: @CurrentRequestData</p>
                        </div>
                        
                        <div class="bg-white p-3 rounded shadow-sm mb-3">
                            <div id="qr-generator-container" style="min-width: 250px; min-height: 250px;"></div>
                        </div>
                        
                        <button class="btn btn-outline-danger btn-sm" @onclick="ClearRequest">Xóa Request này</button>
                    }
                </div>
            </div>
        </div>

        <!-- Right Panel: Camera Scanner & OpenCV.js Cropper -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-secondary text-white font-weight-bold d-flex justify-content-between align-items-center">
                    <span>Quét màn hình CamQR_B</span>
                    <div>
                        <button class="btn btn-sm btn-light me-2" @onclick="StartScanner" disabled="@_isScanning">Bật Cam</button>
                        <button class="btn btn-sm btn-danger" @onclick="StopScanner" disabled="@(!_isScanning)">Tắt Cam</button>
                    </div>
                </div>
                <div class="card-body p-0 position-relative bg-black" style="min-height: 350px;">
                    <video id="scanner-video" class="w-100 h-100" style="object-fit: cover; display: @(_isScanning ? "block" : "none");"></video>
                    
                    @if (!_isScanning)
                    {
                        <div class="position-absolute top-50 start-50 translate-middle text-center text-secondary">
                            <span class="material-symbols-outlined display-3 mb-2">videocam_off</span>
                            <p>Camera chưa được kích hoạt</p>
                        </div>
                    }
                    else
                    {
                        <!-- Camera Alignment Guides Overlay (TH 2) -->
                        <div class="position-absolute top-0 start-0 w-100 h-100 pointer-events-none d-flex" style="pointer-events: none; border: 2px dashed #0d6efd;">
                            <!-- QR Scanning Area (Left 35%) -->
                            <div class="h-100 d-flex flex-column justify-content-center align-items-center text-center" 
                                 style="width: 35%; background: rgba(0, 0, 0, 0.4); border-right: 2px dashed #ffc107;">
                                <div style="width: 80%; aspect-ratio: 1; border: 3px solid #ffc107; border-radius: 8px;"></div>
                                <span class="badge bg-warning text-dark mt-2" style="font-size: 10px;">Đặt mã QR ở đây</span>
                            </div>
                            
                            <!-- Excel Capture Area (Right 65%) -->
                            <div class="h-100 d-flex flex-column justify-content-center align-items-center text-center" 
                                 style="width: 65%; background: rgba(0, 0, 0, 0.1);">
                                <div style="width: 90%; height: 75%; border: 3px dashed #0d6efd; border-radius: 4px;"></div>
                                <span class="badge bg-primary mt-2" style="font-size: 10px;">Đặt ảnh kết quả ở đây</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light">
                    <p class="mb-0 text-muted small">
                        <strong>Trạng thái quét:</strong> @StatusMessage
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Microsoft.AspNetCore.SignalR.Client.HubConnection? _hubConnection;
    private bool HubConnected => _hubConnection?.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected;
    private string HubUrlInput { get; set; } = string.Empty;
    private bool _isConnecting = false;
    private string CurrentRoomId { get; set; } = string.Empty;
    private string CurrentRequestData { get; set; } = string.Empty;
    private bool _isScanning = false;
    private string StatusMessage { get; set; } = "Đang chờ bật camera...";
    private DotNetObjectReference<CamQR_A>? _objRef;
    private HashSet<string> ProcessedRoomIds = new();

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        string currentBase = NavManager.BaseUri;
        if (currentBase.Contains("localhost:5143") || currentBase.Contains("localhost:7077"))
        {
            HubUrlInput = "http://localhost:5258/camqrhub";
        }
        else
        {
            HubUrlInput = NavManager.ToAbsoluteUri("/camqrhub").ToString();
        }

        await ConnectToHub();
    }

    private async Task ConnectToHub()
    {
        if (_isConnecting) return;
        _isConnecting = true;
        StatusMessage = "Đang kết nối tới SignalR Hub...";
        StateHasChanged();

        try
        {
            if (_hubConnection != null)
            {
                await _hubConnection.DisposeAsync();
            }

            _hubConnection = new Microsoft.AspNetCore.SignalR.Client.HubConnectionBuilder()
                .WithUrl(HubUrlInput)
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<string, string>("ReceiveRequest", async (roomId, requestData) =>
            {
                CurrentRoomId = roomId;
                CurrentRequestData = requestData;
                StateHasChanged();

                // Wait a tiny bit for the container to render, then generate QR
                await Task.Delay(100);
                await JSRuntime.InvokeAsync<bool>("camQrObj.generateQR", "#qr-generator-container", $"ROOM:{roomId}|DATA:{requestData}");
            });

            await _hubConnection.StartAsync();
            StatusMessage = "Đã kết nối thành công tới Hub!";
        }
        catch (Exception ex)
        {
            StatusMessage = $"Lỗi kết nối Hub: {ex.Message}";
        }
        finally
        {
            _isConnecting = false;
            StateHasChanged();
        }
    }

    private void ClearRequest()
    {
        CurrentRoomId = string.Empty;
        CurrentRequestData = string.Empty;
        StateHasChanged();
    }

    private async Task StartScanner()
    {
        _isScanning = true;
        StatusMessage = "Đang khởi động camera...";
        StateHasChanged();

        bool started = await JSRuntime.InvokeAsync<bool>("camQrObj.startScanner", "#scanner-video", _objRef, nameof(OnQRCodeScanned));
        if (started)
        {
            StatusMessage = "Camera đang chạy. Hãy quét mã QR từ CamQR_B.";
        }
        else
        {
            _isScanning = false;
            StatusMessage = "Không thể khởi động camera. Vui lòng cấp quyền!";
        }
        StateHasChanged();
    }

    private async Task StopScanner()
    {
        await JSRuntime.InvokeVoidAsync("camQrObj.stopScanner", "#scanner-video");
        _isScanning = false;
        StatusMessage = "Đã tắt camera.";
        StateHasChanged();
    }

    // JS Callback when a QR code is detected by ZXing
    [JSInvokable]
    public async Task OnQRCodeScanned(string scannedText)
    {
        if (string.IsNullOrEmpty(scannedText)) return;

        // Extract room ID to check duplicates
        string roomId = "";
        if (scannedText.StartsWith("ROOM:") && scannedText.Contains("|BASE64:"))
        {
            var parts = scannedText.Split('|');
            roomId = parts[0].Replace("ROOM:", "").Trim();
        }
        else if (scannedText.StartsWith("ROOM:"))
        {
            roomId = scannedText.Replace("ROOM:", "").Trim();
        }

        if (!string.IsNullOrEmpty(roomId))
        {
            if (ProcessedRoomIds.Contains(roomId))
            {
                // Already processed this room, ignore it silently to avoid duplicate logs
                return;
            }
        }

        StatusMessage = "Phát hiện mã QR...";
        StateHasChanged();

        // Process Case 1: Room ID + Base64 image packed inside a single QR
        if (scannedText.StartsWith("ROOM:") && scannedText.Contains("|BASE64:"))
        {
            try
            {
                var parts = scannedText.Split('|');
                var rId = parts[0].Replace("ROOM:", "").Trim();
                var base64 = parts[1].Replace("BASE64:", "").Trim();

                StatusMessage = $"Quét thành công TH 1 cho Room {rId}! Đang gửi kết quả...";
                StateHasChanged();

                if (_hubConnection != null)
                {
                    await _hubConnection.SendAsync("SendResult", rId, base64);
                    ProcessedRoomIds.Add(rId);
                    StatusMessage = $"Đã gửi kết quả TH 1 thành công cho Room {rId}!";
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                StatusMessage = $"Lỗi xử lý kết quả TH 1: {ex.Message}";
            }
        }
        // Process Case 2: QR contains Room ID, and adjacent image is cropped via OpenCV/Canvas
        else if (scannedText.StartsWith("ROOM:"))
        {
            try
            {
                var rId = scannedText.Replace("ROOM:", "").Trim();
                StatusMessage = $"Nhận diện Room {rId}! Đang chụp và xử lý ảnh kết quả...";
                StateHasChanged();

                // Trigger JS to capture the frame, crop the Excel area, and return Base64 image
                var base64Image = await JSRuntime.InvokeAsync<string>("camQrObj.captureAndProcessExcel", "#scanner-video");

                if (!string.IsNullOrEmpty(base64Image))
                {
                    StatusMessage = $"Đã crop thành công ảnh kết quả cho Room {rId}! Đang gửi...";
                    StateHasChanged();

                    if (_hubConnection != null)
                    {
                        await _hubConnection.SendAsync("SendResult", rId, base64Image);
                        ProcessedRoomIds.Add(rId);
                        StatusMessage = $"Đã gửi kết quả TH 2 thành công cho Room {rId}!";
                        StateHasChanged();
                    }
                }
                else
                {
                    StatusMessage = "Lỗi: Không thể chụp/crop ảnh kết quả!";
                }
            }
            catch (Exception ex)
            {
                StatusMessage = $"Lỗi xử lý kết quả TH 2: {ex.Message}";
            }
        }
        else
        {
            StatusMessage = $"Quét được mã QR lạ: {scannedText}";
        }
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isScanning)
        {
            await JSRuntime.InvokeVoidAsync("camQrObj.stopScanner", "#scanner-video");
        }
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
        _objRef?.Dispose();
    }
}
